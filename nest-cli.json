{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "assets": [
            "core/mail/templates/**/*",
            "core/mail/extras/**/*"
        ],
        "watchAssets": true,
        "deleteOutDir": true
    }
}