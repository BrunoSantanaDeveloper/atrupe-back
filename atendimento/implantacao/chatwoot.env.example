# Chatwoot, Postgres e Redis do atendimento. No servidor: /home/ubuntu/atendimento/chatwoot.env (fora do
# git). Os segredos gerados nesta máquina estão em atendimento/segredos/chatwoot.env.

FRONTEND_URL=https://atendimento.atrupe.com.br
# O Traefik já termina o https na borda. Com FORCE_SSL=true o Rails redirecionaria para https as chamadas
# internas da API e do robô (http://atendimento-chatwoot:3000), e elas falhariam.
FORCE_SSL=false
SECRET_KEY_BASE=64_caracteres_aleatorios
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false

# Nomes com o prefixo "atendimento-": na atrupe_network existem o Postgres e o Redis da API.
POSTGRES_HOST=atendimento-postgres
POSTGRES_USERNAME=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha_longa

REDIS_URL=redis://atendimento-redis:6379
REDIS_PASSWORD=senha_longa

# Anexos das conversas no volume chatwoot_storage. Para o S3 que o Atrupe já usa, troque por amazon e
# preencha S3_BUCKET_NAME, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY e AWS_REGION.
ACTIVE_STORAGE_SERVICE=local

# Avisos por e-mail aos atendentes (opcional). Sem SMTP, ficam no painel e no navegador.
MAILER_SENDER_EMAIL=Atendimento Atrupe <atendimento@atrupe.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Fica desligado em produção: o robô recebe os avisos pelo endereço público e assinado.
# SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
