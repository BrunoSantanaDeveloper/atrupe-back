# Robô do atendimento. No servidor: /home/ubuntu/atendimento/robo.env (fora do git). Os segredos gerados
# nesta máquina estão em atendimento/segredos/robo.env.

PORT=8080
# O Chatwoot pela rede interna do stack.
CHATWOOT_URL=http://atendimento-chatwoot:3000
# As rotas do robô na API. Homologação primeiro: https://dev.atrupe.com.br/atendimento/robo
PROJECT_URL=https://api.atrupe.com.br/atendimento/robo
# O mesmo valor de SUPPORT_BOT_SECRET da API.
SUPPORT_BOT_SECRET=64_caracteres_aleatorios

# A chave do provedor de IA. O padrão do Atrupe é a Anthropic; para outro provedor, veja api.env.example.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Espera para juntar mensagens seguidas do cliente, em milissegundos.
DEBOUNCE_MS=2500
