# Robô do atendimento. No servidor: /home/ubuntu/atendimento/segredos/robo.env (fora do git). Os segredos
# gerados nesta máquina estão em atendimento/segredos/robo.env.

PORT=8080
# O Chatwoot pela rede interna do compose.
CHATWOOT_URL=http://atendimento-chatwoot:3000
# As rotas do robô na API de produção (no homolog: https://dev.atrupe.com.br/atendimento/robo)
PROJECT_URL=https://api.atrupe.com.br/atendimento/robo
# O mesmo valor de SUPPORT_BOT_SECRET da API.
SUPPORT_BOT_SECRET=64_caracteres_aleatorios

# A chave do provedor de IA. O padrão do Atrupe é a Anthropic; para outro provedor, veja api.env.example.
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Imagem, áudio e vídeo (o ffmpeg vem no Dockerfile do robô). Foto e print vão para a IA da conversa, sem
# outra chave. A transcrição de áudio e da fala do vídeo usa a chave do Gemini, que custa menos, ou a da
# OpenAI; sem nenhuma das duas, o áudio vai para a equipe e o vídeo vira só a grade de quadros.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# MEDIA_GEMINI_MODEL=gemini-3.1-flash-lite
# MEDIA_OPENAI_MODEL=gpt-4o-mini-transcribe
# Tamanho máximo de um anexo, em MB, e minutos de fala transcritos por áudio ou vídeo.
# MEDIA_MAX_MB=100
# MEDIA_MAX_MINUTES=30
# Mídias processadas ao mesmo tempo no contêiner.
# MEDIA_CONCURRENCY=2

# Espera para juntar mensagens seguidas do cliente, em milissegundos.
DEBOUNCE_MS=2500
# Por quanto tempo o perfil de quem escreve (rota contact da API) vale numa conversa, em milissegundos.
# PROFILE_TTL_MS=300000
