# OpenWA (conexão não oficial pelo WhatsApp Web). No servidor: /home/ubuntu/atendimento/openwa.env (fora
# do git). Os segredos gerados nesta máquina estão em atendimento/segredos/openwa.env.

PORT=2785
NODE_ENV=production
# Endereço público https: o adaptador monta com ele o endereço que recebe os avisos do Chatwoot.
BASE_URL=https://wa.atrupe.com.br
# A chave de administrador que a API usa (OPENWA_API_KEY no .env da API, o mesmo valor).
API_MASTER_KEY=64_caracteres_aleatorios

DATABASE_TYPE=sqlite
DATABASE_NAME=/app/data/openwa.sqlite
SESSION_DATA_PATH=/app/data/sessions
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/data/media
AUTO_START_SESSIONS=true

# whatsapp-web.js: um Chromium por sessão (300 a 500 MB), menor risco de banimento segundo o OpenWA.
ENGINE_TYPE=whatsapp-web.js
