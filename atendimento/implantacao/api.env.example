# Variáveis do atendimento para acrescentar ao .env da API (/home/ubuntu/atrupe-back/.env.prod, ou .env.dev
# no homolog). Sem elas a API sobe normal e as telas do atendimento dizem que ele não está configurado.
# Os segredos gerados nesta máquina estão em atendimento/segredos/api.env.

# O Chatwoot fica na instância própria do atendimento: a API chama pelo endereço público.
CHATWOOT_URL=https://atendimento.atrupe.com.br
CHATWOOT_PUBLIC_URL=https://atendimento.atrupe.com.br
# Token do Platform App, criado no console de super administrador do Chatwoot (/super_admin).
CHATWOOT_PLATFORM_TOKEN=
# Onde o Chatwoot avisa o robô.
SUPPORT_BOT_PUBLIC_URL=https://atendimento.atrupe.com.br/robo/chatwoot
# O mesmo valor de SUPPORT_BOT_SECRET do robô.
SUPPORT_BOT_SECRET=64_caracteres_aleatorios
# Domínio dos e-mails das contas de serviço (ninguém usa: só identificam a conta no Chatwoot).
SUPPORT_SERVICE_EMAIL_DOMAIN=atrupe.com.br

# Provedor de IA do robô (opcional). Sem nada, Anthropic com claude-opus-5-5 e esforço baixo, e a chave
# ANTHROPIC_API_KEY no robo.env. Para usar o OpenRouter, que a IA do sistema já usa:
# SUPPORT_AI_PROVIDER=openai
# SUPPORT_AI_BASE_URL=https://openrouter.ai/api/v1
# SUPPORT_AI_KEY_ENV=OPENROUTER_API_KEY
# SUPPORT_AI_MODEL=<modelo do OpenRouter>
# (e OPENROUTER_API_KEY no robo.env)

# Conexão não oficial (OpenWA), também na instância do atendimento: a API chama pelo endereço público
# (só /api fica exposto). A chave de administrador é o mesmo valor de API_MASTER_KEY do openwa.env.
OPENWA_URL=https://wa.atrupe.com.br
OPENWA_PUBLIC_URL=https://wa.atrupe.com.br
OPENWA_API_KEY=64_caracteres_aleatorios
