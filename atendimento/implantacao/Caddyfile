# Proxy da instância do atendimento, com TLS automático (Let's Encrypt). Adaptado de
# atendimento/modelos/implantacao/Caddyfile.

atendimento.atrupe.com.br {
	encode gzip

	# A página que cria o super administrador do Chatwoot fica fechada para todos: robôs de varredura
	# visitam um domínio novo minutos depois do certificado. Ela só abre para o IP de quem vai criar a
	# conta, com ATENDIMENTO_ONBOARDING_IP no compose (implantacao/LEIA-ME.md, "Primeira implantação").
	# Fica num handle porque os blocos handle são exclusivos entre si e o Caddy roda um respond solto
	# só depois deles.
	@onboarding {
		path /installation /installation/*
		not remote_ip {$ATENDIMENTO_ONBOARDING_IP:127.0.0.1/32}
	}
	handle @onboarding {
		respond 404
	}

	# O robô recebe os avisos do Chatwoot em https://atendimento.atrupe.com.br/robo/chatwoot.
	handle_path /robo/* {
		reverse_proxy robo:8080
	}

	handle {
		reverse_proxy chatwoot-rails:3000
	}
}

wa.atrupe.com.br {
	# Só a API (protegida pela chave) e os avisos assinados do Chatwoot. O painel do OpenWA não fica exposto.
	@api path /api/*
	handle @api {
		reverse_proxy openwa:2785
	}
	handle {
		respond 404
	}
}
