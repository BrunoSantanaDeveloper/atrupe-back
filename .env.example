APP_ENV=production

DB_USER=Admin
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dbName

PORT=5000
SECRET=your_secret_min_32_chars
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars

DATABASE_URL="postgresql://Admin:123456@127.0.0.1:5432/dbName?schema=public"

# Big Data
BIG_DATA_CORP_TOKEN=your_big_data_token_here

MINIO_ENDPOINT=files.atrupe.com.br
MINIO_PORT=443
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_USE_SSL=true
MINIO_BUCKET_NAME=atrupe-dev

S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET=files-atrupe

# Template config
MAIL_PATH_TEMPLATES_PROD=/usr/src/app/dist/core/mail/templates

# SMTP Configuration PROD
MAIL_HOST=atrupe.com.br
MAIL_PORT=465
MAIL_SECURE=true
MAIL_IGNORE_TLS=false

# Credentials
MAIL_USER=cadastros@atrupe.com.br
MAIL_PASSWORD=7g7g7g

# Default From
MAIL_FROM=cadastros@atrupe.com.br

# Default BCC
MAIL_BCC=email1@exemplo.com,email2@exemplo.com

# Front Url
FRONTEND_URL=http://localhost:3000

# CORS (comma-separated origins, leave empty for * in dev)
CORS_ORIGINS=http://localhost:3000

# Asaas
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_TOKEN=your_asaas_token_here
WEBHOOK_ACCESS_TOKEN=your_webhook_secret_here
# Ciclo anual (11 meses, em até 12x no cartão). Ligado por padrão; "false"
# desliga a oferta sem deploy, se o parcelamento do Asaas falhar.
ANNUAL_CYCLE_ENABLED=true

# Invoicy - Credenciais Globais (Atrupe como Revendedor)
INVOICY_PARTNER_KEY=sua_partner_key_aqui
INVOICY_ACCESS_KEY=sua_chave_acesso_aqui
INVOICY_ENVIRONMENT=HOMOLOGACAO

# ─── Criptografia de banco de dados (AES-256-GCM) ────────────────────────────
# Keyring JSON: {"<key-id>": "<64-hex-chars>"} — nunca commitar chaves reais
# Para gerar uma chave: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_ENCRYPTION_KEYRING={"key-2026-06":"<substitua-por-64-hex-chars-gerados-localmente>"}
DATABASE_ENCRYPTION_ACTIVE_KEY_ID=key-2026-06

# ─── Fase de rollout da migração de segredos fiscais ─────────────────────────
# Fase 4 (bootstrap, pré-migração): false + DUAL
# Fase 6 (pós-backfill):            true  + DUAL
# Fase 7 (somente cifrado):         true  + ENCRYPTED_ONLY
USE_ENCRYPTED_FISCAL_DB=false
FISCAL_DB_WRITE_MODE=DUAL

# ─── Gate de ativação de NFC-e em produção ───────────────────────────────────
# Só virar true após migração COMPLETED e validação em homologação
NFCE_PRODUCTION_ACTIVATION_ENABLED=false

# AI Chat
AI_PROVIDER=openrouter
AI_API_KEY=your_openrouter_api_key_here
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-oss-120b
AI_FALLBACK_MODELS=google/gemini-3.1-flash-lite,qwen/qwen3.7-max
AI_MODEL_AUTO_SELECTION_ENABLED=true
AI_MODEL_ALLOWLIST=openai/gpt-oss-120b,google/gemini-3.1-flash-lite,qwen/qwen3.7-max
AI_MODEL_BLACKLIST=
AI_MODEL_MIN_CONTEXT=128000
AI_MODEL_SWITCH_MIN_GAIN=0.15
AI_MODEL_SWITCH_COOLDOWN_DAYS=7
AI_MODEL_MAX_RETRIES=2
AI_MAX_TOOL_CALLS=5
AI_MAX_HISTORY_MESSAGES=20

# ─── Contas criadas pelo seed (prisma/seed.ts, roda a cada boot) ─────────────
# Sem a variável, o seed não cria a conta; a que já existe não muda (a senha
# não é regravada). Defina só onde a conta deve existir; nunca commite o valor.
# Superadmin sistema@atrupe.com.br:
# SEED_SYSTEM_ADMIN_PASSWORD=
# Usuário comum de testes bruno@atrupe.com.br, com a empresa "Bruno Digital
# S.A." e a assinatura sub_local_test_bruno (nada disso é criado sem ela):
# SEED_TEST_USER_PASSWORD=

# ─── Contas de teste por plano (npm run contas-teste; docs/test-accounts.md) ─
# Só em homolog. O script exige as três guardas: esta variável, APP_ENV
# diferente de production e Asaas em sandbox com banco que não seja o de
# produção. Senha e domínio são obrigatórios; nunca commite a senha.
# TEST_ACCOUNTS_ENABLED=true
# TEST_ACCOUNTS_EMAIL_DOMAIN=
# TEST_ACCOUNTS_PASSWORD=
