  name        String
  code        String  @unique
  description String?

  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("languages")
}

model Reasons {
  id        String      @id @default(uuid())
  reason    String
  type      ReasonType
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  order     Order[]
  quotation Quotation[]

  @@map("reasons")
}

enum ReasonType {
  REJECTION
  CANCELLATION
}

enum DeliveryScheduleStatus {
  IN_PRODUCTION
  DELIVERING
  FINISHED
  DONE
}

model DeliverySchedule {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  deliveryInfoId String?       @unique
  deliveryInfo   DeliveryInfo? @relation(fields: [deliveryInfoId], references: [id])

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  status             DeliveryScheduleStatus
  completed          Boolean                @default(false)
  notes              String?
  scheduledDate      DateTime
  addScheduleTime    Boolean                @default(false)
  pendingDescription String?

  productionStages ProductionStage[]

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("delivery_schedules")
}

enum ProductionStageStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  PENDING
  DONE
  CANCELED
  WAITING_PRODUCTION
  OVERDUE
}

model ProductionStage {
  id         String                @id @default(uuid())
  stageId    String?
  stage      CompanySector?        @relation(fields: [stageId], references: [id])
  status     ProductionStageStatus @default(NOT_STARTED)
  notes      String?
  order      Int?
  prevStatus String?
  scheduleId String

  schedule DeliverySchedule @relation(fields: [scheduleId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("production_stages")
}

model Nature {
  id          String  @id @default(uuid())
  description String?
  level1      String?
  level2      String?
