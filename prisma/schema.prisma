  name        String
  code        String             @unique
  kind        UnitOfMeasureKind?
  description String?

  isActive             Boolean                @default(true)
  CompanyUnitOfMeasure CompanyUnitOfMeasure[]

  @@map("defalt_unit_measures")
}

model Language {
