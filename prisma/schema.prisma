model Coupon {
  id                String         @id @default(uuid())
  code              String         @unique
  description       String?
  discountType      DiscountType
  discountValue     Float // Para PERCENT: ex 20 (= 20%). Para VALUE: em centavos, ex 5000 (= R$50)
  durationType      CouponDuration @default(ONCE)
  durationMonths    Int? // Usado apenas quando durationType = MONTHS
  maxUses           Int? // Null = ilimitado
  currentUses       Int            @default(0)
  maxUsesPerCompany Int            @default(1) // Admin define dinamicamente
  minPlanValue      Float? // Valor mínimo do plano para aplicar (centavos)
  validFrom         DateTime       @default(now())
  validUntil        DateTime? // Null = sem expiração
  isActive          Boolean        @default(true)
  appliesToPlans    String[]       @default([]) // IDs dos planos. Vazio = todos
  appliesToModules  Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime?      @updatedAt
  createdBy         String?
  usages            CouponUsage[]
  subscriptions     Subscription[]

  @@index([code])
  @@index([isActive, validUntil])
  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  companyId       String
  subscriptionId  String?
  discountApplied Float // Valor real do desconto aplicado (centavos)
  originalValue   Float // Valor original antes do desconto (centavos)
  finalValue      Float // Valor final após desconto (centavos)
  createdAt       DateTime @default(now())
  coupon          Coupon   @relation(fields: [couponId], references: [id])

  @@index([couponId])
  @@index([companyId])
  @@map("coupon_usages")
}

enum DiscountType {
  PERCENT
  VALUE
}

enum CouponDuration {
  ONCE // Desconto apenas na primeira cobrança
  RECURRING // Desconto permanente em todas as cobranças
  MONTHS // Desconto por N meses
}

enum FiscalEnvironment {
  HOMOLOGACAO
  PRODUCAO
}

enum FiscalDocType {
  NFE
  NFSE
  NFCE
}

enum FiscalEnvironmentStatus {
  DRAFT
  VALIDATING
  READY
  ERROR
  DISABLED
  MIGRATED_UNVERIFIED
}

enum FiscalConfigAction {
  ENVIRONMENT_CONFIG_CREATE
  CREDENTIALS_ROTATE
  ENVIRONMENT_ACTIVATED
  VALIDATION_RUN
  READ_CREDENTIALS
  CERTIFICATE_UPLOADED
}

enum ActorType {
  USER
  SYSTEM
  ADMIN
}

enum FiscalConfigHistoryResult {
  SUCCESS
  FAILED
}

enum FiscalSecretMigrationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FiscalActivationStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model CompanyEnvironmentCredential {
  id                         String            @id @default(uuid())
  companyId                  String
  company                    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  environment                FiscalEnvironment
  providerAccessKeyEncrypted String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, environment])
  @@map("company_environment_credentials")
}

model InvoicyEnvironmentConfig {
  id              String        @id @default(uuid())
  invoicyConfigId String
  invoicyConfig   InvoicyConfig @relation(fields: [invoicyConfigId], references: [id], onDelete: Cascade)

  environment FiscalEnvironment
  // @default(NFCE) alinha o schema ao banco: a migration
  // 20260701130000 criou a coluna com DEFAULT 'NFCE'. Sem isso o Prisma e o
  // banco divergiam e linhas criadas sem docType explicito viravam NFCE em
  // silencio.
  docType     FiscalDocType     @default(NFCE)

  cscId             String?
  cscTokenEncrypted String?

  // Numeracao por (emissor, ambiente, docType). Cada linha usa apenas o par
  // correspondente ao seu docType. Sao colunas separadas em vez de um par
  // generico porque a serie da NFS-e e alfanumerica e a de NF-e/NFC-e e
  // inteira — um unico par nao tipa as duas.
  nfceSeries     Int? @default(1)
  nfceNextNumber Int? @default(1)

  nfeSeries     Int? @default(1)
  nfeNextNumber Int? @default(1)

  // "1" e nao "A1": ver prisma/migrations/20260921120000_nfse_series_default_numeric
  nfseSeries     String? @default("1")
  nfseNextNumber Int?    @default(1)

  status              FiscalEnvironmentStatus @default(DRAFT)
  lastValidationAt    DateTime?
  lastValidationError String?                 @db.Text
  activatedAt         DateTime?
  activatedBy         String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([invoicyConfigId, environment, docType])
  @@map("invoicy_environment_configs")
}

model InvoicyConfigHistory {
  id              String         @id @default(uuid())
  invoicyConfigId String?
  invoicyConfig   InvoicyConfig? @relation(fields: [invoicyConfigId], references: [id], onDelete: SetNull)
  companyId       String
  emissorName     String

  action        FiscalConfigAction
  actorType     ActorType
  createdByName String
  environment   FiscalEnvironment?
  result        FiscalConfigHistoryResult
  correlationId String
  description   String
  changes       Json?
  metadata      Json?

  createdBy String?
  user      User?    @relation("FiscalHistoryUser", fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([invoicyConfigId])
  @@index([companyId])
  @@index([createdAt])
  @@map("invoicy_config_history")
}

model FiscalActivationAttempt {
  id              String                 @id @default(uuid())
  invoicyConfigId String
  invoicyConfig   InvoicyConfig          @relation(fields: [invoicyConfigId], references: [id], onDelete: Cascade)
  environment     FiscalEnvironment
  docType         FiscalDocType          @default(NFCE)
  idempotencyKey  String?
  status          FiscalActivationStatus @default(RUNNING)
  attemptId       String                 @unique
  leaseExpiresAt  DateTime
  resultSnapshot  Json?
  errorCode       String?
  createdBy       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([invoicyConfigId, environment, docType, idempotencyKey])
  @@index([invoicyConfigId, docType, status])
  @@index([status, leaseExpiresAt])
  @@map("fiscal_activation_attempts")
}

model FiscalSecretMigrationState {
  id             String                      @id @default(uuid())
  version        Int                         @unique @default(1) // @unique garante apenas um estado por versão de migração
  status         FiscalSecretMigrationStatus @default(PENDING)
  totalRecords   Int                         @default(0)
  processedOk    Int                         @default(0)
  processedError Int                         @default(0)
  cursors        Json?                       @default("{}") // Cursores de retomada compostos por tabela: { "Company": { "createdAt": "...", "id": "..." }, ... }
  snapshotTime   DateTime? // High-water mark persistido e reutilizado em todas as retomadas da versão
  errorSanitized String?                     @db.Text
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@map("fiscal_secret_migration_state")
}

model FiscalSecretRekeyJob {
  id          String                      @id @default(uuid())
  oldKeyId    String
  newKeyId    String
  status      FiscalSecretMigrationStatus @default(PENDING)
  cursors     Json                        @default("{}") // Cursores de retomada por tabela e campo: { "CompanyEnvironmentCredential.providerAccessKeyEncrypted": { "createdAt": "...", "id": "..." } }
  errorCode   String? // Código seguro/estruturado; nunca recebe error.message bruto
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([oldKeyId, newKeyId])
  @@map("fiscal_secret_rekey_jobs")
}

/// Fluxo de produção (área 9 §4.6): agrupa os gerenciadores. Hoje um só
/// por empresa, "Comunicação Visual", criado na primeira leitura.
model ProductionFlow {
  id        String              @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime            @default(now())
  company   Company             @relation(fields: [companyId], references: [id])
  managers  ProductionManager[]

  @@unique([companyId, name])
  @@map("production_flows")
}

/// Gerenciador de produção (GP-15, GP-43): um setor de trabalho, com o
/// jeito de apontar o tempo e o intervalo entre tarefas na mesma máquina.
model ProductionManager {
  id               String                  @id @default(uuid())
  companyId        String
  name             String
  sectorId         String
  flowId           String
  timeMode         ProductionTimeMode      @default(PLAY_STOP)
  /// Minutos perdidos entre uma tarefa e a seguinte na mesma máquina (GP-20)
  intervalMinutes  Int                     @default(0)
  /// O expediente do gerenciador (GP-48 item 19), "HH:MM"; nulo = o da
  /// empresa (ProductionCalendar). O intervalo (almoço) é opcional.
  workStart        String?
  workEnd          String?
  breakStart       String?
  breakEnd         String?
  /// A máquina segue no intervalo (impressora) ou para (equipe)
  runsThroughBreak Boolean                 @default(false)
  /// Agenda viva (item 20): reagenda e avisa, ou só avisa
  liveSchedule     ProductionLiveSchedule  @default(WARN)
  /// Tempo após a conclusão antes da etapa seguinte, ex.: secagem (item 21)
  afterDoneMinutes Int                     @default(0)
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  company          Company                 @relation(fields: [companyId], references: [id])
  sector           CompanySector           @relation(fields: [sectorId], references: [id])
  flow             ProductionFlow          @relation(fields: [flowId], references: [id])
  users            ProductionManagerUser[]
  steps            ProductionTaskStep[]

  @@index([companyId])
  @@map("production_managers")
}

/// Agenda viva do gerenciador (GP-48 item 20)
enum ProductionLiveSchedule {
  /// Só avisa: mostra o atraso e quem decide reagenda (§12.2, GP-24)
  WARN
  /// Reagenda em sequência e avisa o que mudou (GP-48 item 4)
  RESCHEDULE
}

/// O acesso de um colaborador ao gerenciador (GP-11): a tudo, ou só ao que
/// está atribuído a ele.
model ProductionManagerUser {
  id           String            @id @default(uuid())
  managerId    String
  employeeId   String
  onlyAssigned Boolean           @default(false)
  manager      ProductionManager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([managerId, employeeId])
  @@index([employeeId])
  @@map("production_manager_users")
}

/// O perfil do colaborador na produção (GP-11). Sem linha, é operador.
model ProductionCollaborator {
  id         String         @id @default(uuid())
  companyId  String
  employeeId String         @unique
  role       ProductionRole @default(OPERATOR)
  updatedAt  DateTime       @updatedAt
  company    Company        @relation(fields: [companyId], references: [id])
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("production_collaborators")
}

/// Tipo de tarefa (GP-13, GP-14): o nome casa com o tipo de tarefa da etapa
/// da composição (IP-23); as etapas dizem por quais gerenciadores a tarefa
/// passa. Nunca é excluído, só inativado.
model ProductionTaskType {
  id          String                @id @default(uuid())
  companyId   String
  name        String
  /// O nome em minúsculas, sem espaços nas pontas: a chave única da empresa
  nameKey     String
  release     ProductionReleaseRule @default(AFTER_BASE)
  timeControl Boolean               @default(true)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  company     Company               @relation(fields: [companyId], references: [id])
  steps       ProductionTaskStep[]
  tasks       ProductionTask[]

  @@unique([companyId, nameKey])
  @@map("production_task_types")
}

/// Etapa do tipo de tarefa, num gerenciador. A tarefa aponta para a etapa
/// em que está (não para a posição): reordenar não a muda de lugar.
model ProductionTaskStep {
  id         String             @id @default(uuid())
  taskTypeId String
  name       String
  managerId  String
  position   Int                @default(0)
  createdAt  DateTime           @default(now())
  taskType   ProductionTaskType @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  manager    ProductionManager  @relation(fields: [managerId], references: [id])
  tasks      ProductionTask[]

  @@index([taskTypeId])
  @@index([managerId])
  @@map("production_task_steps")
}

/// O expediente da produção (§4.8): os dias e o horário de trabalho e os
/// feriados da empresa, para a cadeia de alertas. Sem linha, segunda a sexta,
/// das 08:00 às 18:00 (o fim de semana não conta como expediente).
model ProductionCalendar {
  id         String   @id @default(uuid())
  companyId  String   @unique
  /// 0 = domingo … 6 = sábado
  workDays   Int[]    @default([1, 2, 3, 4, 5])
  startTime  String   @default("08:00")
  endTime    String   @default("18:00")
  /// O intervalo (almoço) da empresa, opcional; o gerenciador novo copia
  /// o expediente com ele (GP-49)
  breakStart String?
  breakEnd   String?
  /// YYYY-MM-DD
  holidays   String[]
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])

  @@map("production_calendars")
}

/// Veículo da frota (VS-7): a instalação e a entrega ocupam o veículo.
model ProductionVehicle {
  id        String           @id @default(uuid())
  companyId String
  name      String
  plate     String           @default("")
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  company   Company          @relation(fields: [companyId], references: [id])
  tasks     ProductionTask[]

  @@index([companyId])
  @@map("production_vehicles")
}

/// O projeto de produção da venda aprovada (PCP-4): um por venda. Nome do
/// cliente e do vendedor copiados na criação, como a ficha imprime.
model ProductionProject {
  id           String                     @id @default(uuid())
  companyId    String
  quotationId  String                     @unique
  number       String
  clientName   String                     @default("")
  sellerName   String                     @default("")
  approvedAt   DateTime
  deliveryType String                     @default("")
  /// O primeiro prazo prometido e o atual (GP-8)
  firstDue     DateTime                   @db.Date
  due          DateTime                   @db.Date
  status       ProductionProjectStatus    @default(STANDBY)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  company      Company                    @relation(fields: [companyId], references: [id])
  quotation    Quotation                  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  tasks        ProductionTask[]
  history      ProductionProjectHistory[]

  @@index([companyId, status])
  @@map("production_projects")
}

model ProductionProjectHistory {
  id        String            @id @default(uuid())
  projectId String
  at        DateTime          @default(now())
  byUserId  String?
  byName    String
  text      String
  /// O que mudou, quando há (a data de entrega: de e para)
  data      Json?
  project   ProductionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("production_project_history")
}

/// A tarefa: uma etapa da composição do item vendido (GP-16, FL-10), com o
/// consumo resolvido na medida da venda, sem custo nem preço (ORC-7).
model ProductionTask {
  id                 String                     @id @default(uuid())
  companyId          String
  projectId          String
  /// Código curto, único no projeto, para achar a tarefa no chão de fábrica
  code               String
  quotationProductId String?
  /// A etapa de origem no item (o bloco do retrato, ou line:<id> da linha
  /// acrescentada): a O.S. alterada acompanha a tarefa por ela
  stageKey           String                     @default("")
  itemName           String
  itemImage          String?
  stageName          String
  /// O setor da etapa na composição (a produtividade agrupa por ele)
  sectorId           String?
  sectorName         String                     @default("")
  taskTypeId         String
  /// A etapa do tipo em que a tarefa está; nula se a etapa saiu do tipo
  currentStepId      String?
  status             ProductionTaskStatus       @default(NOT_STARTED)
  /// Tempo vendido (preparo + mão de obra das linhas) e o preparo, em minutos
  estimatedMinutes   Int                        @default(0)
  setupMinutes       Int                        @default(0)
  machine            String?
  /// A qualidade vendida (GP-48 item 22): a configuração da máquina
  machineSetupId     String?
  machineQuality     String?
  /// A tarefa da base desta etapa, e as tarefas de que ela depende de fato
  baseTaskId         String?
  dependsOn          String[]
  quantity           Int                        @default(1)
  measureText        String                     @default("")
  /// Os campos da venda com nome ("Nº de letras: 6")
  fields             String[]
  /// [{ kind, resource, quantity, unit }]
  consumption        Json                       @default("[]")
  note               String?
  /// Agenda: dia, início HH:mm e minutos (GP-35)
  scheduleDate       DateTime?                  @db.Date
  scheduleStart      String?
  scheduleMinutes    Int?
  assigneeId         String?
  pendencyText       String?
  pendencyAt         DateTime?
  pendencyBy         String?
  /// Liberou a próxima etapa antes de concluir: { at, by, quantity, of }
  releasedNext       Json?
  completedBy        String?
  completedAt        DateTime?
  vehicleId          String?
  km                 Float?
  /// Urgente sobe na fila do setor (GP-47, item 4; 29/10/2026)
  priority           ProductionTaskPriority     @default(NORMAL)
  position           Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  project            ProductionProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskType           ProductionTaskType         @relation(fields: [taskTypeId], references: [id])
  currentStep        ProductionTaskStep?        @relation(fields: [currentStepId], references: [id], onDelete: SetNull)
  assignee           Employee?                  @relation("ProductionTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  vehicle            ProductionVehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  timeEntries        ProductionTimeEntry[]
  corrections        ProductionTimeCorrection[]
  attachments        ProductionAttachment[]
  history            ProductionTaskHistory[]

  @@unique([projectId, code])
  @@index([companyId, status])
  @@index([currentStepId])
  @@map("production_tasks")
}

/// Um trecho de tempo de uma pessoa numa tarefa (GP-32, GP-43). Aberto
/// enquanto a pessoa trabalha: no máximo um aberto por pessoa (índice
/// parcial na migration). O tempo fica em segundos inteiros.
model ProductionTimeEntry {
  id         String               @id @default(uuid())
  companyId  String
  taskId     String
  employeeId String
  start      DateTime
  end        DateTime?
  seconds    Int                  @default(0)
  source     ProductionTimeSource @default(CLOCK)
  note       String?
  createdAt  DateTime             @default(now())
  task       ProductionTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee             @relation(fields: [employeeId], references: [id])

  @@index([taskId])
  @@index([employeeId, end])
  @@index([companyId, end])
  @@map("production_time_entries")
}

/// A correção ou o lançamento de um trecho pelo gerente, com o antes e o
/// depois (GP-44). No lançamento, before é nulo.
model ProductionTimeCorrection {
  id       String         @id @default(uuid())
  taskId   String
  entryId  String
  at       DateTime       @default(now())
  byUserId String?
  byName   String
  /// { collaboratorId, minutes }
  before   Json?
  after    Json
  note     String
  task     ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("production_time_corrections")
}

model ProductionTaskHistory {
  id       String                @id @default(uuid())
  taskId   String
  at       DateTime              @default(now())
  byUserId String?
  byName   String
  text     String
  /// Quem foi afetado (a correção de tempo aparece para eles, GP-44)
  affects  String[]
  /// O comentário da equipe vive no histórico (VS-5, GP-47 item 3): texto
  /// livre de quem tem acesso ao gerenciador, sem notificação
  kind     ProductionHistoryKind @default(EVENT)
  task     ProductionTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("production_task_history")
}

/// O anexo da etapa, com versões; uma delas é a válida (GP-25, GP-26).
model ProductionAttachment {
  id        String                        @id @default(uuid())
  taskId    String
  name      String
  kind      ProductionAttachmentKind      @default(OTHER)
  createdAt DateTime                      @default(now())
  task      ProductionTask                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  versions  ProductionAttachmentVersion[]

  @@index([taskId])
  @@map("production_attachments")
}

/// O arquivo fica no armazenamento de objetos, privado; a tela recebe um
/// link assinado de 15 minutos a cada leitura (GP-27).
model ProductionAttachmentVersion {
  id           String               @id @default(uuid())
  attachmentId String
  version      Int
  fileName     String
  size         Int
  mime         String
  storageKey   String
  uploadedById String?
  uploadedBy   String
  uploadedAt   DateTime             @default(now())
  current      Boolean              @default(false)
  /// Apagado na limpeza do espaço (GP-49): o registro fica, o arquivo não,
  /// e não conta no espaço usado
  removedAt    DateTime?
  attachment   ProductionAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, version])
  @@map("production_attachment_versions")
}

/// O arquivo da O.S. (GP-49, 22/11/2026): guardado na O.S. geral, fora dos
/// gerenciadores. Vê quem vê a O.S.; conta no espaço dos arquivos e entra na
/// limpeza quando a O.S. está entregue (finalizada).
model OrderFile {
  id           String    @id @default(uuid())
  companyId    String
  orderId      String
  fileName     String
  size         Int
  mime         String
  storageKey   String
  uploadedById String?
  uploadedBy   String
  uploadedAt   DateTime  @default(now())
  /// Apagado na limpeza do espaço: o registro fica, o arquivo não
  removedAt    DateTime?
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([companyId])
  @@map("order_files")
}

/// A limpeza do espaço dos arquivos (GP-49): quem apagou, quando e quanto.
model ProductionStorageCleanup {
  id        String   @id @default(uuid())
  companyId String
  at        DateTime @default(now())
  byUserId  String?
  byName    String
  automatic Boolean  @default(false)
  percent   Int
  files     Int
  /// Bytes liberados (Float: a soma passa do Int)
  bytes     Float

  @@index([companyId, at])
  @@map("production_storage_cleanups")
}

/// A limpeza automática (GP-49): vem desligada. Ligada, quando o espaço
/// usado passa do limite (%), apaga os mais antigos até liberar a
/// porcentagem.
model ProductionStorageAuto {
  id        String   @id @default(uuid())
  companyId String   @unique
  enabled   Boolean  @default(false)
  percent   Int      @default(50)
  threshold Int      @default(90)
  updatedAt DateTime @updatedAt

  @@map("production_storage_auto")
}

enum ProductionTaskPriority {
  NORMAL
  URGENT
}

enum ProductionHistoryKind {
  EVENT
  COMMENT
}

enum ProductionTimeMode {
  PLAY_STOP
  DRAG_DROP
  // Sem controle de tempo (GP-47, 29/10/2026): a tarefa só se conclui. É o
  // modo da tela por setor do PRO; o tempo é do ELITE
  NONE
}

enum ProductionReleaseRule {
  AFTER_BASE
  WITH_BASE
  DONE
}

enum ProductionRole {
  OPERATOR
  MANAGER
}

enum ProductionProjectStatus {
  STANDBY
  PRODUCTION
  DONE
  CANCELED
}

enum ProductionTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  PENDING
  DONE
  CANCELED
}

enum ProductionTimeSource {
  CLOCK
  DRAG
  CORRECTION
}

enum ProductionAttachmentKind {
  ART
  CUT
  PHOTO
  OTHER
}

/// A configuração da venda rápida (VR-4, VR-5, FC-17): uma por empresa.
model QuickSaleSettings {
  id                  String           @id @default(uuid())
  companyId           String           @unique
  enabled             Boolean          @default(true)
  /// Cobrar na hora, ou enviar à frente de caixa (VR-5)
  payment             QuickSalePayment @default(CASH_ONLY)
  /// dinheiro, pix, cartao
  cashMethods         String[]         @default(["dinheiro", "pix", "cartao"])
  downPaymentRequired Boolean          @default(false)
  downPaymentPercent  Int              @default(50)
  clientId            String?
  description         String           @default("")
  seriesId            String?
  /// O atendimento (origem de contato)
  serviceTypeId       String?
  responsibleId       String?
  updatedAt           DateTime         @updatedAt
  company             Company          @relation(fields: [companyId], references: [id])

  @@map("quick_sale_settings")
}

/// O cadastro da frente de caixa (FC-3, FC-7, FC-18): uma padrão por
/// empresa. Valores em centavos (tabela nova).
model CashFront {
  id                String           @id @default(uuid())
  companyId         String
  name              String           @default("Caixa 1")
  isDefault         Boolean          @default(false)
  blindCount        Boolean          @default(false)
  shortageTolerance Int?
  /// O arredondamento no balcão (FC-18): em valor (centavos) ou em
  /// percentual (centésimos de ponto: 500 = 5%)
  roundingType      CashRoundingType @default(VALUE)
  roundingLimit     Int              @default(100)
  /// A conta da gaveta (CASH), que recebe o dinheiro do fechamento
  drawerAccountId   String?
  /// A conta do PIX e a do cartão desta frente (CX-2): sem elas, vale a
  /// padrão da forma em Contas bancárias
  pixAccountId      String?
  cardAccountId     String?
  /// Quem pode abrir e movimentar esta frente (Lista Lite 19/11, item 2).
  /// Vazia: todos com a permissão da frente de caixa, como antes
  userIds           String[]         @default([])
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           Company          @relation(fields: [companyId], references: [id])
  sessions          CashSession[]

  @@index([companyId])
  @@map("cash_fronts")
}

/// A sessão do operador na frente de caixa (FC-7, FC-14).
model CashSession {
  id             String                @id @default(uuid())
  companyId      String
  cashFrontId    String
  number         Int
  operatorId     String?
  operatorName   String
  openedAt       DateTime              @default(now())
  openingBalance Int                   @default(0)
  status         CashSessionStatus     @default(OPEN)
  closedAt       DateTime?
  countedCash    Int?
  keep           Int?
  expected       Int?
  difference     Int?
  closingNote    String?
  /// Quem fechou: o operador, ou o responsável que fechou o caixa esquecido (FC-14)
  closedById     String?
  closedByName   String?
  cashFront      CashFront             @relation(fields: [cashFrontId], references: [id])
  movements      CashSessionMovement[]

  @@index([companyId, status])
  @@map("cash_sessions")
}

/// Recebimento, sangria, suprimento ou estorno na sessão (FC-8, FC-9, FC-13).
model CashSessionMovement {
  id              String                  @id @default(uuid())
  sessionId       String
  kind            CashSessionMovementKind
  description     String
  /// [{ method, paymentConditionId, bankAccountId, amount }] em centavos
  parts           Json                    @default("[]")
  discount        Int                     @default(0)
  /// O troco dado neste recebimento (FC-2), para o comprovante (FC-16)
  change          Int                     @default(0)
  reason          String?
  responsibleId   String?
  responsibleName String?
  bankAccountId   String?
  pendingSaleId   String?
  createdAt       DateTime                @default(now())
  session         CashSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([pendingSaleId])
  @@map("cash_session_movements")
}

/// A venda na fila do caixa, ou cobrada na hora (FC-2, FC-11, VR-5): a
/// situação no caixa do orçamento. Valores em centavos.
model PendingSale {
  id               String           @id @default(uuid())
  companyId        String
  quotationId      String           @unique
  kind             PendingSaleKind  @default(QUICK)
  path             QuickSalePayment @default(POS)
  total            Int
  paid             Int              @default(0)
  discount         Int              @default(0)
  /// O troco do último recebimento, para o comprovante (FC-16)
  change           Int              @default(0)
  delivered        Boolean          @default(false)
  /// false: o caixa faturou para o cliente (FC-4), fica só como registro
  goesToCash       Boolean          @default(true)
  claimedSessionId String?
  billing          String?
  billedSessionId  String?
  ready            Boolean          @default(false)
  readyAt          DateTime?
  cancelled        Boolean          @default(false)
  cancelledAt      DateTime?
  cancelReason     String?
  loss             Int?
  discardedByName  String?
  discardedAt      DateTime?
  approvedAt       DateTime
  sentAt           DateTime         @default(now())
  /// Tudo o que entrou: [{ method, paymentConditionId, bankAccountId, amount }]
  parts            Json             @default("[]")
  company          Company          @relation(fields: [companyId], references: [id])
  quotation        Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([companyId, delivered, cancelled])
  @@map("pending_sales")
}

enum QuickSalePayment {
  CASH_ONLY
  POS
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashSessionMovementKind {
  SALE
  WITHDRAWAL
  SUPPLY
  REVERSAL
}

enum CashRoundingType {
  VALUE
  PERCENT
}

enum PendingSaleKind {
  QUICK
  QUOTATION
}

/// O saldo do estoque por material e variação (ES-2, FULL). Quantidade na
/// unidade do material; custos em centavos por unidade.
model StockItem {
  id            String             @id @default(uuid())
  companyId     String
  materialId    String
  variationId   String?
  /// material|variação (vazia sem variação): um saldo por par
  key           String
  quantity      Float              @default(0)
  minimum       Float              @default(0)
  /// Custo médio ponderado (ES-5)
  averageCost   Int                @default(0)
  lastEntryCost Int?
  lastEntryDate DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  company       Company            @relation(fields: [companyId], references: [id])
  material      Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  variation     MaterialVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  movements     StockMovement[]
  lots          StockLot[]

  @@unique([companyId, key])
  @@map("stock_items")
}

/// Entrada, consumo ou ajuste, com a origem (ES-6).
model StockMovement {
  id            String            @id @default(uuid())
  companyId     String
  stockItemId   String
  kind          StockMovementKind
  /// Com sinal: a entrada soma, o consumo tira
  quantity      Float
  /// Centavos por unidade do material
  unitCost      Int?
  origin        String
  invoiceId     String?
  /// A venda da baixa por consumo (ES-7): uma baixa só por venda
  quotationId   String?
  /// A baixa no lote (rolo, chapa), pela tarefa ou à mão (ES-16)
  lotId         String?
  /// A tarefa da produção em que o impressor deu a baixa
  taskId        String?
  /// O material vendido que esta baixa substitui (material|variação): a
  /// baixa da venda não tira esse material de novo
  replacesKey   String?
  date          DateTime
  createdById   String?
  createdByName String?
  createdAt     DateTime          @default(now())
  stockItem     StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([invoiceId])
  @@index([quotationId])
  @@index([lotId])
  @@map("stock_movements")
}

/// A nota de entrada com os itens do fornecedor e a conciliação (ES-1, ES-3).
/// Valores em centavos.
model InboundInvoice {
  id               String               @id @default(uuid())
  companyId        String
  number           String
  series           String?
  /// A chave de acesso da NF-e: a mesma nota não entra duas vezes
  accessKey        String?
  supplierId       String?
  supplierName     String
  /// CNPJ ou CPF do emitente, só dígitos
  supplierDocument String?
  issueDate        DateTime
  total            Int
  status           InboundInvoiceStatus @default(PENDING)
  enteredAt        DateTime?
  enteredById      String?
  enteredByName    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  company          Company              @relation(fields: [companyId], references: [id])
  items            InboundInvoiceItem[]

  @@unique([companyId, accessKey])
  @@index([companyId, status])
  @@map("inbound_invoices")
}

model InboundInvoiceItem {
  id               String         @id @default(uuid())
  invoiceId        String
  position         Int
  supplierCode     String
  description      String
  supplierUnit     String
  quantity         Float
  /// Centavos por unidade do fornecedor
  unitValue        Int
  gtin             String?
  materialId       String?
  variationId      String?
  /// 1 unidade do fornecedor = N unidades do material
  conversionFactor Float?
  invoice          InboundInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("inbound_invoice_items")
}

/// O de-para do fornecedor (ES-3): o código dele → o material e o fator.
/// Vale nas próximas notas do mesmo fornecedor.
model SupplierItemLink {
  id               String   @id @default(uuid())
  companyId        String
  /// O documento do fornecedor (só dígitos) ou, sem ele, o nome normalizado
  supplierKey      String
  supplierCode     String
  materialId       String
  variationId      String?
  conversionFactor Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  material         Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([companyId, supplierKey, supplierCode])
  @@map("supplier_item_links")
}

enum StockMovementKind {
  ENTRY
  CONSUMPTION
  ADJUSTMENT
}

enum InboundInvoiceStatus {
  PENDING
  MATCHED
  ENTERED
}

/// A linha do extrato importado em OFX (CX-6): casada com um lançamento do
/// sistema, sugerida, sobrando, lançada a partir dela ou ignorada. Centavos,
/// com sinal: positivo entrou na conta.
model BankStatementLine {
  id                      String              @id @default(uuid())
  companyId               String
  bankAccountId           String
  /// O identificador do banco (FITID): o extrato importado de novo não duplica
  fitId                   String
  date                    DateTime            @db.Date
  amount                  Int
  memo                    String              @default("")
  status                  StatementLineStatus @default(UNMATCHED)
  /// O lançamento casado (ou o sugerido, na sugestão)
  transactionId           String?
  /// A parcela provisionada sugerida: casar a realiza
  receivableInstallmentId String?
  payableInstallmentId    String?
  importId                String
  fileName                String?
  importedAt              DateTime            @default(now())
  importedByName          String?
  matchedAt               DateTime?
  matchedByName           String?
  company                 Company             @relation(fields: [companyId], references: [id])
  bankAccount             BankAccount         @relation(fields: [bankAccountId], references: [id])

  @@unique([bankAccountId, fitId])
  @@index([companyId, bankAccountId, status])
  @@index([transactionId])
  @@map("bank_statement_lines")
}

enum StatementLineStatus {
  MATCHED
  SUGGESTED
  UNMATCHED
  CREATED
  IGNORED
}

// ---------------------------------------------------------------------------
// CRM fase 2 (27/10/2026): contatos da negociação e configuração do
// acompanhamento. O contato é uma tabela própria, não o histórico do
// orçamento: o cliente agrega contatos de vários orçamentos e o relatório
// conta por resultado.
// ---------------------------------------------------------------------------

enum ContactChannel {
  WHATSAPP
  PHONE
  EMAIL
  IN_PERSON
}

enum ContactOutcome {
  WAITING_CLIENT
  ADJUST_REQUESTED
  WILL_CLOSE
  NO_RESPONSE
  OTHER
}

model QuotationContact {
  id          String         @id @default(uuid())
  companyId   String
  quotationId String
  clientId    String?
  userId      String
  userName    String?
  channel     ContactChannel @default(WHATSAPP)
  outcome     ContactOutcome @default(WAITING_CLIENT)
  note        String?
  at          DateTime       @default(now())
  createdAt   DateTime       @default(now())
  quotation   Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId, at])
  @@index([clientId, at])
  @@index([companyId, at])
  @@map("quotation_contacts")
}

model FollowUpSettings {
  id                   String   @id @default(uuid())
  companyId            String   @unique
  templateProposalSent String?
  templateValidity     String?
  templateResume       String?
  dailyEmail           Boolean  @default(false)
  dailyEmailHour       Int      @default(8)
  inactiveDays         Int      @default(90)
  updatedAt            DateTime @updatedAt

  @@map("follow_up_settings")
}

/// O almoxarifado do FULL (ES-8 a ES-17; Maicol, 22/11/2026: "constrói e
/// adiciona no FULL"), como na primeira versão (VivaSign): Solicitação →
/// Cotação → Pedido de compra → Entrega e conferência → Estoque por lote.

enum PurchaseRequestStatus {
  /// Pedida, esperando a cotação
  REQUESTED
  /// Com cotação lançada
  QUOTING
  /// Virou pedido de compra
  ORDERED
  /// O pedido entrou no estoque
  RECEIVED
  CANCELED
}

/// A solicitação de material (ES-14, ES-17): aberta a quem tem a permissão;
/// guarda quem pediu, o quê e quando, e a linha do tempo até a entrega.
model PurchaseRequest {
  id              String                @id @default(uuid())
  companyId       String
  /// Sequencial por empresa
  number          Int
  /// O material e a variação; sem eles, a descrição livre
  materialId      String?
  variationId     String?
  description     String
  quantity        Float
  unit            String                @default("")
  /// Para quando precisa (opcional)
  neededBy        DateTime?             @db.Date
  note            String?
  status          PurchaseRequestStatus @default(REQUESTED)
  requestedById   String?
  requestedByName String
  cancelReason    String?
  /// O item do pedido em que a solicitação entrou
  orderItemId     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  company         Company               @relation(fields: [companyId], references: [id])
  quotes          PurchaseQuote[]
  events          PurchaseEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("purchase_requests")
}

/// A cotação de uma solicitação com um fornecedor (ES-14). Fechar o pedido
/// escolhe uma cotação por solicitação.
model PurchaseQuote {
  id            String          @id @default(uuid())
  companyId     String
  requestId     String
  supplierId    String?
  supplierName  String
  quantity      Float
  /// Centavos por unidade
  unitPrice     Int
  deliveryDays  Int?
  paymentTerms  String?
  validUntil    DateTime?       @db.Date
  note          String?
  chosen        Boolean         @default(false)
  createdByName String
  createdAt     DateTime        @default(now())
  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("purchase_quotes")
}

enum PurchaseOrderStatus {
  /// Pedido feito, esperando a entrega
  PENDING_DELIVERY
  /// Entregue: falta a conferência
  CHECKING
  /// Conferido e lançado no estoque
  FINISHED
  CANCELED
}

/// O pedido de compra (ES-13, ES-15): nasce da cotação ou direto; confirma
/// a entrega, confere (com a nota, quando houver) e lança o estoque.
model PurchaseOrder {
  id            String              @id @default(uuid())
  companyId     String
  number        Int
  supplierId    String?
  supplierName  String
  status        PurchaseOrderStatus @default(PENDING_DELIVERY)
  expectedAt    DateTime?           @db.Date
  deliveredAt   DateTime?
  checkedAt     DateTime?
  checkedByName String?
  /// A nota de entrada conferida contra o pedido
  invoiceId     String?
  /// A conta a pagar gerada pelo pedido (ES-15)
  payableId     String?
  total         Int                 @default(0)
  note          String?
  cancelReason  String?
  createdById   String?
  createdByName String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  company       Company             @relation(fields: [companyId], references: [id])
  items         PurchaseOrderItem[]
  events        PurchaseEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  orderId          String
  requestId        String?
  materialId       String?
  variationId      String?
  description      String
  unit             String        @default("")
  quantity         Float
  /// Centavos por unidade
  unitPrice        Int
  /// O que chegou, na conferência
  receivedQuantity Float?
  /// O que a conferência anotou (faltou, sobrou, avariado)
  divergence       String?
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("purchase_order_items")
}

/// A linha do tempo da solicitação e do pedido (ES-17).
model PurchaseEvent {
  id        String           @id @default(uuid())
  companyId String
  requestId String?
  orderId   String?
  text      String
  byName    String
  at        DateTime         @default(now())
  request   PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order     PurchaseOrder?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([orderId])
  @@map("purchase_events")
}

enum StockLotStatus {
  /// Fechado: entrou e ainda não foi aberto
  CLOSED
  /// Aberto: está sendo consumido
  OPEN
  /// Acabou
  FINISHED
  CANCELED
}

enum StockLotMeasure {
  /// Rolo: largura × comprimento (metro linear)
  ROLL
  /// Chapa: largura × altura
  SHEET
  /// Por quantidade
  UNIT
}

/// O lote (ES-8 a ES-12): cada rolo ou chapa que entrou, com o fornecedor,
/// o custo, a marca, a cor e as medidas; o saldo atual guarda a sobra (o
/// rolo de 1,22 × 50 m que hoje está com 0,50 × 47 m).
model StockLot {
  id              String          @id @default(uuid())
  companyId       String
  stockItemId     String
  /// Sequencial por empresa: L-nn
  number          Int
  supplierName    String          @default("")
  brand           String          @default("")
  color           String          @default("")
  measure         StockLotMeasure @default(UNIT)
  /// Centavos: o custo do lote inteiro
  cost            Int             @default(0)
  quantity        Float
  width           Float?
  length          Float?
  currentQuantity Float
  currentWidth    Float?
  currentLength   Float?
  status          StockLotStatus  @default(CLOSED)
  /// Aberto, o lote vai para um setor (a impressão) e fica disponível nas
  /// tarefas dele
  sectorId        String?
  sectorName      String          @default("")
  openedAt        DateTime?
  finishedAt      DateTime?
  cancelReason    String?
  /// De onde veio: o pedido, a nota, ou o lote que foi dividido
  orderId         String?
  invoiceId       String?
  parentId        String?
  createdByName   String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  company         Company         @relation(fields: [companyId], references: [id])
  stockItem       StockItem       @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  events          StockLotEvent[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([stockItemId])
  @@map("stock_lots")
}

/// O que aconteceu com o lote: entrada, abertura, baixa, divisão, fim.
model StockLotEvent {
  id       String   @id @default(uuid())
  lotId    String
  text     String
  /// A baixa: quanto saiu (na unidade do material)
  quantity Float?
  byName   String
  at       DateTime @default(now())
  lot      StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@map("stock_lot_events")
}
