model ImportLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entity String // 'client', 'product', 'quotation', 'supplier'
  status ImportStatus @default(QUEUED)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fileName String @map("file_name")
  fileSize Int    @map("file_size")
  fileUrl  String @map("file_url")

  totalRows   Int   @default(0) @map("total_rows")
  successRows Int   @default(0) @map("success_rows")
  failedRows  Int   @default(0) @map("failed_rows")
  errors      Json?

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@index([entity])
  @@map("import_logs")
}

// ==================== NF-e / Fiscal Models ====================

model InvoicyConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String

  // Identificação do emissor
  name      String // Nome identificador (ex: "Matriz", "Filial SP")
  isDefault Boolean @default(false) // Indica se é o emissor padrão da empresa

  // Credenciais Invoicy (campos novos)
  partnerKey  String? // Partner Key do Invoicy
  accessKey   String? // Access Key do Invoicy
  environment String? @default("HOMOLOGACAO") // PRODUCAO ou HOMOLOGACAO

  // Certificado Digital
  certificate         String? @db.Text // Certificado em Base64
  certificatePassword String? // Senha do certificado

  // Campos legados (mantidos para compatibilidade)
  apiToken String?
  ambiente Int     @default(2) // 1 = Produção, 2 = Homologação

  // Dados do emitente
  emitCnpj         String?
  emitIe           String?
  emitIm           String? // Inscrição Municipal (necessária para NFS-e)
  emitRazaoSocial  String?
  emitNomeFantasia String?
  emitCrt          Int     @default(1) // 1 = Simples Nacional, 2 = SN Excesso, 3 = Regime Normal
  emitEndereco     String?
  emitNumero       String?
  emitBairro       String?
  emitCep          String?
  emitCmun         String?
  emitXMun         String? // Nome do município (obrigatório para NF-e)
  emitUf           String?
  emitPais         String? @default("1058")

  // NF-e
  serieNfe         Int @default(1)
  proximoNumeroNfe Int @default(1)

  // NFS-e
  serieNfse      String? @default("A1") // NFS-e usa série alfanumérica
  proximoRpsNfse Int     @default(1) // Próximo número do RPS
  codigoServico  String? // Código do serviço municipal padrão
  aliquotaIss    Float? // Alíquota ISS padrão

  // NFC-e
  serieNfce         Int @default(1)
  proximoNumeroNfce Int @default(1)

  // Padrões fiscais
  defaultCfop            String? // CFOP padrão
  defaultOperationNature String? // Natureza da operação padrão
  taxInfoText            String? // Informações fiscais complementares

  isActive Boolean @default(true)
  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invoicy_configs")
}

// ==================== CFOP Config ====================

model CfopConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String

  code        String // Código CFOP (ex: "5102")
  description String // Descrição (ex: "Venda de mercadoria adquirida")
  type        String // "ENTRADA" ou "SAIDA"
  nature      String? // Natureza da operação (ex: "Venda de mercadoria")
  info        String? // Informações de uso
  isActive    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  naturesInternal OperationNature[] @relation("NatureInternal")
  naturesExternal OperationNature[] @relation("NatureExternal")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cfop_configs")
}

// ==================== Operation Nature ====================

model OperationNature {
  id        String @id @default(uuid())
  companyId String

  description      String
  type             String // ENTRADA, SAIDA
  finality         String // 1=Normal, 2=Complementar, etc.
  consumerPresence String // 0=Não, 1=Presencial, etc.
  info             String?

  // Relations to CFOPs
  cfopInternalId String?
  cfopExternalId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cfopInternal CfopConfig? @relation("NatureInternal", fields: [cfopInternalId], references: [id])
  cfopExternal CfopConfig? @relation("NatureExternal", fields: [cfopExternalId], references: [id])

  @@map("operation_natures")
}

