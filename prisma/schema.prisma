  company     Company @relation(fields: [companyId], references: [id])

  createdAt        DateTime           @default(now())
  updatedAt        DateTime?          @updatedAt
  isActive         Boolean            @default(true)
  receivable       Receivable[]
  payable          Payable[]
  subCategory      SubCategory[]
  scheduledExpense ScheduledExpense[]

  @@map("natures")
}

model SubCategory {
  id          String  @id @default(uuid())
  description String?
  code        String?
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])

  natureId String
  nature   Nature @relation(fields: [natureId], references: [id])

  createdAt        DateTime           @default(now())
  updatedAt        DateTime?          @updatedAt
  isActive         Boolean            @default(true)
  receivable       Receivable[]
  payable          Payable[]
  scheduledExpense ScheduledExpense[]

  @@map("sub_categories")
}

model ClientPaymentCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@unique([clientId, paymentConditionId])
  @@map("client_payment_conditions")
}

model SupplierPaymentCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  supplierId         String
  supplier           Supplier         @relation(fields: [supplierId], references: [id])
  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@unique([supplierId, paymentConditionId])
  @@map("supplier_payment_conditions")
}

enum PlanType {
  START
  LITE
  PRO
  ELITE
  FULL
}

model Plan {
  id          String    @id @default(uuid())
  type        PlanType
  name        String
  description String?
  price       Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  isActive    Boolean   @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  clients      Client[]
  Subscription Subscription[]

  @@map("plans")
}

enum BillingType {
  CREDIT_CARD
  BOLETO
  PIX
}

enum Cycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id                 String             @id @default(uuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?          @updatedAt
  isActive           Boolean            @default(true)
  isContractAccepted Boolean            @default(false)
  status             SubscriptionStatus @default(PENDING)
  billingType        BillingType        @default(CREDIT_CARD)
  planPrice          Float
  cycle              Cycle              @default(MONTHLY)
  name               String?
  cpfCnpj            String?
  email              String?
  phone              String?
  mobilePhone        String?
  address            String?
  addressNumber      String?
  complement         String?
  province           String?
  postalCode         String?
  city               String?
  neighborhood       String?

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  SUCCESS
  PENDING
  FAILED
}

model Contract {
  id         String   @id @default(uuid())
  name       String
  contentUrl String
  version    Int
  createdAt  DateTime @default(now())

  acceptedUsers UserContract[]

  @@map("contracts")
}

model UserContract {
  id         String   @id @default(uuid())
  userId     String
  contractId String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id])
  contract   Contract @relation(fields: [contractId], references: [id])

  @@unique([userId, contractId])
  @@map("user_contracts")
}
