}

model ClientPaymentCondition {
  id                 String           @id @default(uuid())
  createdAt          DateTime         @default(now())
  isActive           Boolean          @default(true)
  clientId           String
  paymentConditionId String
  client             Client           @relation(fields: [clientId], references: [id])
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@unique([clientId, paymentConditionId])
  @@map("client_payment_conditions")
}

model SupplierPaymentCondition {
  id                 String           @id @default(uuid())
  createdAt          DateTime         @default(now())
  isActive           Boolean          @default(true)
  supplierId         String
  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])
  supplier           Supplier         @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, paymentConditionId])
  @@map("supplier_payment_conditions")
}

model Plan {
  id           String         @id @default(uuid())
  type         PlanType
  description  String?
  price        Float
  createdAt    DateTime       @default(now())
  updatedAt    DateTime?      @updatedAt
  isActive     Boolean        @default(true)
  companyId    String
  name         String
  clients      Client[]
  company      Company        @relation(fields: [companyId], references: [id])
  Subscription Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?          @updatedAt
  isActive           Boolean            @default(true)
  planId             String
  companyId          String
  status             SubscriptionStatus @default(PENDING)
  isContractAccepted Boolean            @default(false)
  billingType        BillingType        @default(CREDIT_CARD)
  planPrice          Float
  cycle              Cycle              @default(MONTHLY)
  address            String?
  addressNumber      String?
  complement         String?
  cpfCnpj            String?
  email              String?
  mobilePhone        String?
  name               String?
  phone              String?
  postalCode         String?
  province           String?
  city               String?
  neighborhood       String?
  company            Company            @relation(fields: [companyId], references: [id])
  plan               Plan               @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Contract {
  id            String         @id @default(uuid())
  name          String
  contentUrl    String
  version       Int
  createdAt     DateTime       @default(now())
  acceptedUsers UserContract[]

  @@map("contracts")
}

model UserContract {
  id         String   @id @default(uuid())
  userId     String
  contractId String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  contract   Contract @relation(fields: [contractId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, contractId])
  @@map("user_contracts")
}

