// O consumo do assistente de IA por empresa e mês (IA-6, 28/10/2026): as
// mensagens que chegaram ao modelo (a barrada pela proteção não conta) são a
// cota do plano (limite ai_messages_month); os tokens e o custo, quando o
// provedor informa, dão o número real para fechar a cota de cada plano.
model AiUsage {
  id               String   @id @default(uuid())
  companyId        String
  // "2026-10", no fuso de São Paulo
  month            String
  messages         Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  // Custo em milionésimos de dólar, quando o provedor informa
  costMicroUsd     Int      @default(0)
  actionsProposed  Int      @default(0)
  actionsApplied   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, month])
  @@index([month])
  @@map("ai_usage")
}

// A proposta do assistente (agente, fase 2, 28/10/2026): a IA propõe, a
// pessoa confirma. Nada é gravado no orçamento, no lançamento ou no cadastro
// antes do "Aplicar"; quem grava é o servidor, pelos serviços das telas. A
// proposta vence em 24 horas e só quem a recebeu aplica.
model AiAction {
  id             String    @id @default(uuid())
  companyId      String
  userId         String
  conversationId String?
  // A resposta do assistente que trouxe a proposta
  messageId      String?
  // QUOTATION_DRAFT | QUICK_SALE_DRAFT | ITEM_DESCRIPTION | FINANCIAL_CATEGORY
  // | NEXT_CONTACT
  type           String
  // PROPOSED | APPLYING | APPLIED | DISCARDED | EXPIRED | FAILED
  status         String    @default("PROPOSED")
  // A proposta, já casada e calculada pelo servidor (valores em centavos)
  payload        Json
  // O que a pessoa mudou antes de aplicar
  edited         Json?
  // Os ids do que foi criado, ou o erro
  result         Json?
  expiresAt      DateTime
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, status])
  @@map("ai_actions")
}

