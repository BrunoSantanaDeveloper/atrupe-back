// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name                  String
  legalName             String?
  cnpj                  String?
  stateRegistration     String?
  municipalRegistration String?
  phone                 String?
  mobile                String?
  email                 String?
  siteUrl               String?
  isActive              Boolean @default(true)

  principalCompanyId String? // ID da empresa-mãe
  parentCompany      Company?  @relation("CompanyHierarchy", fields: [principalCompanyId], references: [id])
  subsidiaries       Company[] @relation("CompanyHierarchy")

  logoUrl         String?
  favIconUrl      String?
  textBeforeItems String?
  textAfterItems  String?

  sectors      CompanySector[] @relation("CompanyToCompanySector")
  clients      Client[]
  employees    Employee[]
  products     Product[]
  assets       Asset[]
  roles        Role[]
  suppliers    Supplier[]
  bankAccounts BankAccount[]
  assetTypes   AssetType[]
  categories   Category[]
  saleSeries   SaleSeries[]

  payables          Payable[]
  receivables       Receivable[]
  financialFlows    FinancialFlow[]
  cashControls      CashRegister[]
  scheduledExpenses ScheduledExpense[]
  invoices          Invoice[]

  paymentMethods        PaymentMethod[]
  paymentConditions     PaymentCondition[]
  paymentConfigurations PaymentConfiguration[]
  language              Language[]
  reasons               Reasons[]
  statusQuotation       StatusQuotation[]
  sellerProfile         SellerProfile[]
  salarySheet           SalarySheet[]
  deliveryType          DeliveryType[]
  deliverySchedule      DeliverySchedule[]
  address               Address[]
  companyUnitOfMeasure  CompanyUnitOfMeasure[]
  mainQuotations        Quotation[]            @relation("MainCompany")
  fiscalQuotations      Quotation[]            @relation("FiscalSubCompany")
  creditLimitDefault    CreditLimitDefault[]
  nature                Nature[]
  subCategory           SubCategory[]
  Plan                  Plan[]
  Subscription          Subscription[]
  SalaryControl         SalaryControl[]

  @@map("companies")
}

enum OwnerType {
  COMPANY
  EMPLOYEE
  CLIENT
  SUPPLIER
  CONTACT
}

model Address {
  id           String  @id @default(uuid())
  type         String  @default("Principal")
  street       String?
  number       String?
  neighborhood String?
  country      String?
  zipcode      String?
  complement   String?

  city  String?
  state String?
  // ibgeCode String?

  ownerType OwnerType @default(COMPANY)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  ownerId String?
  client  Client? @relation(fields: [ownerId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  @@index([ownerId, ownerType])
  @@index([supplierId, ownerType])
  @@map("addresses")
}

enum SectorKind {
  ADMINISTRATIVE
  OPERATIONAL
  FINANCIAL
  COMMERCIAL
  MARKETING
  IT
  HUMAN_RESOURCES
  LEGAL
  PRODUCTION
  LOGISTICS
  QUALITY
  SECURITY
  MAINTENANCE
  CLEANING
  SYSTEM
  OTHER
}

model DefaultSector {
  id   String     @id @default(uuid())
  name String
  icon String?
  kind SectorKind @default(PRODUCTION)

  companySectors CompanySector[] @relation("DefaultToCompanySector")

  @@map("default_sectors")
}

model CompanySector {
  id                String     @id @default(uuid())
  name              String
  icon              String?
  kind              SectorKind @default(PRODUCTION)
  isProductionStage Boolean    @default(true)
  isActive          Boolean    @default(true)
  isSystem          Boolean    @default(false)

  companyId String
  company   Company @relation("CompanyToCompanySector", fields: [companyId], references: [id])

  defaultSectorId String?
  defaultSector   DefaultSector? @relation("DefaultToCompanySector", fields: [defaultSectorId], references: [id])

  employees       Employee[]
  asset           Asset[]
  role            Role[]
  product         Product[]
  productionStage ProductionStage[]
  Category        Category[]

  @@map("sectors")
}

model Role {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)
  isAdmin  Boolean @default(false)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  sectorId String?
  sector   CompanySector? @relation(fields: [sectorId], references: [id])

  employees Employee[]

  userRole    UserRole[]
  permissions String[]

  @@map("roles")
}

model SellerProfile {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  employees Employee[]

  commission                Float?
  maxDiscount               Float?
  minValue                  Float?
  canApprovePreRegistration Boolean @default(false)
  canCancelSale             Boolean @default(false)

  @@map("seller_profile")
}

enum CategoryKind {
  PRODUCT
  SERVICE
  CLIENT
  SUPPLIER
  PAYABLE
  PAYABLE_ORIGIN
  RECEIVABLE
  RECEIVABLE_ORIGIN
}

model Category {
  id         String       @id @default(uuid())
  name       String
  kind       CategoryKind @default(PRODUCT)
  isActive   Boolean      @default(true)
  isStandard Boolean      @default(false)

  sectorId String?
  sector   CompanySector? @relation(fields: [sectorId], references: [id])

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  products Product[]

  @@map("categories")
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum ClientKind {
  PERSON
  COMPANY
}

model Contact {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name   String
  email  String?
  phone  String?
  mobile String?
  sector String?

  notes String?

  client     Client?   @relation(fields: [clientId], references: [id])
  clientId   String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  @@map("contacts")
}

model CreditLimitDefault {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt
  type      ClientKind @default(PERSON)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  minValue Float?
  maxValue Float?

  paymentConditions CreditLimitPaymentCondition[]

  @@map("credit_limit_default")
}

model CreditLimitPaymentCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  creditLimitDefaultId String
  creditLimitDefault   CreditLimitDefault @relation(fields: [creditLimitDefaultId], references: [id])

  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@unique([creditLimitDefaultId, paymentConditionId])
  @@map("credit_limit_payment_conditions")
}

model Client {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  type   ClientKind   @default(PERSON)
  status ClientStatus @default(PROSPECT)

  name   String
  email  String?
  phone  String?
  mobile String?

  rg            String?
  cpf           String?
  cnpj          String?
  activity      String?
  tradeName     String?
  corporateName String?

  notes          String?
  financialNotes String?
  nickname       String?
  site           String?
  birthdate      DateTime?

  address Address[]

  contacts      Contact[]
  responsibleId String?
  responsible   Employee? @relation(fields: [responsibleId], references: [id])
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  category      String?

  minValue Float?
  maxValue Float?

  blockClient Boolean @default(false)

  quotation  Quotation[]
  receivable Receivable[]

  paymentConditions ClientPaymentCondition[]
  supplierId        String?
  supplier          Supplier?                @relation(fields: [supplierId], references: [id])

  // entityId     Int?
  // legacyId     Int?
  // legacyDbCode String?
  payable Payable[]
  Plan    Plan?     @relation(fields: [planId], references: [id])
  planId  String?

  @@map("clients")
}

model Supplier {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  type   ClientKind   @default(PERSON)
  status ClientStatus @default(ACTIVE)

  name   String
  email  String?
  phone  String?
  mobile String?

  rg            String?
  cpf           String?
  cnpj          String?
  activity      String?
  tradeName     String?
  corporateName String?

  notes          String?
  financialNotes String?
  nickname       String?
  site           String?
  birthdate      DateTime?

  address Address[]

  contacts     Contact[]
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  category     String?
  deliveryInfo DeliveryInfo[]
  commission   Commission[]
  payable      Payable[]

  paymentConditions SupplierPaymentCondition[]

  minValue Float?
  maxValue Float?

  blockClient      Boolean            @default(false)
  client           Client[]
  receivable       Receivable[]
  scheduledExpense ScheduledExpense[]

  @@map("suppliers")
}

model Employee {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  isActive  Boolean   @default(true)

  name         String?
  avatarUrl    String?
  cpf          String?
  rg           String?
  phone        String?
  mobile       String?
  address      Address[]
  sallary      Float?
  signatureUrl String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  sectorId String?
  sector   CompanySector? @relation(fields: [sectorId], references: [id])

  client          Client[]
  quotation       Quotation[]
  sellerProfileId String?
  sellerProfile   SellerProfile?  @relation(fields: [sellerProfileId], references: [id])
  salarySheet     SalarySheet[]
  SalaryControl   SalaryControl[]

  @@map("employees")
}

model User {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  isActive   Boolean   @default(true)
  isVerified Boolean   @default(false)

  name     String
  password String
  email    String  @unique
  avatar   String?
  phone    String?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  attributes   Attribute[]
  userRole     UserRole[]
  employee     Employee[]
  UserContract UserContract[]

  @@index([email])
  @@map("users")
}

model MailVerification {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  email     String    @unique
  token     String?
  expiresAt DateTime?

  verified Boolean @default(false)

  @@map("mail_verifications")
}

model Asset {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name                       String
  purchaseValue              Float
  residualValue              Float
  usefulLife                 Int
  costGroupId                Int?
  fixedMonthlyCost           Float?
  variableTotalMonthlyCost   Float?
  variableQualityMonthlyCost Float?
  companyId                  String?
  typeId                     String?
  sectorId                   String?

  // costGroup        CostGroup?       @relation(fields: [costGroupId], references: [id])
  // costs            Cost[]
  company Company?       @relation(fields: [companyId], references: [id])
  type    AssetType?     @relation(fields: [typeId], references: [id])
  sector  CompanySector? @relation(fields: [sectorId], references: [id])

  @@map("assets")
}

model AssetType {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name       String
  details    String?
  isActive   Boolean @default(true)
  isStandard Boolean @default(false)
  companyId  String?

  company Company? @relation(fields: [companyId], references: [id])
  assets  Asset[]

  @@map("asset_types")
}

enum PaymentStatus {
  PENDING
  PROVISIONED
  PAID
  OVERDUE
  CANCELED
}

model Receivable {
  id String @id @default(uuid())

  reference     String?
  referenceDate DateTime

  description       String?
  notes             String?
  totalValue        Float?
  mainAdditionalFee Float?
  natureId          String?
  nature            Nature? @relation(fields: [natureId], references: [id])

  status         PaymentStatus           @default(PENDING)
  totalAmount    Float? // Valor total da movimentação
  installmentQty Int? // Número de parcelas
  installments   ReceivableInstallment[] // Relacionamento com parcelas
  history        ReceivableHistory[] // Relacionamento com histórico
  cancelReason   String?
  cancelNotes    String?
  changeReason   String?
  changeNotes    String?

  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("receivables")
}

model ReceivableInstallment {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id])

  installmentNumber Int
  dueDate           DateTime
  amount            Float
  paidAmount        Float?
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  additionalFee     Float?
  status            PaymentStatus  @default(PENDING)
  paidDate          DateTime?
  provisionDate     DateTime?
  bankAccountId     String?
  bankAccount       BankAccount?   @relation(fields: [bankAccountId], references: [id])

  transactionId        String?
  transactions         Transaction?           @relation(fields: [transactionId], references: [id])
  quotationInstallment QuotationInstallment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("receivable_installments")
}

model ReceivableHistory {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id])

  action      String // Ação realizada (e.g., "PARCELA ALTERADA", "PAGAMENTO REALIZADO")
  description String // Descrição detalhada da alteração
  timestamp   DateTime @default(now()) // Data/hora do evento

  createdBy String // Quem realizou a ação (pode ser um ID de usuário)
  createdAt DateTime @default(now())

  @@map("receivable_history")
}

model Payable {
  id String @id @default(uuid())

  reference     String?
  referenceDate DateTime

  description       String?
  notes             String?
  totalValue        Float?
  mainAdditionalFee Float?
  natureId          String?
  nature            Nature? @relation(fields: [natureId], references: [id])

  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  status         PaymentStatus        @default(PENDING)
  totalAmount    Float // Valor total da movimentação
  installmentQty Int? // Número de parcelas
  installments   PayableInstallment[] // Relacionamento com parcelas
  history        PayableHistory[] // Relacionamento com histórico
  cancelReason   String?
  cancelNotes    String?
  changeReason   String?
  changeNotes    String?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  createdAt  DateTime     @default(now())
  updatedAt  DateTime?    @updatedAt
  commission Commission[]

  @@map("payables")
}

model PayableInstallment {
  id        String  @id @default(uuid())
  payableId String
  payable   Payable @relation(fields: [payableId], references: [id])

  installmentNumber Int
  dueDate           DateTime
  amount            Float
  paidAmount        Float?
  paymentMethodId   String?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  additionalFee     Float?
  status            PaymentStatus  @default(PENDING)
  provisionDate     DateTime?
  paidDate          DateTime?

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  transactionId        String?
  transactions         Transaction?           @relation(fields: [transactionId], references: [id])
  quotationInstallment QuotationInstallment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("payable_installments")
}

model PayableHistory {
  id        String  @id @default(uuid())
  payableId String
  payable   Payable @relation(fields: [payableId], references: [id])

  action      String // Ação realizada (e.g., "PARCELA ALTERADA", "PAGAMENTO REALIZADO")
  description String // Descrição detalhada da alteração
  timestamp   DateTime @default(now()) // Data/hora do evento

  createdBy String // Quem realizou a ação (pode ser um ID de usuário)
  createdAt DateTime @default(now())

  @@map("payable_history")
}

enum FinancialFlowType {
  INCOME
  EXPENSE
}

model SalarySheet {
  id     String      @id @default(uuid()) // ID da folha de pagamento
  month  Int // Mês de referência (0 a 11)
  year   Int // Ano de referência
  status SheetStatus @default(EMPTY) // Status da folha (aberta ou fechada)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  employeeId String // Relacionamento com o funcionário
  employee   Employee @relation(fields: [employeeId], references: [id])

  items     SalaryItem[] // Relacionamento com os itens da folha (acréscimos, descontos)
  movements PaymentMovement[] // Relacionamento com as movimentações de pagamento (contas a pagar)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([employeeId, month, year])
  @@map("salary_sheets")
}

enum SheetStatus {
  EMPTY //Sem Lançamento
  OPEN // Folha aberta
  CLOSED // Folha fechada
}

model SalaryItem {
  id            String      @id @default(uuid()) // ID do item
  salarySheetId String // Relacionamento com a folha de pagamento
  salarySheet   SalarySheet @relation(fields: [salarySheetId], references: [id])
  paidAt        DateTime?

  type        ItemType // Tipo do item (Acréscimo, Desconto, Adiantamento)
  description String? // Descrição do item (ex: Salário Base, Bonus, etc.)
  amount      Float // Valor do item
  reference   String // Referência do item (ex: mês de referência)

  createdAt DateTime @default(now()) // Data de criação
  updatedAt DateTime @updatedAt // Data de atualização

  @@map("salary_items")
}

enum ItemType {
  INCREASE // Acréscimo
  DISCOUNT // Desconto
  ADVANCE // Adiantamento
}

model SalaryControl {
  id        String   @id @default(uuid())
  reference String
  amount    Float    @default(0)
  type      ItemType @default(INCREASE)
  date      DateTime @default(now())
  isSet     Boolean  @default(false)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  employeeId String // Relacionamento com o funcionário
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("salary_controls")
}

model PaymentMovement {
  id            String      @id @default(uuid()) // ID da movimentação de pagamento
  salarySheetId String // Relacionamento com a folha de pagamento
  salarySheet   SalarySheet @relation(fields: [salarySheetId], references: [id])

  amount          Float // Valor pago
  paidDate        DateTime // Data do pagamento
  paymentStatus   PaymentSalaryStatus @default(PENDING) // Status do pagamento (PENDENTE, PAGO)
  paymentMethodId String // Forma de pagamento (referência à tabela de PaymentMethod)
  paymentMethod   PaymentMethod       @relation(fields: [paymentMethodId], references: [id])

  createdAt DateTime @default(now()) // Data de criação
  updatedAt DateTime @updatedAt // Data de atualização

  @@map("payment_movements")
}

enum PaymentSalaryStatus {
  PENDING // Pago ou pendente
  PAID // Pago
}

model FinancialFlow {
  id          String            @id @default(uuid())
  amount      Float
  type        FinancialFlowType
  description String
  date        DateTime
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  createdAt   DateTime          @default(now())

  @@map("financial_flows")
}

model CashRegister {
  id          String             @id @default(uuid())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime?          @updatedAt
  description String?
  status      CashRegisterStatus @default(OPEN)
  notes       String?

  openingDate    DateTime
  closingDate    DateTime?
  openingBalance Float
  totalIncomes   Float     @default(0)
  totalOutcomes  Float     @default(0)
  retroactive    Float     @default(0) // Diferença acumulada de reaberturas
  closingBalance Float? // Calculado apenas ao fechar

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  cashControls BankAccountCashControl[]

  transactions Transaction[]

  @@map("cash_registers")
}

model Transaction {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  type            TransactionType
  amount          Float           @default(0)
  description     String?
  transactionDate DateTime        @default(now())
  reason          String? // Motivo para edição ou transferência

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  receivableInstallment ReceivableInstallment[]
  payableInstallment    PayableInstallment[]

  @@map("transactions")
}

enum TransactionType {
  INCOME
  OUTCOME
  TRANSFER_INCOME
  TRANSFER_OUTCOME
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model ScheduledExpense {
  id            String        @id @default(uuid())
  description   String?
  amount        Float         @default(0)
  dueDay        Int           @default(1)
  recurringType RecurringType @default(MONTHLY)

  supplierId String?
  companyId  String

  categoryId    String?
  nature        Nature?      @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("scheduled_expenses")
}

enum RecurringType {
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUALLY
  YEARLY
  ONCE
}

model Invoice {
  id        String   @id @default(uuid())
  number    String
  date      DateTime
  amount    Float
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([number, companyId])
  @@map("invoices")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Attribute {
  id     String @id @default(uuid())
  key    String
  value  String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("attributes")
}

model Bank {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name     String
  icon     String?
  code     String
  details  Json?
  isActive Boolean @default(true)

  accounts BankAccount[]

  @@map("banks")
}

model BankAccount {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name        String
  description String?
  isActive    Boolean @default(true)

  cashControl Boolean @default(false)

  bankAccountCashControl BankAccountCashControl[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  bankId    String
  bank      Bank    @relation(fields: [bankId], references: [id])

  cashRegister          CashRegister[]
  ReceivableInstallment ReceivableInstallment[]
  PayableInstallment    PayableInstallment[]

  @@map("bank_accounts")
}

enum BankAccountCashControlType {
  PAYSOFF
  PROVISION
}

model BankAccountCashControl {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  acceptPayments Boolean                    @default(true)
  paymentType    BankAccountCashControlType @default(PAYSOFF)
  acceptIncomes  Boolean                    @default(true)
  incomeType     BankAccountCashControlType @default(PAYSOFF)

  acceptMultipleCashRegisters Boolean @default(false)

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  @@map("bank_account_cash_controls")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)

  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id])
  paymentConfigurations  PaymentConfiguration[]
  bankAccountCashControl BankAccountCashControl[]
  paymentCondition       PaymentCondition[]
  receivableInstallment  ReceivableInstallment[]
  payableInstallment     PayableInstallment[]
  paymentMovement        PaymentMovement[]
  quotationPayment       QuotationPayment[]
  quotationInstallment   QuotationInstallment[]

  @@map("payment_methods")
}

enum PaymentConditionCostType {
  PERCENT
  VALUE
}

model PaymentCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  name               String
  acceptInstallments Boolean                  @default(false)
  costType           PaymentConditionCostType

  minInstallments Int?
  maxInstallments Int?
  installments    Installment[]

  receivingType String?
  dayInterval   Int?

  paymentMethodId       String
  paymentMethod         PaymentMethod          @relation(fields: [paymentMethodId], references: [id])
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  paymentConfigurations PaymentConfiguration[]

  clients                     ClientPaymentCondition[]
  suppliers                   SupplierPaymentCondition[]
  CreditLimitPaymentCondition CreditLimitPaymentCondition[]
  downPaymentConditions       QuotationPayment[]            @relation(name: "downPaymentRelation")
  quotationPayments           QuotationPayment[]            @relation(name: "defaultRelation")

  @@map("payment_conditions")
}

model Installment {
  id String @id @default(uuid())

  installment         Int // Número da parcela
  dueDate             DateTime?
  operatorFeeRate     Float     @default(0)
  operatorFeeTransfer Float     @default(0)

  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@map("installments")
}

model PaymentConfiguration {
  id                 String           @id @default(uuid())
  paymentMethodId    String
  paymentMethod      PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  createdAt          DateTime         @default(now())

  @@map("payment_configurations")
}

enum BiilingKind {
  ON_ORDER
  ON_DELIVERY
  ON_CHECKOUT
  NO_INVOICE
}

enum SendToProductionKind {
  DIRECT
}

enum ProductionStatusKind {
  MANAGE_PRODUCTION
  PRODUCTION_COMPLETED
}

model SaleSeries {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  isActive   Boolean   @default(true)
  isTraining Boolean   @default(false)

  code                String
  description         String?
  title               String
  currentBudgetNumber Int     @default(0)
  proposalValidity    Int?
  deliveryDeadline    Int?

  billing          BiilingKind          @default(ON_ORDER)
  sendToProduction SendToProductionKind @default(DIRECT)
  productionStatus ProductionStatusKind @default(MANAGE_PRODUCTION)

  textBeforeItems String?
  textAfterItems  String?

  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  quotation Quotation[]

  @@unique([code, companyId])
  @@map("sale_series")
}

enum QuotationStatus {
  APPROVED //Aprovado
  OPEN //Digitação
  DONE //Aguardando
  CLOSED
  CANCELED
  REJECTED //Rejeitado
  OVERDUE //Vencido
}

model StatusQuotation {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt
  isActive  Boolean     @default(true)
  title     String
  color     String // Cor no formato hexadecimal, ex: "#FF5733"
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  quotation Quotation[]

  @@map("status_quotation")
}

model Quotation {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  approvedAt      DateTime?
  finishedAt      DateTime?
  isActive        Boolean   @default(true)
  quotationNumber Int?

  description String?
  status      QuotationStatus @default(OPEN)
  dueDate     DateTime        @default(now())
  contactType String?

  totalValue Float @default(0)

  sellerId     String
  seriesId     String?
  clientId     String?
  companyId    String
  subCompanyId String?

  tagId     String?
  quickSale Boolean @default(false)

  seller     Employee    @relation(fields: [sellerId], references: [id])
  subCompany Company?    @relation("FiscalSubCompany", fields: [subCompanyId], references: [id])
  company    Company     @relation("MainCompany", fields: [companyId], references: [id])
  series     SaleSeries? @relation(fields: [seriesId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])

  tag StatusQuotation? @relation(fields: [tagId], references: [id])

  reasonId String?
  reasons  Reasons? @relation(fields: [reasonId], references: [id])

  products         Product[]          @relation("QuotationToProduct")
  quotationProduct QuotationProduct[]
  order            Order?
  deliveryInfo     DeliveryInfo?
  quotationPayment QuotationPayment?
  DeliverySchedule DeliverySchedule?
  payable          Payable[]
  receivable       Receivable[]

  @@index([id, companyId])
  @@map("quotations")
}

model QuotationProduct {
  id          String    @id @default(uuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  quotationId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  quantity             Int     @default(1)
  description          String?
  technicalDescription String?
  imageUrl             String?
  totalValue           Float?
  notes                String?
  discount             Float?
  discountType         String?
  finalValue           Float?

  items                QuotationProductItem[]
  allowEditDescription Boolean                @default(true)
  allowEditValues      Boolean                @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("quotation_products")
}

model QuotationProductItem {
  id                 String           @id @default(uuid())
  quotationId        String
  productId          String
  quotationProductId String
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id])

  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  name             String
  quantity         Int                  @default(1)
  originalQuantity Int                  @default(1)
  unitOfMeasureId  String
  unitOfMeasure    CompanyUnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  width            Float? //largura
  height           Float? //altura
  length           Float? //comprimento
  weight           Float? //peso
  volume           Float? //volume
  distance         Float? //distancia
  duration         Float? //duração (em dias)

  unitCost  Float?
  salePrice Float?

  totalValue Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("quotation_product_items")
}

enum InvoiceType {
  NFE
  NFSE
  OTHER
}

model QuotationPayment {
  id            String      @id @default(uuid())
  quotationId   String      @unique
  quotation     Quotation   @relation(fields: [quotationId], references: [id])
  type          InvoiceType @default(OTHER)
  billing       BiilingKind @default(ON_ORDER)
  discountType  String      @default("VALUE")
  discountValue Float       @default(0) // Desconto
  discountTotal Float       @default(0) // Desconto

  downPayment              Float             @default(0) // Entrada
  downPaymentConditionId   String?
  downPaymentCondition     PaymentCondition? @relation(name: "downPaymentRelation", fields: [downPaymentConditionId], references: [id])
  downPaymentAdditionalFee Float             @default(0) //Acrescimo da entrada
  downPaymentDueDate       DateTime?

  paymentMethodId String? // Relação com a tabela de métodos de pagamento
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  paymentConditionId String? // Relação com a tabela de condições de pagamento
  paymentCondition   PaymentCondition? @relation(name: "defaultRelation", fields: [paymentConditionId], references: [id])

  commissionId String?     @unique
  commission   Commission? @relation(fields: [commissionId], references: [id])

  totalValue  Float // Valor total do orçamento
  description String? // Observações
  finalValue  Float?

  installmentQty    Int?
  minInstallmentQty Int?
  maxInstallmentQty Int?
  mainAdditionalFee Float?
  additionalFeeType String?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  quotationInstallment QuotationInstallment[]

  @@map("quotation_payments")
}

model Commission {
  id String @id @default(uuid())

  type CommissionType @default(ADD)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  transferMethod transferMethodCommission @default(SINGLE)

  commissionValue Float  @default(0)
  commissionType  String @default("VALUE")

  totalCommission Float @default(0)

  quotationPayment QuotationPayment?
  receivableId     String?
  payableId        String?
  payable          Payable?          @relation(fields: [payableId], references: [id])

  @@map("commissions")
}

enum transferMethodCommission {
  SINGLE
  PAYMENT_BASED
}

enum CommissionType {
  ADD
  SUB
}

model QuotationInstallment {
  id                 String           @id @default(uuid())
  quotationPaymentId String // Relação com o pagamento do orçamento
  quotationPayment   QuotationPayment @relation(fields: [quotationPaymentId], references: [id])
  dueDate            DateTime // Data de vencimento da parcela
  paymentMethodId    String // Forma de pagamento para a parcela
  paymentMethod      PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  additionalFee      Float            @default(0) // Acréscimo
  value              Float // Valor da parcela
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  payableInstallment   PayableInstallment? @relation(fields: [payableInstallmentId], references: [id])
  payableInstallmentId String?

  receivableInstallment   ReceivableInstallment? @relation(fields: [receivableInstallmentId], references: [id])
  receivableInstallmentId String?

  @@map("quotation_installments")
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  DELIVERY
  COMPLETED
  FINISHED
  CANCELED
}

model DeliveryInfo {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  deliveryType DeliveryType @default(PICKUP)

  daysAfterApproval Int?
  estimatedDate     DateTime?
  modality          String    @default("Indefinida")
  cost              Float?
  value             Float?
  notes             String?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt
  deliverySchedule DeliverySchedule?

  @@index([quotationId])
  @@map("delivery_info")
}

enum DeliveryType {
  INSTALLATION
  CARRIER
  PICKUP
}

model Order {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  canceledAt  DateTime?
  deliveredAt DateTime?

  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  status   OrderStatus @default(IN_PRODUCTION)
  isActive Boolean     @default(true)

  reasonId     String?
  cancelReason Reasons? @relation(fields: [reasonId], references: [id])

  deliverySchedule DeliverySchedule[]

  @@index([id])
  @@map("orders")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id   String @id @default(uuid())
  name String
  code String

  isActive   Boolean       @default(true)
  status     ProductStatus @default(ACTIVE)
  isStandard Boolean       @default(false)

  technicalDescription String?
  allowEditValues      Boolean @default(true)
  allowEditDescription Boolean @default(true)
  imageUrl             String?

  items            ProductItem[]
  productionStages Json?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  sectorId String
  sector   CompanySector @relation(fields: [sectorId], references: [id])

  quotations       Quotation[]        @relation("QuotationToProduct")
  quotationProduct QuotationProduct[]

  @@unique([code, companyId])
  @@map("products")
}

model ProductItem {
  id   String @id @default(uuid())
  name String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  unitOfMeasureId String
  unitOfMeasure   CompanyUnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  width           Float? //largura
  height          Float? //altura
  length          Float? //comprimento
  weight          Float? //peso
  volume          Float? //volume
  distance        Float? //distancia
  duration        Float? //duração (em dias)

  unitCost             Float?
  salePrice            Float?
  quotationProductItem QuotationProductItem[]

  @@map("product_items")
}

enum UnitOfMeasureKind {
  LENGTH
  WEIGHT
  CAPACITY
}

model CompanyUnitOfMeasure {
  id          String             @id @default(uuid())
  name        String
  code        String
  kind        UnitOfMeasureKind?
  description String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  defaultUnitOfMeasureId String?
  defaultUnitOfMeasure   DefaultUnitOfMeasure? @relation(fields: [defaultUnitOfMeasureId], references: [id])

  isActive     Boolean       @default(true)
  productItems ProductItem[]

  quotationProductItem QuotationProductItem[]

  @@map("unit_measures")
}

model DefaultUnitOfMeasure {
