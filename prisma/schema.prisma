  cycle                Cycle                 @default(MONTHLY)
  Company              Company?              @relation(fields: [companyId], references: [id])
  customer             Customer              @relation(fields: [customerId], references: [id])
  plan                 Plan                  @relation(fields: [planId], references: [id])
  subscriptionFeatures SubscriptionFeature[]
  payments             Payment[]
  history              SubscriptionHistory[]

  @@map("subscriptions")
}

model Payment {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime?          @updatedAt
  subscriptionId    String?
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id])
  asaasPaymentId    String             @unique
  asaasCustomerId   String
  value             Float
  dueDate           DateTime
  billingType       BillingType
  status            AsaasPaymentStatus @default(PENDING)
  description       String?
  externalReference String? // TODO: Remover, este é o próprio id do payment
  invoiceUrl        String?
  bankSlipUrl       String?
  pixQrCode         String?
  pixCopyPaste      String?
  confirmedDate     DateTime?
  paymentDate       DateTime?

  @@index([subscriptionId])
  @@index([asaasPaymentId])
  @@index([status])
  @@map("payments")
}

model SubscriptionFeature {
  id             String       @id @default(uuid())
  subscriptionId String
  featureId      String
  isActive       Boolean      @default(true)
  price          Float        @default(0) // preço adicional desta feature
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  feature        Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureId])
  @@map("subscription_features")
}

model Contract {
  id            String         @id @default(uuid())
