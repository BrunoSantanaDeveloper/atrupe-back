model UserActivity {
  id         String    @id @default(uuid())
  userId     String
  companyId  String?
  employeeId String?
  sessionId  String // Identificador único da sessão (gerado no login)
  endpoint   String? // Endpoint acessado (ex: /api/clients, /api/quotations)
  method     String? // Método HTTP (GET, POST, PUT, DELETE)
  ipAddress  String?
  userAgent  String?
  lastActive DateTime  @default(now()) // Última atividade registrada
