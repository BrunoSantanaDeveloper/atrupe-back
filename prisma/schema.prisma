/// Execução da migração de um cliente do sistema legado.
///
/// A carga roda como processo separado, fora do ciclo da requisição: são
/// milhares de gravações e minutos de execução, que não cabem num request. A
/// API apenas dispara e devolve o identificador; quem escreve aqui é o próprio
/// script, então o acompanhamento sobrevive a um reinício da API.
model MigrationRun {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Nome da base no legado, no formato acn_000000.
  legacyBase String

  // Simulação não grava nada; serve para conferir antes da carga.
  dryRun Boolean @default(true)

  status     MigrationRunStatus @default(QUEUED)
  startedAt  DateTime?
  finishedAt DateTime?

  // Contagens por entidade, como o relatório do script.
  summary       Json?
  // Linhas recusadas, para o suporte encaminhar ao time.
  errors        Json?
  // Motivo de uma falha que interrompeu a execução inteira.
  failureReason String?

  startedById String
  startedBy   User   @relation("MigrationRunStartedBy", fields: [startedById], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("migration_runs")
}

