generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now())
  isActive              Boolean                @default(true)
  updatedAt             DateTime?              @updatedAt
  cnpj                  String?
  legalName             String?
  municipalRegistration String?
  stateRegistration     String?
  email                 String?
  favIconUrl            String?
  logoUrl               String?
  mobile                String?
  phone                 String?
  siteUrl               String?
  textAfterItems        String?
  textBeforeItems       String?
  principalCompanyId    String?
  deliveryType          DeliveryType[]
  address               Address[]
  assetTypes            AssetType[]
  assets                Asset[]
  bankAccounts          BankAccount[]
  cashControls          CashRegister[]
  categories            Category[]
  clients               Client[]
  parentCompany         Company?               @relation("CompanyHierarchy", fields: [principalCompanyId], references: [id])
  subsidiaries          Company[]              @relation("CompanyHierarchy")
  creditLimitDefault    CreditLimitDefault[]
  deliverySchedule      DeliverySchedule[]
  employees             Employee[]
  financialFlows        FinancialFlow[]
  invoices              Invoice[]
  language              Language[]
  nature                Nature[]
  payables              Payable[]
  paymentConditions     PaymentCondition[]
  paymentConfigurations PaymentConfiguration[]
  paymentMethods        PaymentMethod[]
  Plan                  Plan[]
  products              Product[]
  mainQuotations        Quotation[]            @relation("MainCompany")
  fiscalQuotations      Quotation[]            @relation("FiscalSubCompany")
  reasons               Reasons[]
  receivables           Receivable[]
  roles                 Role[]
  SalaryControl         SalaryControl[]
  salarySheet           SalarySheet[]
  saleSeries            SaleSeries[]
  scheduledExpenses     ScheduledExpense[]
  sectors               CompanySector[]        @relation("CompanyToCompanySector")
  sellerProfile         SellerProfile[]
  statusQuotation       StatusQuotation[]
  subCategory           SubCategory[]
  Subscription          Subscription[]
  suppliers             Supplier[]
  companyUnitOfMeasure  CompanyUnitOfMeasure[]

  @@map("companies")
}

model Address {
  id           String    @id @default(uuid())
  street       String?
  number       String?
  country      String?
  ownerId      String?
  ownerType    OwnerType @default(COMPANY)
  complement   String?
  neighborhood String?
  zipcode      String?
  city         String?
  state        String?
  type         String    @default("Principal")
  supplierId   String?
  companyId    String?
  employeeId   String?
  company      Company?  @relation(fields: [companyId], references: [id])
  employee     Employee? @relation(fields: [employeeId], references: [id])
  client       Client?   @relation(fields: [ownerId], references: [id])
  supplier     Supplier? @relation(fields: [supplierId], references: [id])

  @@index([ownerId, ownerType])
  @@index([supplierId, ownerType])
  @@map("addresses")
}

model DefaultSector {
  id             String          @id @default(uuid())
  name           String
  icon           String?
  kind           SectorKind      @default(PRODUCTION)
  companySectors CompanySector[] @relation("DefaultToCompanySector")

  @@map("default_sectors")
}

model CompanySector {
  id                String            @id @default(uuid())
  name              String
  icon              String?
  companyId         String
  isActive          Boolean           @default(true)
  kind              SectorKind        @default(PRODUCTION)
  isProductionStage Boolean           @default(true)
  defaultSectorId   String?
  isSystem          Boolean           @default(false)
  asset             Asset[]
  Category          Category[]
  employees         Employee[]
  productionStage   ProductionStage[]
  product           Product[]
  role              Role[]
  company           Company           @relation("CompanyToCompanySector", fields: [companyId], references: [id])
  defaultSector     DefaultSector?    @relation("DefaultToCompanySector", fields: [defaultSectorId], references: [id])

  @@map("sectors")
}

model Role {
  id          String         @id @default(uuid())
  name        String
  companyId   String
  isActive    Boolean        @default(true)
  sectorId    String?
  isAdmin     Boolean        @default(false)
  permissions String[]
  employees   Employee[]
  company     Company        @relation(fields: [companyId], references: [id])
  sector      CompanySector? @relation(fields: [sectorId], references: [id])
  userRole    UserRole[]

  @@map("roles")
}

model SellerProfile {
  id                        String     @id @default(uuid())
  name                      String
  isActive                  Boolean    @default(true)
  companyId                 String
  commission                Float?
  maxDiscount               Float?
  minValue                  Float?
  canApprovePreRegistration Boolean    @default(false)
  canCancelSale             Boolean    @default(false)
  employees                 Employee[]
  company                   Company    @relation(fields: [companyId], references: [id])

  @@map("seller_profile")
}

model Category {
  id         String         @id @default(uuid())
  name       String
  kind       CategoryKind   @default(PRODUCT)
  companyId  String?
  isActive   Boolean        @default(true)
  isStandard Boolean        @default(false)
  sectorId   String?
  company    Company?       @relation(fields: [companyId], references: [id])
  sector     CompanySector? @relation(fields: [sectorId], references: [id])
  products   Product[]

  @@map("categories")
}

model Contact {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  name       String
  email      String?
  sector     String?
  clientId   String?
  supplierId String?
  mobile     String?
  phone      String?
  notes      String?
  client     Client?   @relation(fields: [clientId], references: [id])
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@map("contacts")
}

model CreditLimitDefault {
  id                String                        @id @default(uuid())
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime?                     @updatedAt
  type              ClientKind                    @default(PERSON)
  companyId         String
  minValue          Float?
  maxValue          Float?
  company           Company                       @relation(fields: [companyId], references: [id])
  paymentConditions CreditLimitPaymentCondition[]

  @@map("credit_limit_default")
}

model CreditLimitPaymentCondition {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  isActive             Boolean            @default(true)
  creditLimitDefaultId String
  paymentConditionId   String
  creditLimitDefault   CreditLimitDefault @relation(fields: [creditLimitDefaultId], references: [id])
  paymentCondition     PaymentCondition   @relation(fields: [paymentConditionId], references: [id])

  @@unique([creditLimitDefaultId, paymentConditionId])
  @@map("credit_limit_payment_conditions")
}

model Client {
  id                String                   @id @default(uuid())
  name              String
  companyId         String
  status            ClientStatus             @default(PROSPECT)
  email             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime?                @updatedAt
  responsibleId     String?
  birthdate         DateTime?
  financialNotes    String?
  nickname          String?
  notes             String?
  site              String?
  activity          String?
  cnpj              String?
  corporateName     String?
  cpf               String?
  mobile            String?
  phone             String?
  rg                String?
  tradeName         String?
  type              ClientKind               @default(PERSON)
  category          String?
  blockClient       Boolean                  @default(false)
  maxValue          Float?
  minValue          Float?
  supplierId        String?
  planId            String?
  address           Address[]
  paymentConditions ClientPaymentCondition[]
  company           Company                  @relation(fields: [companyId], references: [id])
  Plan              Plan?                    @relation(fields: [planId], references: [id])
  responsible       Employee?                @relation(fields: [responsibleId], references: [id])
  supplier          Supplier?                @relation(fields: [supplierId], references: [id])
  contacts          Contact[]
  payable           Payable[]
  quotation         Quotation[]
  receivable        Receivable[]

  @@map("clients")
}

model Supplier {
  id                String                     @id @default(uuid())
  name              String
  email             String?
  companyId         String
  createdAt         DateTime                   @default(now())
  status            ClientStatus               @default(ACTIVE)
  updatedAt         DateTime?                  @updatedAt
  birthdate         DateTime?
  financialNotes    String?
  nickname          String?
  notes             String?
  site              String?
  activity          String?
  cnpj              String?
  corporateName     String?
  cpf               String?
  mobile            String?
  phone             String?
  rg                String?
  tradeName         String?
  type              ClientKind                 @default(PERSON)
  blockClient       Boolean                    @default(false)
  category          String?
  maxValue          Float?
  minValue          Float?
  address           Address[]
  client            Client[]
  commission        Commission[]
  contacts          Contact[]
  deliveryInfo      DeliveryInfo[]
  payable           Payable[]
  receivable        Receivable[]
  scheduledExpense  ScheduledExpense[]
  paymentConditions SupplierPaymentCondition[]
  company           Company                    @relation(fields: [companyId], references: [id])

  @@map("suppliers")
}

model Employee {
  id              String          @id @default(uuid())
  companyId       String
  roleId          String?
  sectorId        String?
  userId          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime?       @updatedAt
  isActive        Boolean         @default(true)
  sallary         Float?
  sellerProfileId String?
  name            String?
  avatarUrl       String?
  cpf             String?
  mobile          String?
  phone           String?
  rg              String?
  signatureUrl    String?
  address         Address[]
  client          Client[]
  company         Company         @relation(fields: [companyId], references: [id])
  role            Role?           @relation(fields: [roleId], references: [id])
  sector          CompanySector?  @relation(fields: [sectorId], references: [id])
  sellerProfile   SellerProfile?  @relation(fields: [sellerProfileId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])
  quotation       Quotation[]
  SalaryControl   SalaryControl[]
  salarySheet     SalarySheet[]

  @@map("employees")
}

model User {
  id                   String         @id @default(uuid())
  password             String
  email                String         @unique
  name                 String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime?      @updatedAt
  avatar               String?
  isActive             Boolean        @default(true)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  phone                String?
  isVerified           Boolean        @default(false)
  attributes           Attribute[]
  employee             Employee[]
  UserContract         UserContract[]
  userRole             UserRole[]

  @@index([email])
  @@map("users")
}

model MailVerification {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  email     String    @unique
  token     String?
  expiresAt DateTime?
  verified  Boolean   @default(false)

  @@map("mail_verifications")
}

model Asset {
  id                         String         @id @default(uuid())
  name                       String
  companyId                  String?
  costGroupId                Int?
  createdAt                  DateTime       @default(now())
  fixedMonthlyCost           Float?
  purchaseValue              Float
  residualValue              Float
  sectorId                   String?
  typeId                     String?
  updatedAt                  DateTime?      @updatedAt
  usefulLife                 Int
  variableQualityMonthlyCost Float?
  variableTotalMonthlyCost   Float?
  company                    Company?       @relation(fields: [companyId], references: [id])
  sector                     CompanySector? @relation(fields: [sectorId], references: [id])
  type                       AssetType?     @relation(fields: [typeId], references: [id])

  @@map("assets")
}

model AssetType {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  name       String
  details    String?
  isActive   Boolean   @default(true)
  companyId  String?
  isStandard Boolean   @default(false)
  company    Company?  @relation(fields: [companyId], references: [id])
  assets     Asset[]

  @@map("asset_types")
}

model Receivable {
  id                String                  @id @default(uuid())
  status            PaymentStatus           @default(PENDING)
  companyId         String
  createdAt         DateTime                @default(now())
  clientId          String?
  description       String?
  reference         String?
  referenceDate     DateTime
  subCategoryId     String?
  installmentQty    Int?
  totalAmount       Float?
  cancelReason      String?
  natureId          String?
  notes             String?
  totalValue        Float?
  cancelNotes       String?
  changeNotes       String?
  changeReason      String?
  updatedAt         DateTime?               @updatedAt
  quotationId       String?
  supplierId        String?
  mainAdditionalFee Float?
  history           ReceivableHistory[]
  installments      ReceivableInstallment[]
  client            Client?                 @relation(fields: [clientId], references: [id])
  company           Company                 @relation(fields: [companyId], references: [id])
  nature            Nature?                 @relation(fields: [natureId], references: [id])
  quotation         Quotation?              @relation(fields: [quotationId], references: [id])
  subCategory       SubCategory?            @relation(fields: [subCategoryId], references: [id])
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])

  @@map("receivables")
}

model ReceivableInstallment {
  id                   String                 @id @default(uuid())
  receivableId         String
  installmentNumber    Int
  dueDate              DateTime
  amount               Float
  paymentMethodId      String?
  additionalFee        Float?
  status               PaymentStatus          @default(PENDING)
  paidDate             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  bankAccountId        String?
  paidAmount           Float?
  transactionId        String?
  provisionDate        DateTime?
  quotationInstallment QuotationInstallment[]
  bankAccount          BankAccount?           @relation(fields: [bankAccountId], references: [id])
  paymentMethod        PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  receivable           Receivable             @relation(fields: [receivableId], references: [id])
  transactions         Transaction?           @relation(fields: [transactionId], references: [id])

  @@map("receivable_installments")
}

model ReceivableHistory {
  id           String     @id @default(uuid())
  receivableId String
  action       String
  description  String
  timestamp    DateTime   @default(now())
  createdBy    String
  createdAt    DateTime   @default(now())
  receivable   Receivable @relation(fields: [receivableId], references: [id])

  @@map("receivable_history")
}

model Payable {
  id                 String               @id @default(uuid())
  status             PaymentStatus        @default(PENDING)
  companyId          String
  createdAt          DateTime             @default(now())
  description        String?
  reference          String?
  referenceDate      DateTime
  subCategoryId      String?
  installmentQty     Int?
  totalAmount        Float
  cancelReason       String?
  natureId           String?
  supplierId         String?
  notes              String?
  cancelNotes        String?
  changeNotes        String?
  changeReason       String?
  updatedAt          DateTime?            @updatedAt
  quotationId        String?
  clientId           String?
  mainAdditionalFee  Float?
  totalValue         Float?
  scheduledExpenseId String?
  commission         Commission[]
  history            PayableHistory[]
  installments       PayableInstallment[]
  client             Client?              @relation(fields: [clientId], references: [id])
  company            Company              @relation(fields: [companyId], references: [id])
  nature             Nature?              @relation(fields: [natureId], references: [id])
  quotation          Quotation?           @relation(fields: [quotationId], references: [id])
  scheduledExpense   ScheduledExpense?    @relation(fields: [scheduledExpenseId], references: [id])
  subCategory        SubCategory?         @relation(fields: [subCategoryId], references: [id])
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])

  @@map("payables")
}

model PayableInstallment {
  id                   String                 @id @default(uuid())
  payableId            String
  installmentNumber    Int
  dueDate              DateTime
  amount               Float
  paymentMethodId      String?
  additionalFee        Float?
  status               PaymentStatus          @default(PENDING)
  paidDate             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  bankAccountId        String?
  paidAmount           Float?
  transactionId        String?
  provisionDate        DateTime?
  bankAccount          BankAccount?           @relation(fields: [bankAccountId], references: [id])
  payable              Payable                @relation(fields: [payableId], references: [id])
  paymentMethod        PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  transactions         Transaction?           @relation(fields: [transactionId], references: [id])
  quotationInstallment QuotationInstallment[]

  @@map("payable_installments")
}

model PayableHistory {
  id          String   @id @default(uuid())
  payableId   String
  action      String
  description String
  timestamp   DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
  payable     Payable  @relation(fields: [payableId], references: [id])

  @@map("payable_history")
}

model SalarySheet {
  id         String            @id @default(uuid())
  month      Int
  year       Int
  status     SheetStatus       @default(EMPTY)
  companyId  String
  employeeId String
  createdAt  DateTime          @default(now())
  updatedAt  DateTime?         @updatedAt
  movements  PaymentMovement[]
  items      SalaryItem[]
  company    Company           @relation(fields: [companyId], references: [id])
  employee   Employee          @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@map("salary_sheets")
}

model SalaryItem {
  id            String      @id @default(uuid())
  salarySheetId String
  type          ItemType
  description   String?
  amount        Float
  reference     String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  paidAt        DateTime?
  salarySheet   SalarySheet @relation(fields: [salarySheetId], references: [id])

  @@map("salary_items")
}

model SalaryControl {
  id         String    @id @default(uuid())
  reference  String
  amount     Float     @default(0)
  type       ItemType  @default(INCREASE)
  date       DateTime  @default(now())
  companyId  String
  employeeId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  isSet      Boolean   @default(false)
  company    Company   @relation(fields: [companyId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@map("salary_controls")
}

model PaymentMovement {
  id              String              @id @default(uuid())
  salarySheetId   String
  amount          Float
  paidDate        DateTime
  paymentStatus   PaymentSalaryStatus @default(PENDING)
  paymentMethodId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  paymentMethod   PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  salarySheet     SalarySheet         @relation(fields: [salarySheetId], references: [id])

  @@map("payment_movements")
}

model FinancialFlow {
  id          String            @id @default(uuid())
  amount      Float
  type        FinancialFlowType
  description String
  date        DateTime
  companyId   String
  createdAt   DateTime          @default(now())
  company     Company           @relation(fields: [companyId], references: [id])

  @@map("financial_flows")
}

model CashRegister {
  id             String                   @id @default(uuid())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime?                @updatedAt
  status         CashRegisterStatus       @default(OPEN)
  openingDate    DateTime
  closingDate    DateTime?
  openingBalance Float
  totalIncomes   Float                    @default(0)
  totalOutcomes  Float                    @default(0)
  retroactive    Float                    @default(0)
  closingBalance Float?
  companyId      String
  bankAccountId  String
  description    String?
  notes          String?
  cashControls   BankAccountCashControl[]
  bankAccount    BankAccount              @relation(fields: [bankAccountId], references: [id])
  company        Company                  @relation(fields: [companyId], references: [id])
  transactions   Transaction[]

  @@map("cash_registers")
}

model Transaction {
  id                    String                  @id @default(uuid())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime?               @updatedAt
  type                  TransactionType
  amount                Float                   @default(0)
  description           String?
  transactionDate       DateTime                @default(now())
  cashRegisterId        String
  reason                String?
  payableInstallment    PayableInstallment[]
  receivableInstallment ReceivableInstallment[]
  cashRegister          CashRegister            @relation(fields: [cashRegisterId], references: [id])

  @@map("transactions")
}

model ScheduledExpense {
  id            String        @id @default(uuid())
  description   String?
  amount        Float         @default(0)
  companyId     String
  createdAt     DateTime      @default(now())
  categoryId    String?
  dueDay        Int           @default(1)
  recurringType RecurringType @default(MONTHLY)
  subCategoryId String?
  supplierId    String?
  updatedAt     DateTime      @default(now()) @updatedAt
  isActive      Boolean       @default(true)
  payables      Payable[]
  nature        Nature?       @relation(fields: [categoryId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])
  subCategory   SubCategory?  @relation(fields: [subCategoryId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])

  @@map("scheduled_expenses")
}

model Invoice {
  id        String   @id @default(uuid())
  number    String
  date      DateTime
  amount    Float
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([number, companyId])
  @@map("invoices")
}

model UserRole {
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Attribute {
  id     String @id @default(uuid())
  key    String
  value  String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("attributes")
}

model Bank {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime?     @updatedAt
  name      String
  code      String
  details   Json?
  isActive  Boolean       @default(true)
  icon      String?
  accounts  BankAccount[]

  @@map("banks")
}

model BankAccount {
  id                     String                   @id @default(uuid())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime?                @updatedAt
  name                   String
  description            String?
  isActive               Boolean                  @default(true)
  companyId              String
  bankId                 String
  cashControl            Boolean                  @default(false)
  bankAccountCashControl BankAccountCashControl[]
  bank                   Bank                     @relation(fields: [bankId], references: [id])
  company                Company                  @relation(fields: [companyId], references: [id])
  cashRegister           CashRegister[]
  PayableInstallment     PayableInstallment[]
  ReceivableInstallment  ReceivableInstallment[]

  @@map("bank_accounts")
}

model BankAccountCashControl {
  id                          String                     @id @default(uuid())
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime?                  @updatedAt
  acceptPayments              Boolean                    @default(true)
  paymentType                 BankAccountCashControlType @default(PAYSOFF)
  acceptIncomes               Boolean                    @default(true)
  incomeType                  BankAccountCashControlType @default(PAYSOFF)
  paymentMethodId             String
  bankAccountId               String
  cashRegisterId              String?
  acceptMultipleCashRegisters Boolean                    @default(false)
  bankAccount                 BankAccount                @relation(fields: [bankAccountId], references: [id])
  cashRegister                CashRegister?              @relation(fields: [cashRegisterId], references: [id])
  paymentMethod               PaymentMethod              @relation(fields: [paymentMethodId], references: [id])

  @@map("bank_account_cash_controls")
}

model PaymentMethod {
  id                     String                   @id @default(uuid())
  name                   String
  description            String?
  companyId              String
  createdAt              DateTime                 @default(now())
  isActive               Boolean                  @default(true)
  bankAccountCashControl BankAccountCashControl[]
  payableInstallment     PayableInstallment[]
  paymentCondition       PaymentCondition[]
  paymentConfigurations  PaymentConfiguration[]
  company                Company                  @relation(fields: [companyId], references: [id])
  paymentMovement        PaymentMovement[]
  quotationInstallment   QuotationInstallment[]
  quotationPayment       QuotationPayment[]
  receivableInstallment  ReceivableInstallment[]

  @@map("payment_methods")
}

model PaymentCondition {
  id                          String                        @id @default(uuid())
  name                        String
  acceptInstallments          Boolean                       @default(false)
  costType                    PaymentConditionCostType
  companyId                   String
  createdAt                   DateTime                      @default(now())
  isActive                    Boolean                       @default(true)
  maxInstallments             Int?
  minInstallments             Int?
  paymentMethodId             String
  dayInterval                 Int?
  receivingType               String?
  clients                     ClientPaymentCondition[]
  CreditLimitPaymentCondition CreditLimitPaymentCondition[]
  installments                Installment[]
  company                     Company                       @relation(fields: [companyId], references: [id])
  paymentMethod               PaymentMethod                 @relation(fields: [paymentMethodId], references: [id])
  paymentConfigurations       PaymentConfiguration[]
  downPaymentConditions       QuotationPayment[]            @relation("downPaymentRelation")
  quotationPayments           QuotationPayment[]            @relation("defaultRelation")
  suppliers                   SupplierPaymentCondition[]

  @@map("payment_conditions")
}

model Installment {
  id                  String           @id @default(uuid())
  installment         Int
  operatorFeeRate     Float            @default(0)
  operatorFeeTransfer Float            @default(0)
  paymentConditionId  String
  dueDate             DateTime?
  paymentCondition    PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@map("installments")
}

model PaymentConfiguration {
  id                 String           @id @default(uuid())
  paymentMethodId    String
  paymentConditionId String
  companyId          String
  createdAt          DateTime         @default(now())
  company            Company          @relation(fields: [companyId], references: [id])
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])
  paymentMethod      PaymentMethod    @relation(fields: [paymentMethodId], references: [id])

  @@map("payment_configurations")
}

model SaleSeries {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime?            @updatedAt
  code                String
  isActive            Boolean              @default(true)
  companyId           String
  currentBudgetNumber Int                  @default(0)
  deliveryDeadline    Int?
  description         String?
  proposalValidity    Int?
  textAfterItems      String?
  textBeforeItems     String?
  title               String
  billing             BiilingKind          @default(ON_ORDER)
  productionStatus    ProductionStatusKind @default(MANAGE_PRODUCTION)
  sendToProduction    SendToProductionKind @default(DIRECT)
  isTraining          Boolean              @default(false)
  quotation           Quotation[]
  company             Company              @relation(fields: [companyId], references: [id])

  @@unique([code, companyId])
  @@map("sale_series")
}

model StatusQuotation {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt
  isActive  Boolean     @default(true)
  title     String
  color     String
  companyId String
  quotation Quotation[]
  company   Company     @relation(fields: [companyId], references: [id])

  @@map("status_quotation")
}

model Quotation {
  id               String             @id @default(uuid())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime?          @updatedAt
  description      String?
  isActive         Boolean            @default(true)
  sellerId         String
  seriesId         String?
  clientId         String?
  companyId        String
  status           QuotationStatus    @default(OPEN)
  totalValue       Float              @default(0)
  dueDate          DateTime           @default(now())
  approvedAt       DateTime?
  contactType      String?
  tagId            String?
  quickSale        Boolean            @default(false)
  quotationNumber  Int?
  finishedAt       DateTime?
  reasonId         String?
  subCompanyId     String?
  deliveryInfo     DeliveryInfo?
  DeliverySchedule DeliverySchedule?
  order            Order?
  payable          Payable[]
  quotationPayment QuotationPayment?
  quotationProduct QuotationProduct[]
  client           Client?            @relation(fields: [clientId], references: [id])
  company          Company            @relation("MainCompany", fields: [companyId], references: [id])
  reasons          Reasons?           @relation(fields: [reasonId], references: [id])
  seller           Employee           @relation(fields: [sellerId], references: [id])
  series           SaleSeries?        @relation(fields: [seriesId], references: [id])
  subCompany       Company?           @relation("FiscalSubCompany", fields: [subCompanyId], references: [id])
  tag              StatusQuotation?   @relation(fields: [tagId], references: [id])
  receivable       Receivable[]
  products         Product[]          @relation("QuotationToProduct")

  @@index([id, companyId])
  @@map("quotations")
}

model QuotationProduct {
  quotationId          String
  productId            String
  quantity             Int                    @default(1)
  totalValue           Float?
  description          String?
  allowEditDescription Boolean                @default(true)
  allowEditValues      Boolean                @default(true)
  imageUrl             String?
  technicalDescription String?
  notes                String?
  id                   String                 @id @default(uuid())
  discount             Float?
  discountType         String?
  finalValue           Float?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  items                QuotationProductItem[]
  product              Product                @relation(fields: [productId], references: [id])
  quotation            Quotation              @relation(fields: [quotationId], references: [id])

  @@map("quotation_products")
}

model QuotationProductItem {
  productItemId      String
  quantity           Int                  @default(1)
  productId          String
  quotationId        String
  totalValue         Float?
  distance           Float?
  duration           Float?
  height             Float?
  length             Float?
  name               String
  salePrice          Float?
  unitCost           Float?
  unitOfMeasureId    String
  volume             Float?
  weight             Float?
  width              Float?
  id                 String               @id @default(uuid())
  quotationProductId String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime?            @updatedAt
  originalQuantity   Int                  @default(1)
  productItem        ProductItem          @relation(fields: [productItemId], references: [id])
  quotationProduct   QuotationProduct     @relation(fields: [quotationProductId], references: [id])
  unitOfMeasure      CompanyUnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])

  @@map("quotation_product_items")
}

model QuotationPayment {
  id                       String                 @id @default(uuid())
  quotationId              String                 @unique
  downPayment              Float                  @default(0)
  paymentMethodId          String?
  paymentConditionId       String?
  commissionId             String?                @unique
  totalValue               Float
  description              String?
  finalValue               Float?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime?              @updatedAt
  discountType             String                 @default("VALUE")
  type                     InvoiceType            @default(OTHER)
  billing                  BiilingKind            @default(ON_ORDER)
  downPaymentConditionId   String?
  downPaymentDueDate       DateTime?
  downPaymentAdditionalFee Float                  @default(0)
  additionalFeeType        String?
  installmentQty           Int?
  mainAdditionalFee        Float?
  maxInstallmentQty        Int?
  minInstallmentQty        Int?
  discountTotal            Float                  @default(0)
  discountValue            Float                  @default(0)
  quotationInstallment     QuotationInstallment[]
  commission               Commission?            @relation(fields: [commissionId], references: [id])
  downPaymentCondition     PaymentCondition?      @relation("downPaymentRelation", fields: [downPaymentConditionId], references: [id])
  paymentCondition         PaymentCondition?      @relation("defaultRelation", fields: [paymentConditionId], references: [id])
  paymentMethod            PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  quotation                Quotation              @relation(fields: [quotationId], references: [id])

  @@map("quotation_payments")
}

model Commission {
  id               String                   @id @default(uuid())
  type             CommissionType           @default(ADD)
  transferMethod   transferMethodCommission @default(SINGLE)
  commissionValue  Float                    @default(0)
  totalCommission  Float                    @default(0)
  supplierId       String
  commissionType   String                   @default("VALUE")
  receivableId     String?
  payableId        String?
  payable          Payable?                 @relation(fields: [payableId], references: [id])
  supplier         Supplier                 @relation(fields: [supplierId], references: [id])
  quotationPayment QuotationPayment?

  @@map("commissions")
}

model QuotationInstallment {
  id                      String                 @id @default(uuid())
  quotationPaymentId      String
  dueDate                 DateTime
  paymentMethodId         String
  value                   Float
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  payableInstallmentId    String?
  receivableInstallmentId String?
  additionalFee           Float                  @default(0)
  payableInstallment      PayableInstallment?    @relation(fields: [payableInstallmentId], references: [id])
  paymentMethod           PaymentMethod          @relation(fields: [paymentMethodId], references: [id])
  quotationPayment        QuotationPayment       @relation(fields: [quotationPaymentId], references: [id])
  receivableInstallment   ReceivableInstallment? @relation(fields: [receivableInstallmentId], references: [id])

  @@map("quotation_installments")
}

model DeliveryInfo {
  id                String            @id @default(uuid())
  quotationId       String            @unique
  daysAfterApproval Int?
  estimatedDate     DateTime?
  modality          String            @default("Indefinida")
  cost              Float?
  value             Float?
  notes             String?
  supplierId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime?         @updatedAt
  deliveryType      DeliveryType      @default(PICKUP)
  quotation         Quotation         @relation(fields: [quotationId], references: [id])
  supplier          Supplier?         @relation(fields: [supplierId], references: [id])
  deliverySchedule  DeliverySchedule?

  @@index([quotationId])
  @@map("delivery_info")
}

model Order {
  id               String            @id @default(uuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt
  quotationId      String            @unique
  status           OrderStatus       @default(IN_PRODUCTION)
  isActive         Boolean           @default(true)
  canceledAt       DateTime?
  deliveredAt      DateTime?
  reasonId         String?
  deliverySchedule DeliverySchedule?
  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  cancelReason     Reasons?          @relation(fields: [reasonId], references: [id])

  @@index([id])
  @@map("orders")
}

model Product {
  id                   String             @id @default(uuid())
  name                 String
  companyId            String?
  categoryId           String
  isActive             Boolean            @default(true)
  isStandard           Boolean            @default(false)
  code                 String
  sectorId             String
  allowEditDescription Boolean            @default(true)
  allowEditValues      Boolean            @default(true)
  imageUrl             String?
  technicalDescription String?
  productionStages     Json?
  status               ProductStatus      @default(ACTIVE)
  items                ProductItem[]
  category             Category           @relation(fields: [categoryId], references: [id])
  company              Company?           @relation(fields: [companyId], references: [id])
  sector               CompanySector      @relation(fields: [sectorId], references: [id])
  quotationProduct     QuotationProduct[]
  quotations           Quotation[]        @relation("QuotationToProduct")

  @@unique([code, companyId])
  @@map("products")
}

model ProductItem {
  id                   String                 @id @default(uuid())
  name                 String
  productId            String
  unitOfMeasureId      String
  unitCost             Float?
  salePrice            Float?
  distance             Float?
  duration             Float?
  height               Float?
  length               Float?
  volume               Float?
  weight               Float?
  width                Float?
  product              Product                @relation(fields: [productId], references: [id])
  unitOfMeasure        CompanyUnitOfMeasure   @relation(fields: [unitOfMeasureId], references: [id])
  quotationProductItem QuotationProductItem[]

  @@map("product_items")
}

model CompanyUnitOfMeasure {
  id                     String                 @id @default(uuid())
  name                   String
  code                   String
  description            String?
  isActive               Boolean                @default(true)
  companyId              String
  defaultUnitOfMeasureId String?
  kind                   UnitOfMeasureKind?
