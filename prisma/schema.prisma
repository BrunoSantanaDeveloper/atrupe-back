  @@map("contracts")
}

enum ContractorType {
  PF
  PJ
}

/// O aceite do contrato na contratação: quem contratou, em nome de quem, e
/// quem respondeu legalmente pela empresa.
///
/// UserContract registra só "este usuário aceitou esta versão", e o índice
/// único (usuário, versão) impede registrar o aceite de novo numa evolução ou
/// regularização — que a regra exige. Este registro é por contratação.
///
/// Sem chave estrangeira para usuário nem empresa, de propósito: é registro
/// jurídico, e excluir um usuário ou uma conta não pode apagá-lo nem ser
/// bloqueado por ele. Por isso nomes e documentos ficam desnormalizados aqui.
model ContractAcceptance {
  id                          String         @id @default(uuid())
  createdAt                   DateTime       @default(now())
  contractId                  String
  contractVersion             Int
  companyId                   String
  subscriptionId              String?
  context                     String // NEW_CONTRACT | REGULARIZATION | EVOLUTION | COMPLEMENTS | OWNERSHIP_TRANSFER
  acceptedByUserId            String
  acceptedByName              String
  acceptedByEmail             String
  contractorType              ContractorType
  contractorDocument          String
  contractorName              String
  contractorTradeName         String?
  contractorEmail             String
  representativeCpf           String?
  representativeName          String?
  representativeVerified      Boolean?
  representativeIsSessionUser Boolean        @default(false)
  /// O Administrador Principal da Conta (Usuário nº 1) indicado pela
  /// contratante no aceite (contrato 1.1, 1.5 e 4.1).
  principalAdminUserId        String?
  principalAdminName          String?
  principalAdminEmail         String?
  registrySnapshot            Json?
  termsSha256                 String?
  ipAddress                   String?
  userAgent                   String?
  contract                    Contract       @relation(fields: [contractId], references: [id])

  @@index([companyId, createdAt])
  @@index([subscriptionId])
  @@map("contract_acceptances")
}

/// Transferência de titularidade: o titular convida um e-mail, e quem recebe
/// cria uma conta nova, informa a empresa e aceita os Termos. A expiração (14
/// dias) é derivada de createdAt, não gravada: uma pendente vencida já é
/// expirada, mesmo que ninguém tenha aberto a tela.
model OwnershipTransfer {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
  companyId        String
  /// O nome do ambiente no envio: é o que o convite e o aviso a quem saiu citam.
  companyName      String
  fromUserId       String
  fromUserName     String
  targetEmail      String
  /// SHA-256 do token do convite: o token em si nunca é guardado.
  tokenHash        String    @unique
  status           String    @default("PENDING") // PENDING | CANCELED | ACCEPTED
  canceledAt       DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?
  previousCnpj     String?
  newCnpj          String?

  @@index([companyId, status])
  @@map("ownership_transfers")
}

/// Quem respondeu pela conta, de quando a quando. O período aberto (endedAt
/// nulo) é o titular atual; uma transferência fecha um e abre outro na mesma
/// data.
model OwnershipPeriod {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  companyId  String
  userId     String?
  holderName String
  document   String?
  email      String?
  startedAt  DateTime
  endedAt    DateTime?
  transferId String?

  @@index([companyId, endedAt])
  @@map("ownership_periods")
}

