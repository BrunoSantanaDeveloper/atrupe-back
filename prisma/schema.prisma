// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name                  String
  legalName             String?
  cnpj                  String?
  stateRegistration     String?
  municipalRegistration String?
  phoneNumber           String?
  website               String?
  isActive              Boolean @default(true)

  sectors      Sector[]
  clients      Client[]
  employees    Employee[]
  products     Product[]
  assets       Asset[]
  roles        Role[]
  suppliers    Supplier[]
  bankAccounts BankAccount[]
  assetTypes   AssetType[]
  categories   Category[]
  saleSeries   SaleSeries[]
  quotation    Quotation[]

  payables          Payable[]
  receivables       Receivable[]
  financialFlows    FinancialFlow[]
  cashControls      CashRegister[]
  scheduledExpenses ScheduledExpense[]
  invoices          Invoice[]

  paymentMethods        PaymentMethod[]
  paymentConditions     PaymentCondition[]
  paymentConfigurations PaymentConfiguration[]
  unitOfMeasure         UnitOfMeasure[]
  language              Language[]
  Reasons               Reasons[]
  StatusQuotation       StatusQuotation[]
  SellerProfile         SellerProfile[]
  SalarySheet           SalarySheet[]
  DeliveryType          DeliveryType[]

  @@map("companies")
}

enum OwnerType {
  COMPANY
  EMPLOYEE
  CLIENT
  SUPPLIER
  CONTACT
}

model Address {
  id           String  @id @default(uuid())
  street       String?
  number       String?
  neighborhood String?
  country      String?
  zipcode      String?
  complement   String?

  cityId String?
  city   City?   @relation(fields: [cityId], references: [id])

  stateId String?
  state   State?  @relation(fields: [stateId], references: [id])

  ownerType OwnerType @default(COMPANY)
  ownerId   String

  client   Client[]
  Supplier Supplier[]

  @@index([ownerId, ownerType])
  @@map("addresses")
}

enum SectorKind {
  ADMINISTRATIVE
  OPERATIONAL
  FINANCIAL
  COMMERCIAL
  MARKETING
  IT
  HUMAN_RESOURCES
  LEGAL
  PRODUCTION
  LOGISTICS
  QUALITY
  SECURITY
  MAINTENANCE
  CLEANING
  OTHER
}

model Sector {
  id       String     @id @default(uuid())
  name     String
  icon     String?
  isActive Boolean    @default(true)
  kind     SectorKind @default(PRODUCTION)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  employees Employee[]
  asset     Asset[]
  Role      Role[]
  Product   Product[]

  @@map("sectors")
}

model Role {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  employees Employee[]

  userRole   UserRole[]
  rolePolicy RolePolicy[]

  @@map("roles")
}

model SellerProfile {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  employees Employee[]

  commission                Float?
  maxDiscount               Float?
  minValue                  Float?
  canApprovePreRegistration Boolean @default(false)
  canCancelSale             Boolean @default(false)

  @@unique([name, companyId])
  @@map("seller_profile")
}

enum CategoryKind {
  PRODUCT
  SERVICE
  CLIENT
  SUPPLIER
  PAYABLE
  PAYABLE_ORIGIN
  RECEIVABLE
  RECEIVABLE_ORIGIN
}

model Category {
  id         String       @id @default(uuid())
  name       String
  kind       CategoryKind @default(PRODUCT)
  isActive   Boolean      @default(true)
  isStandard Boolean      @default(false)
  companyId  String?
  parentId   String?

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  company   Company?   @relation(fields: [companyId], references: [id])
  clients   Client[]
  products  Product[]
  suppliers Supplier[]

  payableCategory    Payable[] @relation("CategoryPayable")
  payableSubCategory Payable[] @relation("SubCategoryPayable")

  receivableCategory    Receivable[] @relation("CategoryReceivable")
  receivableSubCategory Receivable[] @relation("SubCategoryReceivable")

  @@map("categories")
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientKind {
  PERSON
  COMPANY
}

model Contact {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name   String
  email  String? @unique
  phone  String?
  mobile String?
  sector String?

  observations String?

  client     Client?   @relation(fields: [clientId], references: [id])
  clientId   String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId String?

  @@map("contacts")
}

model Client {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  type   ClientKind   @default(PERSON)
  status ClientStatus @default(PROSPECT)

  name   String
  email  String?
  phone  String?
  mobile String?

  rg            String?
  cpf           String?
  cnpj          String?
  activity      String?
  tradeName     String?
  corporateName String?

  notes          String?
  financialNotes String?
  nickname       String?
  site           String?
  birthdate      DateTime?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  contacts      Contact[]
  responsibleId String?
  responsible   Employee?    @relation(fields: [responsibleId], references: [id])
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  category      Category?    @relation(fields: [categoryId], references: [id])
  categoryId    String?
  quotation     Quotation[]
  Receivable    Receivable[]
  Payable       Payable[]

  @@unique([email, companyId])
  @@map("clients")
}

model Supplier {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  type   ClientKind   @default(PERSON)
  status ClientStatus @default(ACTIVE)

  name   String
  email  String?
  phone  String?
  mobile String?

  rg            String?
  cpf           String?
  cnpj          String?
  activity      String?
  tradeName     String?
  corporateName String?

  notes          String?
  financialNotes String?
  nickname       String?
  site           String?
  birthdate      DateTime?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id])

  contacts     Contact[]
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  category     Category?      @relation(fields: [categoryId], references: [id])
  categoryId   String?
  DeliveryInfo DeliveryInfo[]
  Commission   Commission[]

  @@unique([email, companyId])
  @@map("suppliers")
}

model Employee {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  isActive  Boolean   @default(true)

  sallary Float?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  userId String @unique
  user   User?  @relation(fields: [userId], references: [id])

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  client          Client[]
  quotation       Quotation[]
  sellerProfileId String?
  SellerProfile   SellerProfile? @relation(fields: [sellerProfileId], references: [id])
  SalarySheet     SalarySheet[]

  @@map("employees")
}

model User {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  employee Employee?
  name     String
  password String
  email    String    @unique
  avatar   String?

  attributes Attribute[]
  userRole   UserRole[]

  @@index([email])
  @@map("users")
}

model Asset {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name                       String
  purchaseValue              Float
  residualValue              Float
  usefulLife                 Int
  costGroupId                Int?
  fixedMonthlyCost           Float?
  variableTotalMonthlyCost   Float?
  variableQualityMonthlyCost Float?
  companyId                  String?
  typeId                     String?
  sectorId                   String?

  // costGroup        CostGroup?       @relation(fields: [costGroupId], references: [id])
  // costs            Cost[]
  company Company?   @relation(fields: [companyId], references: [id])
  type    AssetType? @relation(fields: [typeId], references: [id])
  sector  Sector?    @relation(fields: [sectorId], references: [id])

  @@map("assets")
}

model AssetType {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name       String
  details    String?
  isActive   Boolean @default(true)
  isStandard Boolean @default(false)
  companyId  String?

  company Company? @relation(fields: [companyId], references: [id])
  assets  Asset[]

  @@map("asset_types")
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELED
}

model Receivable {
  id String @id @default(uuid())

  reference     String
  referenceDate DateTime
  dueDate       DateTime

  description  String?
  observations String?

  natureId String?
  nature   Nature? @relation(fields: [natureId], references: [id])

  status         PaymentStatus           @default(PENDING)
  totalAmount    Float // Valor total da movimentação
  installmentQty Int? // Número de parcelas
  installments   ReceivableInstallment[] // Relacionamento com parcelas
  history        ReceivableHistory[] // Relacionamento com histórico
  cancelReason   String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  categoryId String
  category   Category @relation("CategoryReceivable", fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   Category? @relation("SubCategoryReceivable", fields: [subCategoryId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  @@map("receivables")
}

model ReceivableInstallment {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id])

  installmentNumber Int // Número da parcela (1, 2, 3, ...)
  dueDate           DateTime // Data de vencimento da parcela
  amount            Float // Valor da parcela
  paymentMethodId   String // Forma de pagamento específica da parcela
  paymentMethod     PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  additionalFee     Float? // Acréscimos (opcional)
  status            PaymentStatus @default(PENDING) // Status da parcela (PENDENTE, PAGO, CANCELADO)
  paidDate          DateTime? // Data de pagamento (se pago)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("receivable_installments")
}

model ReceivableHistory {
  id           String     @id @default(uuid())
  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id])

  action      String // Ação realizada (e.g., "PARCELA ALTERADA", "PAGAMENTO REALIZADO")
  description String // Descrição detalhada da alteração
  timestamp   DateTime @default(now()) // Data/hora do evento

  createdBy String // Quem realizou a ação (pode ser um ID de usuário)
  createdAt DateTime @default(now())

  @@map("receivable_history")
}

model Payable {
  id String @id @default(uuid())

  reference     String
  referenceDate DateTime
  dueDate       DateTime

  description  String?
  observations String?

  natureId String?
  nature   Nature? @relation(fields: [natureId], references: [id])

  status         PaymentStatus        @default(PENDING)
  totalAmount    Float // Valor total da movimentação
  installmentQty Int? // Número de parcelas
  installments   PayableInstallment[] // Relacionamento com parcelas
  history        PayableHistory[] // Relacionamento com histórico
  cancelReason   String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  categoryId String
  category   Category @relation("CategoryPayable", fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   Category? @relation("SubCategoryPayable", fields: [subCategoryId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())

  @@map("payables")
}

model PayableInstallment {
  id        String  @id @default(uuid())
  payableId String
  payable   Payable @relation(fields: [payableId], references: [id])

  installmentNumber Int // Número da parcela (1, 2, 3, ...)
  dueDate           DateTime // Data de vencimento da parcela
  amount            Float // Valor da parcela
  paymentMethodId   String // Forma de pagamento específica da parcela
  paymentMethod     PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  additionalFee     Float? // Acréscimos (opcional)
  status            PaymentStatus @default(PENDING) // Status da parcela (PENDENTE, PAGO, CANCELADO)
  paidDate          DateTime? // Data de pagamento (se pago)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payable_installments")
}

model PayableHistory {
  id        String  @id @default(uuid())
  payableId String
  payable   Payable @relation(fields: [payableId], references: [id])

  action      String // Ação realizada (e.g., "PARCELA ALTERADA", "PAGAMENTO REALIZADO")
  description String // Descrição detalhada da alteração
  timestamp   DateTime @default(now()) // Data/hora do evento

  createdBy String // Quem realizou a ação (pode ser um ID de usuário)
  createdAt DateTime @default(now())

  @@map("payable_history")
}

enum FinancialFlowType {
  INCOME
  EXPENSE
}

model SalarySheet {
  id     String      @id @default(uuid()) // ID da folha de pagamento
  month  Int // Mês de referência (0 a 11)
  year   Int // Ano de referência
  status SheetStatus @default(EMPTY) // Status da folha (aberta ou fechada)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  employeeId String // Relacionamento com o funcionário
  employee   Employee @relation(fields: [employeeId], references: [id])

  items     SalaryItem[] // Relacionamento com os itens da folha (acréscimos, descontos)
  movements PaymentMovement[] // Relacionamento com as movimentações de pagamento (contas a pagar)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([employeeId, month, year])
}

enum SheetStatus {
  EMPTY //Sem Lançamento
  OPEN // Folha aberta
  CLOSED // Folha fechada
}

model SalaryItem {
  id            String      @id @default(uuid()) // ID do item
  salarySheetId String // Relacionamento com a folha de pagamento
  salarySheet   SalarySheet @relation(fields: [salarySheetId], references: [id])

  type        ItemType // Tipo do item (Acréscimo, Desconto, Adiantamento)
  description String // Descrição do item (ex: Salário Base, Bonus, etc.)
  amount      Float // Valor do item
  reference   String // Referência do item (ex: mês de referência)

  createdAt DateTime @default(now()) // Data de criação
  updatedAt DateTime @updatedAt // Data de atualização
}

enum ItemType {
  INCREASE // Acréscimo
  DISCOUNT // Desconto
  ADVANCE // Adiantamento
}

model PaymentMovement {
  id            String      @id @default(uuid()) // ID da movimentação de pagamento
  salarySheetId String // Relacionamento com a folha de pagamento
  salarySheet   SalarySheet @relation(fields: [salarySheetId], references: [id])

  amount          Float // Valor pago
  paidDate        DateTime // Data do pagamento
  paymentStatus   PaymentSalaryStatus @default(PENDING) // Status do pagamento (PENDENTE, PAGO)
  paymentMethodId String // Forma de pagamento (referência à tabela de PaymentMethod)
  paymentMethod   PaymentMethod       @relation(fields: [paymentMethodId], references: [id])

  createdAt DateTime @default(now()) // Data de criação
  updatedAt DateTime @updatedAt // Data de atualização
}

enum PaymentSalaryStatus {
  PENDING // Pago ou pendente
  PAID // Pago
}

model FinancialFlow {
  id          String            @id @default(uuid())
  amount      Float
  type        FinancialFlowType
  description String
  date        DateTime
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  createdAt   DateTime          @default(now())

  @@map("financial_flows")
}

model CashRegister {
  id          String             @id @default(uuid())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime?          @updatedAt
  description String?
  status      CashRegisterStatus @default(OPEN)
  observation String?

  openingDate    DateTime
  closingDate    DateTime?
  openingBalance Float
  totalIncomes   Float     @default(0)
  totalOutcomes  Float     @default(0)
  retroactive    Float     @default(0) // Diferença acumulada de reaberturas
  closingBalance Float? // Calculado apenas ao fechar

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  cashControls BankAccountCashControl[]

  transactions Transaction[]

  @@map("cash_registers")
}

model Transaction {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  type            TransactionType
  amount          Float
  description     String?
  transactionDate DateTime        @default(now())
  reason          String? // Motivo para edição ou transferência

  cashRegisterId String
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  INCOME
  OUTCOME
  TRANSFER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model ScheduledExpense {
  id          String   @id @default(uuid())
  description String
  amount      Float
  dueDate     DateTime
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())

  @@map("scheduled_expenses")
}

model Invoice {
  id        String   @id @default(uuid())
  number    String
  date      DateTime
  amount    Float
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@unique([number, companyId])
  @@map("invoices")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Attribute {
  id     String @id @default(uuid())
  key    String
  value  String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("attributes")
}

model RolePolicy {
  roleId   String
  policyId String
  role     Role   @relation(fields: [roleId], references: [id])
  policy   Policy @relation(fields: [policyId], references: [id])

  @@id([roleId, policyId])
  @@map("role_policies")
}

model Policy {
  id         String       @id @default(uuid())
  name       String
  definition Json
  rolePolicy RolePolicy[]

  @@map("policies")
}

model Bank {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name     String
  code     String
  details  Json?
  isActive Boolean @default(true)

  accounts BankAccount[]

  @@map("banks")
}

model BankAccount {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name        String
  description String?
  isActive    Boolean @default(true)

  cashControl Boolean @default(false)

  bankAccountCashControl BankAccountCashControl[]

  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])
  bankId       String
  bank         Bank           @relation(fields: [bankId], references: [id])
  Receivable   Receivable[]
  Payable      Payable[]
  CashRegister CashRegister[]

  @@map("bank_accounts")
}

enum BankAccountCashControlType {
  PAYSOFF
  PROVISION
}

model BankAccountCashControl {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  acceptPayments Boolean                    @default(true)
  paymentType    BankAccountCashControlType @default(PAYSOFF)
  acceptIncomes  Boolean                    @default(true)
  incomeType     BankAccountCashControlType @default(PAYSOFF)

  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  @@map("bank_account_cash_controls")
}

model PaymentMethod {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  isActive    Boolean  @default(true)

  companyId              String
  company                Company                  @relation(fields: [companyId], references: [id])
  paymentConfigurations  PaymentConfiguration[]
  bankAccountCashControl BankAccountCashControl[]
  Receivable             Receivable[]
  Payable                Payable[]
  PaymentCondition       PaymentCondition[]
  ReceivableInstallment  ReceivableInstallment[]
  PayableInstallment     PayableInstallment[]
  PaymentMovement        PaymentMovement[]
  QuotationPayment       QuotationPayment[]
  QuotationInstallment   QuotationInstallment[]

  @@map("payment_methods")
}

enum PaymentConditionCostType {
  PERCENT
  FIXED
}

model PaymentCondition {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  name               String
  acceptInstallments Boolean                  @default(false)
  costType           PaymentConditionCostType

  minInstallments Int?
  maxInstallments Int?
  installments    Installment[]

  receivingType String?
  dayInterval   Int?

  paymentMethodId       String
  paymentMethod         PaymentMethod          @relation(fields: [paymentMethodId], references: [id])
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  paymentConfigurations PaymentConfiguration[]
  QuotationPayment      QuotationPayment[]

  @@map("payment_conditions")
}

model Installment {
  id                  String            @id @default(uuid())
  installment         Int // Número da parcela
  operatorFeeRate     Float
  operatorFeeTransfer Float
  paymentConditionId  String
  paymentCondition    PaymentCondition  @relation(fields: [paymentConditionId], references: [id])
  QuotationPayment    QuotationPayment? @relation(fields: [quotationPaymentId], references: [id])
  quotationPaymentId  String?

  @@map("installments")
}

model PaymentConfiguration {
  id                 String           @id @default(uuid())
  paymentMethodId    String
  paymentMethod      PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])
  companyId          String
  company            Company          @relation(fields: [companyId], references: [id])
  createdAt          DateTime         @default(now())

  @@map("payment_configurations")
}

model SaleSeries {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  isActive  Boolean   @default(true)

  code                String
  description         String?
  title               String
  currentBudgetNumber Int     @default(1)
  proposalValidity    Int?
  deliveryDeadline    Int?

  billing          String?
  sendToProduction String?
  productionStatus String?

  textBeforeItems String?
  textAfterItems  String?

  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  Quotation Quotation[]

  @@unique([code, companyId])
  @@map("sale_series")
}

enum QuotationStatus {
  APPROVED //Aprovado
  OPEN //Digitação
  DONE //Aguardando
  CLOSED
  CANCELED
  REJECTED //Rejeitado
  OVERDUE //Vencido
}

model StatusQuotation {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt
  isActive  Boolean     @default(true)
  title     String
  color     String // Cor no formato hexadecimal, ex: "#FF5733"
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  Quotation Quotation[]

  @@map("status_quotation")
}

model Quotation {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
  approvedAt      DateTime?
  isActive        Boolean   @default(true)
  quotationNumber Int?

  description String?
  status      QuotationStatus @default(OPEN)
  dueDate     DateTime        @default(now())
  contactType String?

  totalValue Float @default(0)

  sellerId  String
  seriesId  String?
  clientId  String?
  companyId String
  tagId     String?
  quickSale Boolean @default(false)

  seller  Employee         @relation(fields: [sellerId], references: [id])
  series  SaleSeries?      @relation(fields: [seriesId], references: [id])
  client  Client?          @relation(fields: [clientId], references: [id])
  company Company          @relation(fields: [companyId], references: [id])
  tag     StatusQuotation? @relation(fields: [tagId], references: [id])

  products         Product[]          @relation("QuotationToProduct")
  quotationProduct QuotationProduct[]
  order            Order[]
  deliveryInfo     DeliveryInfo?
  quotationPayment QuotationPayment?

  @@index([id, companyId])
  @@map("quotations")
}

model QuotationProduct {
  id          String    @id @default(uuid())
  quotation   Quotation @relation(fields: [quotationId], references: [id])
  quotationId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  quantity             Int     @default(1)
  description          String?
  technicalDescription String?
  imageUrl             String?
  totalValue           Float?
  notes                String?
  discount             Float?
  discountType         String?
  finalValue           Float?

  items                QuotationProductItem[]
  allowEditDescription Boolean                @default(true)
  allowEditValues      Boolean                @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("quotation_products")
}

model QuotationProductItem {
  id                 String           @id @default(uuid())
  quotationId        String
  productId          String
  quotationProductId String
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id])

  productItemId String
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  name            String
  quantity        Int           @default(1)
  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  width           Float? //largura
  height          Float? //altura
  length          Float? //comprimento
  weight          Float? //peso
  volume          Float? //volume
  distance        Float? //distancia
  duration        Float? //duração (em dias)

  unitCost  Float?
  salePrice Float?

  totalValue Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@map("quotation_product_items")
}

model QuotationPayment {
  id                   String                 @id @default(uuid())
  quotationId          String                 @unique
  quotation            Quotation              @relation(fields: [quotationId], references: [id])
  // typeId               String? // Nota Fiscal
  // type                 Invoice?               @relation(fields: [invoiceId], references: [id]) // Relacionamento com Nota Fiscal
  billing              String? // Faturamento (vem da configuração da série)
  discount             Float                  @default(0) // Desconto
  downPayment          Float                  @default(0) // Entrada
  paymentMethodId      String? // Relação com a tabela de métodos de pagamento
  paymentCondition     PaymentCondition?      @relation(fields: [paymentConditionId], references: [id])
  paymentMethod        PaymentMethod?         @relation(fields: [paymentMethodId], references: [id])
  paymentConditionId   String? // Relação com a tabela de condições de pagamento
  commissionId         String?                @unique
  commission           Commission?            @relation(fields: [commissionId], references: [id])
  totalValue           Float // Valor total do orçamento
  description          String? // Observações
  finalValue           Float?
  installments         Installment[] // Parcelas geradas para pagamento parcelado
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  QuotationInstallment QuotationInstallment[]
}

model Commission {
  id               String                   @id @default(uuid())
  type             CommissionType           @default(ADD)
  transferMethod   transferMethodCommission @default(SINGLE)
  commissionValue  Float?
  totalCommission  Float?
  supplierId       String
  supplier         Supplier                 @relation(fields: [supplierId], references: [id])
  QuotationPayment QuotationPayment?
}

enum transferMethodCommission {
  SINGLE
  CONFORMING
}

enum CommissionType {
  ADD
  SUB
}

model QuotationInstallment {
  id                 String           @id @default(uuid())
  quotationPaymentId String // Relação com o pagamento do orçamento
  quotationPayment   QuotationPayment @relation(fields: [quotationPaymentId], references: [id])
  dueDate            DateTime // Data de vencimento da parcela
  paymentMethodId    String // Forma de pagamento para a parcela
  paymentMethod      PaymentMethod    @relation(fields: [paymentMethodId], references: [id])
  surcharge          Float            @default(0) // Acréscimo
  value              Float // Valor da parcela
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

enum OrderStatus {
  PENDING
  IN_PRODUCTION
  DELIVERY
  COMPLETED
  FINISHED
  CANCELED
}

model DeliveryInfo {
  id          String    @id @default(uuid())
  quotationId String    @unique
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  deliveryTypeId String?
  deliveryType   DeliveryType? @relation(fields: [deliveryTypeId], references: [id])

  daysAfterApproval Int?
  estimatedDate     DateTime?
  modality          String    @default("Indefinida")
  cost              Float?
  value             Float?
  notes             String?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([quotationId])
}

model DeliveryType {
  id        String    @id @default(uuid())
  name      String
  isCarrier Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  deliveries DeliveryInfo[] // Relacionamento com a tabela de DeliveryInfo
}

model Order {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  canceledAt  DateTime?
  deliveredAt DateTime?

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id])

  status           OrderStatus        @default(IN_PRODUCTION)
  isActive         Boolean            @default(true)
  DeliverySchedule DeliverySchedule[]

  @@index([id])
  @@map("orders")
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id   String @id @default(uuid())
  name String
  code String

  isActive   Boolean       @default(true)
  status     ProductStatus @default(ACTIVE)
  isStandard Boolean       @default(false)

  technicalDescription String?
  allowEditValues      Boolean @default(true)
  allowEditDescription Boolean @default(true)
  imageUrl             String?

  items            ProductItem[]
  productionStages Json?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id])

  quotations       Quotation[]        @relation("QuotationToProduct")
  QuotationProduct QuotationProduct[]

  @@unique([code, companyId])
  @@map("products")
}

model ProductItem {
  id   String @id @default(uuid())
  name String

  productId String
  product   Product @relation(fields: [productId], references: [id])

  unitOfMeasureId String
  unitOfMeasure   UnitOfMeasure @relation(fields: [unitOfMeasureId], references: [id])
  width           Float? //largura
  height          Float? //altura
  length          Float? //comprimento
  weight          Float? //peso
  volume          Float? //volume
  distance        Float? //distancia
  duration        Float? //duração (em dias)

  unitCost             Float?
  salePrice            Float?
  QuotationProductItem QuotationProductItem[]

  @@map("product_items")
}

model State {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name     String
  code     String
  isActive Boolean @default(true)

  cities  City[]
  Address Address[]

  @@index([code])
  @@map("states")
}

model City {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  name     String
  code     String
  isActive Boolean @default(true)

  stateId String
  state   State     @relation(fields: [stateId], references: [id])
  Address Address[]

  @@map("cities")
}

model UnitOfMeasure {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?

  isActive     Boolean       @default(true)
  productItems ProductItem[]

  companyId            String
  company              Company                @relation(fields: [companyId], references: [id])
  QuotationProductItem QuotationProductItem[]

  @@map("unit_measures")
}

model Language {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?

  isActive Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@map("languages")
}

model Reasons {
  id        String     @id @default(uuid())
  reason    String
  type      ReasonType
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])

  @@map("reasons")
}

enum ReasonType {
  REJECTION
  CANCELLATION
}

enum DeliveryScheduleStatus {
  IN_PRODUCTION
  DELIVERING
  DONE
}

model DeliverySchedule {
  id String @id @default(uuid())

  status             DeliveryScheduleStatus
  completed          Boolean                @default(false)
  notes              String? // Notas adicionais
  scheduledDate      DateTime // Data de entrega agendada
  addScheduleTime    Boolean                @default(false)
  pendingDescription String? // Descrição do pendente

  orderId String // Relacionamento com Order
  order   Order  @relation(fields: [orderId], references: [id])

  productionStages ProductionStage[] // Estágios de produção relacionados

  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

enum ProductionStageStatus {
  NOT_STARTED
  IN_PROGRESS
  PAUSED
  PENDING
  DONE
  CANCELED
  WAITING_PRODUCTION
  OVERDUE
}

model ProductionStage {
  id         String                @id @default(cuid())
  stage      String
  status     ProductionStageStatus
  prevStatus String?
  scheduleId String

  schedule DeliverySchedule @relation(fields: [scheduleId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model Nature {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime?    @updatedAt
  isActive   Boolean      @default(true)
  Receivable Receivable[]
  Payable    Payable[]
}
