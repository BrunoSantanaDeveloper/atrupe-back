generator client {
  provider = "prisma-client-js"
  // previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                     String                         @id @default(uuid())
  name                   String // Nome Fantasia
  createdAt              DateTime                       @default(now())
  isActive               Boolean                        @default(true)
  updatedAt              DateTime?                      @updatedAt
  blockLevel             BlockLevel                     @default(NONE)
  blockedAt              DateTime?
  blockReason            String?
  cnpj                   String?
  legalName              String? // Razão Social
  municipalRegistration  String?
  stateRegistration      String?
  email                  String?
  favIconUrl             String?
  logoUrl                String?
  logoDarkUrl            String? // logo para o tema escuro da plataforma
  mobile                 String?
  phone                  String?
  siteUrl                String?
  textAfterItems         String?
  textBeforeItems        String?
  principalCompanyId     String?
  // Titular da conta: quem responde por ela perante a Atrupe. Nasce com quem
  // criou a conta e só muda por transferência de titularidade. Sem chave
  // estrangeira de propósito: excluir o usuário não pode travar a empresa.
  ownerUserId            String?
  // Quando uma transferência de titularidade trocou o CNPJ: os emissores e as
  // notas de antes pertencem ao CNPJ anterior — ficam como histórico, sem
  // manipulação, e a configuração fiscal recomeça do zero.
  fiscalResetAt          DateTime?
  facebook               String?
  instagram              String?
  linkedin               String?
  unitDefaults           Json?
  cnae                   String?
  partnerKey             String?
  accessKey              String?
  deliveryType           DeliveryType[]
  DigitalCertificate     DigitalCertificate?
  AcademyProgress        AcademyProgress[]
  address                Address[]
  assetTypes             AssetType[]
  materials              Material[]
  quotationDrafts        QuotationDraft[]
  processes              Process[]
  productAssemblies      ProductAssembly[]
  materialImportLinks    MaterialImportLink[]
  assets                 Asset[]
  bankAccounts           BankAccount[]
  cashControls           CashRegister[]
  categories             Category[]
  clients                Client[]
  creditLimitDefault     CreditLimitDefault[]
  customer               Customer[]
  deliverySchedule       DeliverySchedule[]
  employees              Employee[]
  financialFlows         FinancialFlow[]
  invoices               Invoice[]
  language               Language[]
  nature                 Nature[]
  payables               Payable[]
  paymentConditions      PaymentCondition[]
  Plan                   Plan[]
  products               Product[]
  reasons                Reasons[]
  receivables            Receivable[]
  roles                  Role[]
  PayrollSetup           PayrollSetup[]
  payrollTemplates       PayrollTemplate[]
  payroll                Payroll[]
  saleSeries             SaleSeries[]
  scheduledExpenses      ScheduledExpense[]
  sellerProfile          SellerProfile[]
  quotationTag           QuotationTag[]
  subCategory            SubCategory[]
  Subscription           Subscription[]
  suppliers              Supplier[]
  parentCompany          Company?                       @relation("CompanyHierarchy", fields: [principalCompanyId], references: [id])
  subsidiaries           Company[]                      @relation("CompanyHierarchy")
  mainQuotations         Quotation[]                    @relation("MainCompany")
  fiscalQuotations       Quotation[]                    @relation("FiscalSubCompany")
  sectors                CompanySector[]                @relation("CompanyToCompanySector")
  history                CompanyHistory[]
  importLogs             ImportLog[]
  migrationRuns          MigrationRun[]
  invoicyConfigs         InvoicyConfig[]
  fiscalOnboarding       FiscalOnboardingRequest[]
  environmentCredentials CompanyEnvironmentCredential[]
  nfes                   Nfe[]
  nfses                  Nfse[]
  nfseServicos           NfseServico[]
  nfces                  Nfce[]
  cfopConfigs            CfopConfig[]
  operationNatures       OperationNature[]
  aiConversations        AiConversation[]
  aiUsage                AiUsage[]
  aiActions              AiAction[]
  contactSources         ContactSource[]
  hiddenContactSources   CompanyHiddenContactSource[]
  saleSettings           SaleSettings?
  assetGroups            AssetGroup[]
  productionFlows        ProductionFlow[]
  productionManagers     ProductionManager[]
  productionProfiles     ProductionCollaborator[]
  productionTaskTypes    ProductionTaskType[]
  productionVehicles     ProductionVehicle[]
  productionProjects     ProductionProject[]
  productionCalendar     ProductionCalendar?
  quickSaleSettings      QuickSaleSettings?
  cashFronts             CashFront[]
  pendingSales           PendingSale[]
  stockItems             StockItem[]
  inboundInvoices        InboundInvoice[]
  purchaseRequests       PurchaseRequest[]
  purchaseOrders         PurchaseOrder[]
  stockLots              StockLot[]
  bankStatementLines     BankStatementLine[]
  dataResets             CompanyDataReset[]

  @@map("companies")
}

/// "Zerar dados da conta" feito pelo superadmin: apaga documentos, cadastros e
/// lançamentos e mantém a conta, os usuários, a assinatura e o fiscal. Guarda o
/// que foi apagado (JSON compactado) por um prazo, para restaurar se preciso.
model CompanyDataReset {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  companyId       String
  createdByUserId String
  createdByName   String
  /// Opções escolhidas (configurações, documentos fiscais).
  options         Json
  /// Quantos registros saíram de cada tabela.
  summary         Json
  /// As linhas apagadas, em JSON compactado com gzip. Vira nulo no fim do prazo.
  backup          Bytes?
  backupExpiresAt DateTime?
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("company_data_resets")
}

model CompanyHistory {
  id            String   @id @default(uuid())
  companyId     String
  action        String // CREATE, UPDATE, ACTIVATE, DEACTIVATE, UPDATE_PROFILE, UPDATE_SETTINGS
  description   String
  changes       Json? // { before: {...}, after: {...} }
  metadata      Json? // Dados adicionais
  createdBy     String?
  createdByName String? // Desnormalizado para performance
  createdAt     DateTime @default(now())
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user          User?    @relation("CompanyHistoryUser", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("company_history")
}

model Address {
  id           String         @id @default(uuid())
  street       String?
  number       String?
  country      String?
  ownerId      String?
  ownerType    OwnerType      @default(COMPANY)
  complement   String?
  neighborhood String?
  zipcode      String?
  city         String?
  state        String?
  type         String         @default("Principal")
  supplierId   String?
  companyId    String?
  employeeId   String?
  company      Company?       @relation(fields: [companyId], references: [id])
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  client       Client?        @relation(fields: [ownerId], references: [id])
  supplier     Supplier?      @relation(fields: [supplierId], references: [id])
  deliveryInfo DeliveryInfo[]

  @@index([ownerId, ownerType])
  @@index([supplierId, ownerType])
  @@map("addresses")
}

model CompanySector {
  id                          String                     @id @default(uuid())
  name                        String
  icon                        String?
  companyId                   String
  isActive                    Boolean                    @default(true)
  kind                        SectorKind                 @default(PRODUCTION)
  isProductionStage           Boolean                    @default(true)
  isSystem                    Boolean                    @default(false)
  /// Como o setor vende: por hora ou pela unidade do equipamento (composição)
  saleUnit                    SectorSaleUnit             @default(HOUR)
  /// #RRGGBB em maiúsculas; nulo = padrão do ícone, resolvido na tela
  color                       String?
  /// Produtivo ou administrativo na base de custos
  nature                      SectorNature               @default(PRODUCTIVE)
  /// Rateio entre os equipamentos do setor: só muda por /cost-base/sector/:id/allocation
  allocationCriterion         SectorAllocationCriterion  @default(ACQUISITION_VALUE)
  /// [{ assetId, percentage }], só no rateio manual
  allocationPercentages       Json?
  /// O critério automático de onde o manual nasceu
  allocationPreviousCriterion SectorAllocationCriterion?
  /// No manual, a lista de equipamentos mudou e o rateio precisa ser salvo de novo
  allocationOutdated          Boolean                    @default(false)
  /// Quanto do total administrativo o setor produtivo recebe, percentual com duas casas (BC-5)
  distributionPercentage      Float                      @default(0)
  /// A regra do preço da hora (hourSale) na precificação; no variável, o
  /// lucro em décimos de ponto que o preço preserva (PR-4)
  hourSaleRule                MaterialPriceRule          @default(FIXED)
  hourSaleProfit              Int?
  /// Custo da hora de mão de obra do setor, em centavos. Informado até a
  /// base de custos calcular (módulo 4); a composição custeia por ele
  hourCost                    Int?
  /// A hora vendida do setor, em centavos (IP-25)
  hourSale                    Int?
  /// Gráfica rápida (GR-1.1, 12/11/2026): a sangria padrão por lado, em mm
  /// (nulo = 2 mm), e as folhas de acerto por trabalho (nulo = nenhuma)
  bleedMm                     Float?
  setupSheets                 Int?
  asset                       Asset[]
  assetGroups                 AssetGroup[]
  materials                   Material[]
  processes                   Process[]
  assemblyBlocks              AssemblyBlock[]
  Category                    Category[]
  employees                   Employee[]
  productionStage             ProductionStage[]
  productionItemStages        ProductionItemStage[]
  product                     Product[]
  role                        Role[]
  productionManagers          ProductionManager[]
  company                     Company                    @relation("CompanyToCompanySector", fields: [companyId], references: [id])

  @@map("sectors")
}

model Role {
  id          String         @id @default(uuid())
  name        String
  companyId   String
  isActive    Boolean        @default(true)
  sectorId    String?
  isAdmin     Boolean        @default(false)
  permissions String[]
  employees   Employee[]
  company     Company        @relation(fields: [companyId], references: [id])
  sector      CompanySector? @relation(fields: [sectorId], references: [id])
  userRole    UserRole[]

  @@map("roles")
}

model SellerProfile {
  id                        String       @id @default(uuid())
  name                      String
  isActive                  Boolean      @default(true)
  companyId                 String
  commission                Float?
  maxDiscount               Float?
  minValue                  Float?
  canApprovePreRegistration Boolean      @default(false)
  canCancelSale             Boolean      @default(false)
  /// Somente enviar ao caixa (FC-12.1): só a venda rápida enviada à frente
  /// de caixa; a forma de pagamento e o faturamento ficam com o caixa
  onlySendToCash            Boolean      @default(false)
  employees                 Employee[]
  company                   Company      @relation(fields: [companyId], references: [id])
  allowedSeries             SaleSeries[] @relation("SeriesAllowedProfiles")

  @@map("seller_profile")
}

model Category {
  id         String         @id @default(uuid())
  name       String
  kind       CategoryKind   @default(PRODUCT)
  companyId  String?
  isActive   Boolean        @default(true)
  isStandard Boolean        @default(false)
  sectorId   String?
  company    Company?       @relation(fields: [companyId], references: [id])
  sector     CompanySector? @relation(fields: [sectorId], references: [id])
  products   Product[]
  clients    Client[]       @relation("ClientToCategory")
  suppliers  Supplier[]     @relation("SupplierToCategory")

  @@map("categories")
}

model Contact {
  id         String      @id @default(uuid())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime?   @updatedAt
  name       String
  email      String?
  sector     String?
  clientId   String?
  supplierId String?
  mobile     String?
  phone      String?
  notes      String?
  client     Client?     @relation(fields: [clientId], references: [id])
  supplier   Supplier?   @relation(fields: [supplierId], references: [id])
  quotations Quotation[]

  @@map("contacts")
}

model ContactSource {
  id                String                       @id @default(uuid())
  name              String
  companyId         String?
  company           Company?                     @relation(fields: [companyId], references: [id])
  quotations        Quotation[]
  hiddenByCompanies CompanyHiddenContactSource[]

  @@map("contact_sources")
}

model CompanyHiddenContactSource {
  companyId       String
  contactSourceId String
  company         Company       @relation(fields: [companyId], references: [id])
  contactSource   ContactSource @relation(fields: [contactSourceId], references: [id])

  @@id([companyId, contactSourceId])
  @@map("company_hidden_contact_sources")
}

model CreditLimitDefault {
  id                String                        @id @default(uuid())
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime?                     @updatedAt
  type              ClientKind                    @default(PERSON)
  companyId         String
  minValue          Float?
  maxValue          Float?
  company           Company                       @relation(fields: [companyId], references: [id])
  paymentConditions CreditLimitPaymentCondition[]

  @@map("credit_limit_default")
}

model CreditLimitPaymentCondition {
  id                   String             @id @default(uuid())
  createdAt            DateTime           @default(now())
  isActive             Boolean            @default(true)
  creditLimitDefaultId String
  paymentConditionId   String
  creditLimitDefault   CreditLimitDefault @relation(fields: [creditLimitDefaultId], references: [id])
  paymentCondition     PaymentCondition   @relation(fields: [paymentConditionId], references: [id])

  @@unique([creditLimitDefaultId, paymentConditionId])
  @@map("credit_limit_payment_conditions")
}

model Client {
  id                String                   @id @default(uuid())
  name              String
  companyId         String
  status            ClientStatus             @default(PROSPECT)
  email             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime?                @updatedAt
  responsibleId     String?
  birthdate         DateTime?
  financialNotes    String?
  nickname          String?
  notes             String?
  site              String?
  activity          String?
  cnpj              String?
  corporateName     String?
  cpf               String?
  mobile            String?
  phone             String?
  rg                String?
  tradeName         String?
  type              ClientKind               @default(PERSON)
  categoryId        String?
  blockClient       Boolean                  @default(false)
  /// "Exigir pagamento antecipado" (PA-1, 12/11/2026): a venda só vira O.S. depois de paga
  requirePrepayment Boolean                  @default(false)
  maxValue          Float?
  minValue          Float?
  supplierId        String?
  planId            String?
  isBranch          Boolean                  @default(false)
  isImported        Boolean                  @default(false)
  legacyId          String?
  stateRegistration String? // IE (Inscrição Estadual) — required for ICMS taxpayers on NF-e
  indicadorIE       Int?                     @default(9) // 1=Contribuinte ICMS, 2=Isento, 9=Não contribuinte
  address           Address[]
  paymentConditions ClientPaymentCondition[]
  company           Company                  @relation(fields: [companyId], references: [id])
  responsible       Employee?                @relation(fields: [responsibleId], references: [id])
  supplier          Supplier?                @relation(fields: [supplierId], references: [id])
  category          Category?                @relation("ClientToCategory", fields: [categoryId], references: [id])
  contacts          Contact[]
  payable           Payable[]
  quotation         Quotation[]
  receivable        Receivable[]

  @@unique([companyId, legacyId])
  @@map("clients")
}

model Supplier {
  id                 String                     @id @default(uuid())
  legacyId           String?
  name               String
  email              String?
  companyId          String
  createdAt          DateTime                   @default(now())
  status             ClientStatus               @default(ACTIVE)
  updatedAt          DateTime?                  @updatedAt
  birthdate          DateTime?
  financialNotes     String?
  nickname           String?
  notes              String?
  outsourcedProducts Product[]                  @relation("ProductSuppliers")
  site               String?
  activity           String?
  cnpj               String?
  corporateName      String?
  cpf                String?
  mobile             String?
  phone              String?
  rg                 String?
  tradeName          String?
  type               ClientKind                 @default(PERSON)
  blockClient        Boolean                    @default(false)
  categoryId         String?
  maxValue           Float?
  minValue           Float?
  isBranch           Boolean                    @default(false)
  isImported         Boolean                    @default(false)
  stateRegistration  String? // IE (Inscrição Estadual)
  indicadorIE        Int?                       @default(9) // 1=Contribuinte ICMS, 2=Isento, 9=Não contribuinte
  /// Dados de pagamento do fornecedor (decisão do produto, 26/10/2026):
  /// para pagar as contas a pagar, inclusive as do terceirizado
  pixKey             String?
  bankName           String?
  bankAgency         String?
  bankAccount        String?
  accountHolder      String?
  /// Prazo e forma habitual, em texto ("30 dias, boleto")
  paymentTerms       String?
  address            Address[]
  client             Client[]
  commission         Commission[]
  contacts           Contact[]
  deliveryInfo       DeliveryInfo[]
  payable            Payable[]
  receivable         Receivable[]
  scheduledExpense   ScheduledExpense[]
  paymentConditions  SupplierPaymentCondition[]
  quotationLines     QuotationItemLine[]
  company            Company                    @relation(fields: [companyId], references: [id])
  category           Category?                  @relation("SupplierToCategory", fields: [categoryId], references: [id])
  /// Os itens de orçamento que compram dele (terceirizado, 12/11/2026)
  quotationProducts  QuotationProduct[]         @relation("QuotationProductSupplier")

  @@unique([companyId, legacyId])
  @@map("suppliers")
}

model Employee {
  id                     String                  @id @default(uuid())
  companyId              String
  roleId                 String?
  sectorId               String?
  userId                 String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime?               @updatedAt
  isActive               Boolean                 @default(true)
  sallary                Float?
  /// Forma de contratação e salário base (centavos): geram os encargos
  contract               EmploymentContract?
  baseSalary             Int?
  sellerProfileId        String?
  name                   String?
  avatarUrl              String?
  cpf                    String?
  mobile                 String?
  phone                  String?
  rg                     String?
  signatureUrl           String?
  legacyId               String?
  isImported             Boolean                 @default(false)
  address                Address[]
  client                 Client[]
  company                Company                 @relation(fields: [companyId], references: [id])
  role                   Role?                   @relation(fields: [roleId], references: [id])
  sector                 CompanySector?          @relation(fields: [sectorId], references: [id])
  sellerProfile          SellerProfile?          @relation(fields: [sellerProfileId], references: [id])
  user                   User?                   @relation(fields: [userId], references: [id])
  quotation              Quotation[]
  PayrollSetup           PayrollSetup[]
  payroll                Payroll[]
  payables               Payable[]
  employeeHistory        EmployeeHistory[]
  productionProfile      ProductionCollaborator?
  productionManagerUsers ProductionManagerUser[]
  productionTimeEntries  ProductionTimeEntry[]
  productionTasks        ProductionTask[]        @relation("ProductionTaskAssignee")

  @@unique([companyId, legacyId])
  @@map("employees")
}

model EmployeeHistory {
  id            String   @id @default(uuid())
  employeeId    String
  action        String // CREATE, UPDATE, DEACTIVATE, REACTIVATE, CREATE_USER, UPDATE_USER
  description   String
  changes       Json? // { before: {...}, after: {...} }
  metadata      Json? // Dados adicionais
  createdBy     String
  createdByName String? // Desnormalizado para performance
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user          User     @relation("EmployeeHistoryUser", fields: [createdBy], references: [id])

  @@index([employeeId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("employee_history")
}

model User {
  id                   String                 @id @default(uuid())
  password             String
  email                String                 @unique
  name                 String
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  avatar               String?
  isActive             Boolean                @default(true)
  resetPasswordExpires DateTime?
  resetPasswordToken   String?
  phone                String?
  isVerified           Boolean                @default(false)
  customerId           String?
  signupEventId        String?                @unique
  signupOppref         String?
  signupUtm            Json?
  signupGclid          String?
  employee             Employee[]
  userContract         UserContract[]
  userRole             UserRole[]
  receivableHistory    ReceivableHistory[]    @relation("ReceivableHistoryUser")
  payableHistory       PayableHistory[]       @relation("PayableHistoryUser")
  employeeHistory      EmployeeHistory[]      @relation("EmployeeHistoryUser")
  quotationHistory     QuotationHistory[]     @relation("QuotationHistoryUser")
  orderHistory         OrderHistory[]         @relation("OrderHistoryUser")
  companyHistory       CompanyHistory[]       @relation("CompanyHistoryUser")
  fiscalHistory        InvoicyConfigHistory[] @relation("FiscalHistoryUser")
  userActivities       UserActivity[]
  userActivityEvents   UserActivityEvent[]
  importLogs           ImportLog[]
  migrationRuns        MigrationRun[]         @relation("MigrationRunStartedBy")
  aiConversations      AiConversation[]
  aiActions            AiAction[]
  releaseNoteReads     ReleaseNoteRead[]
  customer             Customer?              @relation(fields: [customerId], references: [id])

  @@index([email])
  @@map("users")
}

/// As novidades do sistema (19/11/2026): cada atualização que o Super Admin
/// publica. O sino do topo, o aviso do painel e a página Novidades leem daqui
model ReleaseNote {
  id            String            @id @default(uuid())
  title         String
  /// O resumo do sino e do aviso
  summary       String
  /// Rótulo da versão, opcional ("Novembro de 2026")
  version       String?
  /// As mudanças: [{ kind: NEW | IMPROVEMENT | FIX, text }]
  items         Json              @default("[]")
  /// Os planos que recebem; vazio = todos
  plans         PlanType[]        @default([])
  /// Abre o aviso "O que mudou" no painel na primeira vez
  highlight     Boolean           @default(true)
  /// Nulo = rascunho; o cliente só vê a publicada
  publishedAt   DateTime?
  createdByName String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reads         ReleaseNoteRead[]

  @@index([publishedAt])
  @@map("release_notes")
}

/// O que cada usuário já viu: o sino (seenAt) e o aviso do painel (announcedAt)
model ReleaseNoteRead {
  releaseNoteId String
  userId        String
  seenAt        DateTime?
  announcedAt   DateTime?
  releaseNote   ReleaseNote @relation(fields: [releaseNoteId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([releaseNoteId, userId])
  @@index([userId])
  @@map("release_note_reads")
}

model MailVerification {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  email       String    @unique
  token       String?
  expiresAt   DateTime?
  verified    Boolean   @default(false)
  name        String?
  companyName String?
  phone       String?

  @@map("mail_verifications")
}

/// Patrimônio da empresa (módulo 4): máquina, móvel ou veículo, com
/// depreciação, custos e configurações produtivas. Inativado, nunca
/// excluído. Dinheiro em centavos; percentuais com até duas casas.
model Asset {
  id                         String         @id @default(uuid())
  name                       String
  companyId                  String?
  createdAt                  DateTime       @default(now())
  sectorId                   String?
  updatedAt                  DateTime?      @updatedAt
  /// Legado, sem tela: ficam até a limpeza (valores copiados na migration)
  fixedMonthlyCost           Float?
  purchaseValue              Float?
  residualValue              Float?
  typeId                     String?
  usefulLife                 Int?
  variableQualityMonthlyCost Float?
  variableTotalMonthlyCost   Float?
  imageUrl                   String?
  /// Só agrupa a lista (P-29)
  kind                       AssetKind      @default(MACHINES)
  groupId                    String?
  /// Detalhado: tem unidade, produtividade e configurações (P-15)
  detailed                   Boolean        @default(false)
  unit                       AssetUnit?
  /// Unidades por mês; no detalhado com configurações, a soma delas (P-31)
  monthlyProductivity        Float?
  acquisitionDate            DateTime?      @db.Date
  acquisitionValue           Int            @default(0)
  usefulLifeMonths           Int?
  residualPercent            Float?
  /// A vida útil revista ao fim dela: o bem segue depreciado, não em revisão
  usefulLifeReviewedAt       DateTime?
  active                     Boolean        @default(true)
  inactivatedAt              DateTime?
  inactiveReason             String?
  /// Venda do bem (P-25): valor, resultado e a receita lançada
  soldAt                     DateTime?
  saleValue                  Int?
  saleResult                 Int?
  saleReceivableId           String?
  company                    Company?       @relation(fields: [companyId], references: [id])
  sector                     CompanySector? @relation(fields: [sectorId], references: [id])
  type                       AssetType?     @relation(fields: [typeId], references: [id])
  group                      AssetGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  costs                      AssetCost[]
  setups                     AssetSetup[]
  readings                   AssetReading[]

  @@index([companyId, active])
  @@map("assets")
}

/// Grupo de bens equivalentes (P-5.2, P-13, P-28): mesma unidade e setor
model AssetGroup {
  id        String            @id @default(uuid())
  companyId String
  name      String
  unit      AssetUnit
  /// Nulo nos grupos que nascem cadastrados: o primeiro bem define
  sectorId  String?
  /// O preço do grupo como uma linha só na precificação (P-28), em
  /// centavos; no variável, o lucro em décimos de ponto
  priceRule MaterialPriceRule @default(FIXED)
  salePrice Int?
  profit    Int?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   Company           @relation(fields: [companyId], references: [id])
  sector    CompanySector?    @relation(fields: [sectorId], references: [id])
  assets    Asset[]

  @@unique([companyId, name])
  @@map("asset_groups")
}

/// Custo do bem com natureza e periodicidade (P-6, P-19, P-30)
model AssetCost {
  id             String          @id @default(uuid())
  assetId        String
  name           String
  nature         AssetCostNature
  /// Centavos pelo rendimento: no mês (fixo) ou por unidade (variável)
  unitCost       Int
  yieldAmount    Float
  yieldUnit      AssetYieldUnit
  /// A conta do plano de contas (subcategoria) do custo (P-17)
  subCategoryId  String?
  lastOccurrence DateTime?       @db.Date
  /// Manutenção que bloqueia a agenda da máquina (GP-49 item 6, ELITE): na
  /// próxima data (última ocorrência + a periodicidade), a fila do setor não
  /// põe trabalho na máquina das blockStart por blockMinutes
  blocksSchedule Boolean         @default(false)
  blockStart     String?
  blockMinutes   Int?
  setupId        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  subCategory    SubCategory?    @relation(fields: [subCategoryId], references: [id])
  setup          AssetSetup?     @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_costs")
}

/// Configuração produtiva do bem detalhado (P-2, P-19, P-31)
model AssetSetup {
  id                  String            @id @default(uuid())
  assetId             String
  name                String
  abbreviation        String            @default("")
  unit                AssetUnit
  /// Minutos por unidade
  timePerUnit         Float             @default(0)
  monthlyProductivity Float
  /// O preço da configuração na precificação, em centavos por unidade;
  /// no variável, o lucro em décimos de ponto (PR-4)
  priceRule           MaterialPriceRule @default(FIXED)
  salePrice           Int?
  profit              Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  asset               Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  costs               AssetCost[]

  @@unique([assetId, name])
  @@map("asset_setups")
}

/// Leitura do contador do bem (hodômetro, horímetro, contador de m²): a
/// diferença entre duas leituras é o volume do período no comparativo da
/// base de custos. O contador não volta: cada leitura fica entre a anterior
/// e a posterior
model AssetReading {
  id            String   @id @default(uuid())
  companyId     String
  assetId       String
  date          DateTime @db.Date
  /// Na unidade do bem
  value         Float
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
  @@index([companyId, date])
  @@map("asset_readings")
}

/// Histórico das escritas que mudam custo ou preço (SEG-4): antes, depois,
/// quem e quando
model CostAuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([companyId, entity, entityId])
  @@map("cost_audit_logs")
}

/// Marcas por empresa da base de custos (os grupos que nascem cadastrados)
/// A conta administrativa na base de custos (subcategoria do plano de
/// contas): o critério do custo mensal de referência e o rateio por item
/// entre os setores produtivos (BC-8). Sem linha, vale o critério padrão
model CostBaseExpense {
  id            String         @id @default(uuid())
  companyId     String
  subCategoryId String
  /// Nulo: o padrão, a média mais longa que já tem histórico
  criterion     CostCriterion?
  /// Valor mensal no critério manual, em centavos
  manualValue   Int?
  /// [{ sectorId, percentage }]: a parte de cada setor produtivo
  allocations   Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([companyId, subCategoryId])
  @@map("cost_base_expenses")
}

/// Os parâmetros da precificação da empresa, em décimos de ponto (PR-4):
/// os encargos sobre o preço e o lucro desejado que formam o markup
model PricingParameters {
  id            String   @id @default(uuid())
  companyId     String   @unique
  taxation      Int      @default(0)
  commission    Int      @default(0)
  financialCost Int      @default(0)
  desiredMargin Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pricing_parameters")
}

/// As horas do colaborador no mês (F-11): a carga do setor na mão de obra.
/// Vale para o setor do cadastro do colaborador (F-2)
model EmployeeWorkload {
  id         String   @id @default(uuid())
  companyId  String
  employeeId String   @unique
  sectorId   String
  hours      Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@map("employee_workloads")
}

model CostBaseSettings {
  id                         String    @id @default(uuid())
  companyId                  String    @unique
  assetGroupsSeededAt        DateTime?
  /// As contas das fontes sem bem no comparativo (§10): o material das
  /// vendas e o custo financeiro. Nulas, vale a conta padrão pela
  /// descrição; a escolhida que deixar de valer (inativa, administrativa)
  /// também volta ao padrão, por isso sem chave estrangeira
  materialSubCategoryId      String?
  financialCostSubCategoryId String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@map("cost_base_settings")
}

model AssetType {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt
  name       String
  details    String?
  isActive   Boolean   @default(true)
  companyId  String?
  isStandard Boolean   @default(false)
  company    Company?  @relation(fields: [companyId], references: [id])
  assets     Asset[]

  @@map("asset_types")
}

model Receivable {
  id                String                  @id @default(uuid())
  status            PaymentStatus           @default(PENDING)
  companyId         String
  createdAt         DateTime                @default(now())
  clientId          String?
  description       String?
  reference         String?
  referenceDate     DateTime
  subCategoryId     String?
  installmentQty    Int?
  totalAmount       Float?
  cancelReason      String?
  natureId          String?
  notes             String?
  totalValue        Float?
  cancelNotes       String?
  changeNotes       String?
  changeReason      String?
  updatedAt         DateTime?               @updatedAt
  quotationId       String?
  supplierId        String?
  mainAdditionalFee Float?
  financialType     FinancialType           @default(MAIN)
  isImported        Boolean                 @default(false)
  /// O título que libera a venda pendente (PA-5, "⚠️ Pendência")
  releasesQuotation Boolean                 @default(false)
  history           ReceivableHistory[]
  installments      ReceivableInstallment[]
  client            Client?                 @relation(fields: [clientId], references: [id])
  company           Company                 @relation(fields: [companyId], references: [id])
  nature            Nature?                 @relation(fields: [natureId], references: [id])
  quotation         Quotation?              @relation(fields: [quotationId], references: [id])
  subCategory       SubCategory?            @relation(fields: [subCategoryId], references: [id])
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])

  @@map("receivables")
}

model ReceivableInstallment {
  id                   String                 @id @default(uuid())
  receivableId         String
  installmentNumber    Int
  dueDate              DateTime
  amount               Float
  paymentConditionId   String?
  additionalFee        Float?
  status               PaymentStatus          @default(PENDING)
  paidDate             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  bankAccountId        String?
  paidAmount           Float?
  transactionId        String?
  provisionDate        DateTime?
  quotationInstallment QuotationInstallment[]
  bankAccount          BankAccount?           @relation(fields: [bankAccountId], references: [id])
  paymentCondition     PaymentCondition?      @relation(fields: [paymentConditionId], references: [id])
  receivable           Receivable             @relation(fields: [receivableId], references: [id])
  transactions         Transaction?           @relation(fields: [transactionId], references: [id])

  @@map("receivable_installments")
}

model ReceivableHistory {
  id            String     @id @default(uuid())
  receivableId  String
  action        String // CREATE, UPDATE_TITLE, UPDATE_INSTALLMENTS, PAY_INSTALLMENT, UNDO_PAYMENT, CANCEL, UNDO_CANCEL
  description   String
  changes       Json? // { before: {...}, after: {...} }
  metadata      Json? // Dados adicionais (installmentNumber, bankAccount, etc.)
  createdBy     String
  createdByName String? // Desnormalizado para performance
  createdAt     DateTime   @default(now())
  receivable    Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  user          User       @relation("ReceivableHistoryUser", fields: [createdBy], references: [id])

  @@index([receivableId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("receivable_history")
}

model Payable {
  id                 String               @id @default(uuid())
  status             PaymentStatus        @default(PENDING)
  companyId          String
  createdAt          DateTime             @default(now())
  description        String?
  reference          String?
  referenceDate      DateTime
  subCategoryId      String?
  installmentQty     Int?
  totalAmount        Float
  cancelReason       String?
  natureId           String?
  supplierId         String?
  notes              String?
  cancelNotes        String?
  changeNotes        String?
  changeReason       String?
  updatedAt          DateTime?            @updatedAt
  quotationId        String?
  clientId           String?
  employeeId         String?
  mainAdditionalFee  Float?
  totalValue         Float?
  scheduledExpenseId String?
  financialType      FinancialType        @default(MAIN)
  expenseSource      ExpenseSource        @default(SUPPLIER)
  isImported         Boolean              @default(false)
  commission         Commission[]
  history            PayableHistory[]
  installments       PayableInstallment[]
  client             Client?              @relation(fields: [clientId], references: [id])
  company            Company              @relation(fields: [companyId], references: [id])
  employee           Employee?            @relation(fields: [employeeId], references: [id])
  nature             Nature?              @relation(fields: [natureId], references: [id])
  quotation          Quotation?           @relation(fields: [quotationId], references: [id])
  scheduledExpense   ScheduledExpense?    @relation(fields: [scheduledExpenseId], references: [id])
  subCategory        SubCategory?         @relation(fields: [subCategoryId], references: [id])
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])

  @@map("payables")
}

model PayableInstallment {
  id                   String                 @id @default(uuid())
  payableId            String
  installmentNumber    Int
  dueDate              DateTime
  amount               Float
  paymentConditionId   String?
  additionalFee        Float?
  status               PaymentStatus          @default(PENDING)
  paidDate             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  bankAccountId        String?
  paidAmount           Float?
  transactionId        String?
  provisionDate        DateTime?
  bankAccount          BankAccount?           @relation(fields: [bankAccountId], references: [id])
  payable              Payable                @relation(fields: [payableId], references: [id])
  paymentCondition     PaymentCondition?      @relation(fields: [paymentConditionId], references: [id])
  transactions         Transaction?           @relation(fields: [transactionId], references: [id])
  quotationInstallment QuotationInstallment[]

  @@map("payable_installments")
}

model PayableHistory {
  id            String   @id @default(uuid())
  payableId     String
  action        String // CREATE, UPDATE_TITLE, UPDATE_INSTALLMENTS, PAY_INSTALLMENT, UNDO_PAYMENT, CANCEL, UNDO_CANCEL
  description   String
  changes       Json? // { before: {...}, after: {...} }
  metadata      Json? // Dados adicionais (installmentNumber, bankAccount, etc.)
  createdBy     String
  createdByName String? // Desnormalizado para performance
  createdAt     DateTime @default(now())
  payable       Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  user          User     @relation("PayableHistoryUser", fields: [createdBy], references: [id])

  @@index([payableId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("payable_history")
}

model Payroll {
  id         String        @id @default(uuid())
  month      Int
  year       Int
  status     SheetStatus   @default(EMPTY)
  companyId  String
  employeeId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime?     @updatedAt
  items      PayrollItem[]
  company    Company       @relation(fields: [companyId], references: [id])
  employee   Employee      @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month, year])
  @@map("payroll")
}

model PayrollItem {
  id          String    @id @default(uuid())
  payrollId   String
  type        ItemType
  description String?
  amount      Float
  reference   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  payroll     Payroll   @relation(fields: [payrollId], references: [id])

  @@map("payroll_items")
}

model PayrollSetup {
  id              String           @id @default(uuid())
  name            String
  amount          Float            @default(0)
  type            ItemType         @default(INCREASE)
  companyId       String
  employeeId      String
  templateId      String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
  isSet           Boolean          @default(false)
  /// Comportamento, acréscimo e desconto da linha (ALT-18), em centavos;
  /// type e amount ficam em sincronia para as telas de hoje
  behavior        PayrollBehavior?
  increase        Int?
  discount        Int?
  /// INSS ou FGTS com valor à mão: o recálculo pelo salário não mexe (F-4)
  manualOverride  Boolean          @default(false)
  company         Company          @relation(fields: [companyId], references: [id])
  employee        Employee         @relation(fields: [employeeId], references: [id])
  payrollTemplate PayrollTemplate? @relation(fields: [templateId], references: [id])

  @@map("payroll_setup")
}

model PayrollTemplate {
  id                String           @id @default(uuid())
  name              String
  type              ItemType         @default(INCREASE)
  defaultAmount     Float            @default(0)
  /// Comportamento do item (ALT-18): substitui o type; ADVANCE é o adiantamento
  behavior          PayrollBehavior?
  /// Valores padrão do item, em centavos
  defaultIncrease   Int?
  defaultDiscount   Int?
  /// Alíquota dos encargos editáveis (INSS e FGTS), percentual com duas casas
  rate              Float?
  /// Encargo gerado do salário base (INSS, FGTS, 13º e férias)
  derivedFromSalary Boolean          @default(false)
  /// 13º e férias: calculados por lei, não se editam (F-14)
  fixedByLaw        Boolean          @default(false)
  /// O salário base: o valor é o do cadastro do colaborador
  isBase            Boolean          @default(false)
  /// Item do sistema: BASE_SALARY, INSS, FGTS, THIRTEENTH, VACATION
  systemKey         String?
  companyId         String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime?        @updatedAt

  company      Company        @relation(fields: [companyId], references: [id])
  PayrollSetup PayrollSetup[]

  @@unique([name, type, companyId])
  @@map("payroll_template")
}

model FinancialFlow {
  id          String            @id @default(uuid())
  amount      Float
  type        FinancialFlowType
  description String
  date        DateTime
  companyId   String
  createdAt   DateTime          @default(now())
  company     Company           @relation(fields: [companyId], references: [id])

  @@map("financial_flow")
}

model CashRegister {
  id             String                   @id @default(uuid())
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime?                @updatedAt
  status         CashRegisterStatus       @default(OPEN)
  openingDate    DateTime
  closingDate    DateTime?
  openingBalance Float
  totalIncomes   Float                    @default(0)
  totalOutcomes  Float                    @default(0)
  retroactive    Float                    @default(0)
  closingBalance Float?
  companyId      String
  bankAccountId  String
  description    String?
  notes          String?
  /// Número sequencial na empresa; quem abriu e quem fechou (CX-2)
  number         Int?
  openedById     String?
  openedByName   String?
  closedById     String?
  closedByName   String?
  /// Fechado pelo sistema ao abrir o dia seguinte: o caixa ficou aberto sem
  /// nenhum lançamento, e fecha com o fechamento igual à abertura (revisão de
  /// 23/10/2026)
  closedBySystem Boolean                  @default(false)
  /// O que foi contado na gaveta ou o saldo do extrato, em reais
  informed       Float?
  /// [{ at, by, reason }]: cada reabertura, com o motivo (ALT-7)
  reopenings     Json                     @default("[]")
  cashControls   BankAccountCashControl[] // Analisar pra que precisa dessas configurações da conta bancária aqui
  bankAccount    BankAccount              @relation(fields: [bankAccountId], references: [id])
  company        Company                  @relation(fields: [companyId], references: [id])
  transactions   Transaction[]

  @@map("cash_registers")
}

model Transaction {
  id                    String                  @id @default(uuid())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime?               @updatedAt
  type                  TransactionType
  amount                Float                   @default(0)
  description           String?
  transactionDate       DateTime                @default(now())
  /// Nulo na conta sem controle de caixa: o lançamento vai direto na conta
  cashRegisterId        String?
  bankAccountId         String?
  reason                String?
  /// O que não é recebimento nem pagamento comum: ajuste, quebra, estorno
  kind                  CashMovementKind?
  /// A data do fato; com dia já fechado, entra no caixa aberto como retroativo (CX-3)
  operationDate         DateTime?
  retroactive           Boolean                 @default(false)
  /// O dinheiro que chega da frente de caixa espera a aprovação (CX-4)
  awaitingApproval      Boolean                 @default(false)
  approvedById          String?
  approvedByName        String?
  approvedAt            DateTime?
  /// Quem lançou (CX-2)
  responsibleId         String?
  responsibleName       String?
  /// O plano de contas do ajuste (CX-5)
  natureId              String?
  subCategoryId         String?
  /// O par da transferência ou do estorno (CX-2)
  linkedId              String?
  paymentConditionId    String?
  payableInstallment    PayableInstallment[]
  receivableInstallment ReceivableInstallment[]
  cashRegister          CashRegister?           @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  bankAccount           BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([bankAccountId, transactionDate])
  @@index([linkedId])
  @@map("transactions")
}

model ScheduledExpense {
  id            String        @id @default(uuid())
  description   String?
  amount        Float         @default(0)
  companyId     String
  createdAt     DateTime      @default(now())
  categoryId    String?
  dueDay        Int           @default(1)
  recurringType RecurringType @default(MONTHLY)
  subCategoryId String?
  supplierId    String?
  updatedAt     DateTime      @default(now()) @updatedAt
  isActive      Boolean       @default(true)
  payables      Payable[]
  nature        Nature?       @relation(fields: [categoryId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])
  subCategory   SubCategory?  @relation(fields: [subCategoryId], references: [id])
  supplier      Supplier?     @relation(fields: [supplierId], references: [id])

  @@map("scheduled_expenses")
}

model Invoice {
  id        String   @id @default(uuid())
  number    String
  date      DateTime
  amount    Float
  companyId String
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([number, companyId])
  @@map("invoices")
}

model UserRole {
  userId        String
  roleId        String
  isSystemAdmin Boolean @default(false)
  role          Role    @relation(fields: [roleId], references: [id])
  user          User    @relation(fields: [userId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Bank {
  id        String        @id @default(uuid())
  createdAt DateTime      @default(now())
  updatedAt DateTime?     @updatedAt
  name      String
  code      String
  details   Json?
  isActive  Boolean       @default(true)
  icon      String?
  accounts  BankAccount[]

  @@map("banks")
}

model BankAccount {
  id                     String                   @id @default(uuid())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime?                @updatedAt
  name                   String
  description            String?
  isActive               Boolean                  @default(true)
  companyId              String
  bankId                 String
  cashControl            Boolean                  @default(false)
  /// CASH caixa físico, BANK banco, CARD operadora (CX-3): decide como o dia fecha
  kind                   BankAccountKind          @default(BANK)
  /// Só na conta CASH com controle: a contagem às cegas (FC-7)
  blindCount             Boolean                  @default(false)
  /// Tolerância da quebra, em reais; nula = toda diferença é quebra (4.1)
  shortageTolerance      Float?
  /// Saldo inicial em reais e a data dele (CX-2)
  openingBalance         Float                    @default(0)
  openingDate            DateTime?                @db.Date
  /// O nome da operadora de cartão (Rede, Cielo, Stone…): a conta CARD não
  /// escolhe banco e fica no banco genérico "Operadora de cartão"
  operator               String?
  /// A conta onde a operadora deposita (só na CARD, 12/11/2026): a
  /// conciliação do extrato dela já sugere a operadora
  settlementAccountId    String?
  settlementAccount      BankAccount?             @relation("CardSettlement", fields: [settlementAccountId], references: [id], onDelete: SetNull)
  settledCards           BankAccount[]            @relation("CardSettlement")
  bankAccountCashControl BankAccountCashControl[]
  bank                   Bank                     @relation(fields: [bankId], references: [id])
  company                Company                  @relation(fields: [companyId], references: [id])
  cashRegister           CashRegister[]
  PayableInstallment     PayableInstallment[]
  ReceivableInstallment  ReceivableInstallment[]
  /// Lançamentos da conta (sem controle, vão direto, sem caixa do dia)
  transactions           Transaction[]
  /// O extrato importado (CX-6)
  statementLines         BankStatementLine[]

  @@map("bank_accounts")
}

model BankAccountCashControl {
  id                          String                     @id @default(uuid())
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime?                  @updatedAt
  acceptPayments              Boolean                    @default(true)
  paymentType                 BankAccountCashControlType @default(PAYSOFF)
  acceptIncomes               Boolean                    @default(true)
  incomeType                  BankAccountCashControlType @default(PAYSOFF)
  paymentConditionId          String
  bankAccountId               String
  cashRegisterId              String?
  acceptMultipleCashRegisters Boolean                    @default(false)
  /// A conta que vem pré-selecionada nesta forma; uma só por forma na empresa
  isDefault                   Boolean                    @default(false)
  bankAccount                 BankAccount                @relation(fields: [bankAccountId], references: [id])
  cashRegister                CashRegister?              @relation(fields: [cashRegisterId], references: [id])
  paymentCondition            PaymentCondition           @relation(fields: [paymentConditionId], references: [id])

  @@map("bank_account_cash_controls")
}

model PaymentMethod {
  id               String             @id @default(uuid())
  name             String
  code             String             @unique
  createdAt        DateTime           @default(now())
  isActive         Boolean            @default(true)
  paymentCondition PaymentCondition[]

  @@map("payment_methods")
}

model PaymentCondition {
  id                          String                        @id @default(uuid())
  name                        String
  legacyId                    String?
  acceptInstallments          Boolean                       @default(false)
  costType                    PaymentConditionCostType
  companyId                   String
  createdAt                   DateTime                      @default(now())
  isActive                    Boolean                       @default(true)
  maxInstallments             Int?
  minInstallments             Int?
  paymentMethodId             String
  dayInterval                 Int?
  receivingType               String?
  clients                     ClientPaymentCondition[]
  CreditLimitPaymentCondition CreditLimitPaymentCondition[]
  installments                Installment[]
  company                     Company                       @relation(fields: [companyId], references: [id])
  paymentMethod               PaymentMethod                 @relation(fields: [paymentMethodId], references: [id])
  downPaymentConditions       QuotationPayment[]            @relation("downPaymentRelation")
  quotationPayments           QuotationPayment[]            @relation("defaultRelation")
  suppliers                   SupplierPaymentCondition[]
  bankAccountCashControls     BankAccountCashControl[]
  payableInstallments         PayableInstallment[]
  receivableInstallments      ReceivableInstallment[]
  quotationInstallments       QuotationInstallment[]
  // Fiscal: generate invoice on approval
  generateInvoice             Boolean                       @default(false) // Auto-generate NF on order approval?
  invoiceType                 InvoiceType? // NFE, NFSE, NFCE, or null

  @@unique([companyId, legacyId])
  @@map("payment_conditions")
}

model Installment {
  id                  String           @id @default(uuid())
  installment         Int
  operatorFeeRate     Float            @default(0)
  operatorFeeTransfer Float            @default(0)
  paymentConditionId  String
  dueDate             DateTime?
  paymentCondition    PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@map("installments")
}

model SaleSeries {
  id                  String               @id @default(uuid())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime?            @updatedAt
  code                String
  isActive            Boolean              @default(true)
  companyId           String
  currentBudgetNumber Int                  @default(0)
  deliveryDeadline    Int?
  description         String?
  proposalValidity    Int?
  textAfterItems      String?
  textBeforeItems     String?
  title               String
  billing             BiilingKind          @default(ON_ORDER)
  productionStatus    ProductionStatusKind @default(MANAGE_PRODUCTION)
  sendToProduction    SendToProductionKind @default(DIRECT)
  isTraining          Boolean              @default(false)
  isDefault           Boolean              @default(false)
  quotation           Quotation[]
  company             Company              @relation(fields: [companyId], references: [id])
  allowedProfiles     SellerProfile[]      @relation("SeriesAllowedProfiles")

  @@unique([code, companyId])
  @@map("sale_series")
}

model QuotationTag {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime?   @updatedAt
  isActive  Boolean     @default(true)
  title     String
  color     String
  companyId String
  quotation Quotation[]
  company   Company     @relation(fields: [companyId], references: [id])

  @@map("quotation_tags")
}

model Quotation {
  id                String               @id @default(uuid())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime?            @updatedAt
  description       String?
  isActive          Boolean              @default(true)
  sellerId          String
  seriesId          String?
  clientId          String?
  companyId         String
  status            QuotationStatus      @default(OPEN)
  totalValue        Float                @default(0)
  dueDate           DateTime?
  approvedAt        DateTime?
  contactSourceId   String?
  tagId             String?
  // Acompanhamento comercial (24/10/2026): quando retomar o contato e o que
  // ficou combinado
  nextContactAt     DateTime?
  nextContactNote   String?
  quickSale         Boolean              @default(false)
  /// Contatos registrados na negociação (CRM fase 2, 27/10/2026)
  contacts          QuotationContact[]
  isImported        Boolean              @default(false)
  quotationNumber   Int?
  legacyId          String?
  finishedAt        DateTime?
  reasonId          String?
  subCompanyId      String?
  contactId         String?
  deliveryInfo      DeliveryInfo?
  DeliverySchedule  DeliverySchedule?
  order             Order?
  payable           Payable[]
  quotationPayment  QuotationPayment?
  quotationProduct  QuotationProduct[]
  client            Client?              @relation(fields: [clientId], references: [id])
  company           Company              @relation("MainCompany", fields: [companyId], references: [id])
  contact           Contact?             @relation(fields: [contactId], references: [id])
  contactSource     ContactSource?       @relation(fields: [contactSourceId], references: [id])
  reasons           Reasons?             @relation(fields: [reasonId], references: [id])
  seller            Employee             @relation(fields: [sellerId], references: [id])
  series            SaleSeries?          @relation(fields: [seriesId], references: [id])
  subCompany        Company?             @relation("FiscalSubCompany", fields: [subCompanyId], references: [id])
  tag               QuotationTag?        @relation(fields: [tagId], references: [id])
  receivable        Receivable[]
  products          Product[]            @relation("QuotationToProduct")
  history           QuotationHistory[]
  nfes              Nfe[]
  nfses             Nfse[]
  nfces             Nfce[]
  /// Os rascunhos dos itens montados na hora (ORC-11)
  drafts            QuotationDraft[]
  /// O projeto de produção da venda aprovada (ELITE)
  productionProject ProductionProject?
  /// A situação no caixa da venda rápida (FC-11)
  pendingSale       PendingSale?
  /// Pendente de pagamento (PA-4, 12/11/2026): o motivo, o valor exigido
  /// (centavos), desde quando, e a liberação sem pagamento (PA-7)
  holdReason        QuotationHoldReason?
  holdAmount        Int?
  holdAt            DateTime?
  holdReleasedAt    DateTime?
  holdReleaseNote   String?
  holdReleasedBy    String?

  @@unique([companyId, legacyId])
  @@index([id, companyId])
  @@map("quotations")
}

model QuotationProduct {
  quotationId          String
  /// Nulo no material de venda direta e no item montado na hora (origin)
  productId            String?
  quantity             Int                    @default(1)
  totalValue           Float?
  description          String?
  allowEditDescription Boolean                @default(true)
  allowEditValues      Boolean                @default(true)
  imageUrl             String?
  imageSize            String? // 'small' | 'large' | null (legacy)
  technicalDescription String?
  notes                String?
  id                   String                 @id @default(uuid())
  discount             Float?
  discountType         String?
  finalValue           Float?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime?              @updatedAt
  /// De onde veio o item: produto do cadastro, montado na hora ou material
  origin               QuotationItemOrigin    @default(PRODUCT)
  /// A variação escolhida (PV-3, PV-6)
  variationId          String?
  /// As escolhas do vendedor na composição (IP-36), com o resumo
  composition          Json?
  /// Acréscimo em centavos (ALT-25): fica fora do limite de desconto
  addition             Int                    @default(0)
  /// Soma do preço das linhas acrescentadas dentro do item (ORC-5), em
  /// centavos: entra no valor do item por fora do desconto
  linesTotal           Int                    @default(0)
  /// Material de venda direta (ORG-1, origin MATERIAL): o material, a
  /// variação e o preço por unidade na venda, em centavos
  materialId           String?
  materialVariationId  String?
  unitPrice            Int?
  /// Gráfica rápida no item (12/11/2026): a sangria só deste item (nulo =
  /// a do produto)
  printSpec            Json?
  /// O fornecedor do produto terceirizado nesta venda (12/11/2026): um dos
  /// do produto; nulo = o primeiro. A conta a pagar sai com ele
  supplierId           String?
  supplier             Supplier?              @relation("QuotationProductSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  lines                QuotationItemLine[]
  items                QuotationProductItem[]
  product              Product?               @relation(fields: [productId], references: [id], onDelete: Restrict)
  material             Material?              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialVariation    MaterialVariation?     @relation(fields: [materialVariationId], references: [id], onDelete: SetNull)
  /// O item montado na hora (ORC-11, origin COMPOSED): o rascunho em que
  /// foi montado, de onde a edição refaz o retrato
  draftId              String?
  draft                QuotationDraft?        @relation(fields: [draftId], references: [id], onDelete: SetNull)
  quotation            Quotation              @relation(fields: [quotationId], references: [id])
  variation            ProductVariation?      @relation(fields: [variationId], references: [id], onDelete: SetNull)
  /// O retrato da composição na venda (ORC-10), em tabela própria
  snapshot             QuotationItemSnapshot?
  /// As etapas do item na Agenda de entrega (área 9 §4.7, LITE)
  productionItemStages ProductionItemStage[]

  @@map("quotation_products")
}

/// O retrato da venda do item (ORC-10): custo e preço por etapa e por linha,
/// na medida e com as escolhas do item. Fica fora da linha do item para
/// nenhum include do orçamento (O.S., fiscal, PDF) levar custo à tela (ORC-7)
model QuotationItemSnapshot {
  quotationProductId String           @id
  data               Json
  computedAt         DateTime         @default(now())
  quotationProduct   QuotationProduct @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)

  @@map("quotation_item_snapshots")
}

/// Linha acrescentada dentro do item do orçamento (ORC-5, MS-15): um
/// processo, um item pronto do catálogo (parte) ou um terceirizado avulso.
/// Guarda o preço, o custo e o retrato do cálculo (ORC-10); custo e retrato
/// nunca saem para a tela do orçamento (ORC-7)
model QuotationItemLine {
  id                 String            @id @default(uuid())
  quotationProductId String
  kind               QuotationLineKind
  name               String
  sector             String
  tags               String[]          @default([])
  processId          String?
  productId          String?
  supplierId         String?
  supplierName       String?
  /// Acompanha a medida do item: refeita quando ela muda (05/10/2026)
  followsBase        Boolean?
  /// A medida usada, em mm: { quantity, width, height }
  measure            Json?
  /// Os campos do processo informados na venda (km, tempo)
  fields             Json?
  /// Preço e custo em centavos
  price              Int               @default(0)
  cost               Int               @default(0)
  /// Os recursos resolvidos com quantidade e custo (ORC-10)
  resolved           Json?
  resolvedAt         DateTime          @default(now())
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  quotationProduct   QuotationProduct  @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
  process            Process?          @relation(fields: [processId], references: [id], onDelete: SetNull)
  product            Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  supplier           Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([quotationProductId])
  @@map("quotation_item_lines")
}

/// Configurações de venda da empresa (MS-16, T-4): o markup do
/// terceirizado avulso, percentual com até duas casas (45 = 45 %)
model SaleSettings {
  id               String    @id @default(uuid())
  companyId        String    @unique
  outsourcedMarkup Float     @default(45)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime? @updatedAt
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sale_settings")
}

model QuotationProductItem {
  productItemId          String
  quantity               Int                   @default(1)
  productId              String
  quotationId            String
  totalValue             Float?
  distance               Float?
  duration               Float?
  height                 Float?
  length                 Float?
  name                   String
  salePrice              Float?
  unitCost               Float?
  volume                 Float?
  weight                 Float?
  width                  Float?
  id                     String                @id @default(uuid())
  quotationProductId     String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime?             @updatedAt
  originalQuantity       Int                   @default(1)
  unitKind               UnitKind?
  defaultUnitOfMeasureId String? // TODO: Analisar se ainda faz sentido gravar padrão de medida no orçamento, se já grava unitKind
  productItem            ProductItem           @relation(fields: [productItemId], references: [id])
  quotationProduct       QuotationProduct      @relation(fields: [quotationProductId], references: [id])
  DefaultUnitOfMeasure   DefaultUnitOfMeasure? @relation(fields: [defaultUnitOfMeasureId], references: [id])

  @@map("quotation_product_items")
}

model QuotationPayment {
  id                       String                 @id @default(uuid())
  quotationId              String                 @unique
  paymentConditionId       String
  commissionId             String?                @unique
  totalValue               Float
  description              String?
  finalValue               Float?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime?              @updatedAt
  discountType             String                 @default("VALUE")
  type                     InvoiceType            @default(OTHER)
  billing                  BiilingKind            @default(ON_ORDER)
  downPayment              Float                  @default(0)
  downPaymentConditionId   String?
  downPaymentDueDate       DateTime?
  downPaymentAdditionalFee Float                  @default(0)
  additionalFeeType        String?
  installmentQty           Int?
  mainAdditionalFee        Float?
  maxInstallmentQty        Int?
  minInstallmentQty        Int?
  discountTotal            Float                  @default(0)
  discountValue            Float                  @default(0)
  quotationInstallment     QuotationInstallment[]
  commission               Commission?            @relation(fields: [commissionId], references: [id])
  downPaymentCondition     PaymentCondition?      @relation("downPaymentRelation", fields: [downPaymentConditionId], references: [id])
  paymentCondition         PaymentCondition       @relation("defaultRelation", fields: [paymentConditionId], references: [id])
  quotation                Quotation              @relation(fields: [quotationId], references: [id])

  @@map("quotation_payments")
}

model Commission {
  id               String                   @id @default(uuid())
  type             CommissionType           @default(ADD)
  transferMethod   transferMethodCommission @default(SINGLE)
  commissionValue  Float                    @default(0)
  totalCommission  Float                    @default(0)
  supplierId       String
  commissionType   String                   @default("VALUE")
  receivableId     String?
  payableId        String?
  payable          Payable?                 @relation(fields: [payableId], references: [id])
  supplier         Supplier                 @relation(fields: [supplierId], references: [id])
  quotationPayment QuotationPayment?

  @@map("commissions")
}

model QuotationInstallment {
  id                      String                 @id @default(uuid())
  quotationPaymentId      String
  dueDate                 DateTime
  paymentConditionId      String
  value                   Float
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  payableInstallmentId    String?
  receivableInstallmentId String?
  additionalFee           Float                  @default(0)
  payableInstallment      PayableInstallment?    @relation(fields: [payableInstallmentId], references: [id])
  paymentCondition        PaymentCondition       @relation(fields: [paymentConditionId], references: [id])
  quotationPayment        QuotationPayment       @relation(fields: [quotationPaymentId], references: [id])
  receivableInstallment   ReceivableInstallment? @relation(fields: [receivableInstallmentId], references: [id])

  @@map("quotation_installments")
}

model DeliveryInfo {
  id                  String            @id @default(uuid())
  quotationId         String            @unique
  daysAfterApproval   Int?
  estimatedDate       DateTime?
  deliveryTime        String? // HH:MM — horário de entrega exibido no PDF
  deliveryDisplayMode String?           @default("DAYS") // DAYS | DATE
  modality            String            @default("Indefinida")
  cost                Float?
  value               Float?
  notes               String?
  supplierId          String?
  clientAddressId     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime?         @updatedAt
  deliveryType        DeliveryType      @default(PICKUP)
  quotation           Quotation         @relation(fields: [quotationId], references: [id])
  supplier            Supplier?         @relation(fields: [supplierId], references: [id])
  clientAddress       Address?          @relation(fields: [clientAddressId], references: [id])
  deliverySchedule    DeliverySchedule?

  @@index([quotationId])
  @@map("delivery_info")
}

model Order {
  id               String            @id @default(uuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?         @updatedAt
  quotationId      String            @unique
  status           OrderStatus       @default(IN_PRODUCTION)
  isActive         Boolean           @default(true)
  isImported       Boolean           @default(false)
  canceledAt       DateTime?
  deliveredAt      DateTime?
  reasonId         String?
  deliverySchedule DeliverySchedule?
  quotation        Quotation         @relation(fields: [quotationId], references: [id])
  cancelReason     Reasons?          @relation(fields: [reasonId], references: [id])
  history          OrderHistory[]
  nfes             Nfe[]
  nfeOrders        NfeOrder[]
  nfses            Nfse[]
  nfces            Nfce[]
  files            OrderFile[]

  @@index([id])
  @@map("orders")
}

model QuotationHistory {
  id            String    @id @default(uuid())
  quotationId   String
  action        String // CREATED, FINISHED, REOPENED, REJECTED, VALUE_CHANGED, APPROVED, DUPLICATED
  description   String
  changes       Json? // { before: {...}, after: {...} }
  metadata      Json? // Dados adicionais
  createdBy     String
  createdByName String? // Desnormalizado para performance
  createdAt     DateTime  @default(now())
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user          User      @relation("QuotationHistoryUser", fields: [createdBy], references: [id])

  @@index([quotationId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("quotation_history")
}

model OrderHistory {
  id            String   @id @default(uuid())
  orderId       String
  action        String // CREATED, CANCELED
  description   String
  changes       Json? // Dados adicionais sobre a ação
  metadata      Json? // Informações adicionais (ex: motivo de cancelamento, quem aprovou)
  createdBy     String
  createdByName String? // Desnormalizado para performance
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User     @relation("OrderHistoryUser", fields: [createdBy], references: [id])

  @@index([orderId])
  @@index([createdAt])
  @@index([createdBy])
  @@map("order_history")
}

model Product {
  id                   String              @id @default(uuid())
  /// Data de cadastro (LITE part3, item 4, 28/10/2026): a lista de produtos
  /// segue a ordem de cadastro. Os produtos de antes da coluna ficam com a
  /// data da migração
  createdAt            DateTime            @default(now())
  name                 String
  companyId            String?
  categoryId           String
  isActive             Boolean             @default(true)
  isStandard           Boolean             @default(false)
  isService            Boolean             @default(false)
  /// Nulo no produto salvo do item montado (ORC-11): o código é gerado
  /// quando a composição é liberada para venda (PO, 14/10/2026)
  code                 String?
  sectorId             String
  allowEditDescription Boolean             @default(true)
  allowEditValues      Boolean             @default(true)
  /// Quantidade mínima na unidade comercial do produto (0,5 m², 3 un),
  /// 27/10/2026: abaixo dela o item é cobrado pelo mínimo; por unidade, o
  /// item nasce com ela. Nulo = sem mínimo
  minQuantity          Float?
  imageUrl             String?
  imageSize            String?
  technicalDescription String?
  productionStages     Json?
  status               ProductStatus       @default(ACTIVE)
  isImported           Boolean             @default(false)
  /// Código do produto no sistema legado. Distingue o que a migração criou do
  /// que o cliente já tinha com o mesmo código.
  legacyId             String?
  /// Produto terceirizado (T-5, 24/10/2026): comprado de fornecedor e
  /// revendido; cada venda aprovada gera a conta a pagar ao fornecedor.
  /// Desde 18/11/2026 é o espelho de structure = OUTSOURCED
  isOutsourced         Boolean             @default(false)
  /// A estrutura do produto (18/11/2026): define quais blocos o cadastro
  /// abre. Trocar não apaga os dados do bloco que some
  structure            ProductStructure    @default(STANDARD)
  /// Custo do fornecedor por unidade de venda, na mesma base do unitCost do
  /// item (centavos por mm², mm, ml, un…)
  outsourcedCost       Float?
  /// Gráfica rápida (12/11/2026): sangria por lado em mm e folhas de acerto; nulo = a do setor
  bleedMm              Float?
  setupSheets          Int?
  suppliers            Supplier[]          @relation("ProductSuppliers")
  items                ProductItem[]
  category             Category            @relation(fields: [categoryId], references: [id])
  company              Company?            @relation(fields: [companyId], references: [id])
  sector               CompanySector       @relation(fields: [sectorId], references: [id])
  quotationProduct     QuotationProduct[]
  quotations           Quotation[]         @relation("QuotationToProduct")
  fiscalData           ProductFiscalData?
  stRules              ProductStRule[]
  variations           ProductVariation[]
  priceTiers           ProductPriceTier[]
  assemblies           ProductAssembly[]
  partOfBlocks         AssemblyBlock[]     @relation("AssemblyPart")
  quotationLines       QuotationItemLine[]

  @@unique([code, companyId])
  @@unique([companyId, legacyId])
  @@map("products")
}

model ProductItem {
  id                     String                 @id @default(uuid())
  name                   String
  productId              String
  unitCost               Float?
  salePrice              Float?
  distance               Float?
  duration               Float?
  height                 Float?
  length                 Float?
  volume                 Float?
  weight                 Float?
  width                  Float?
  unitKind               UnitKind?
  product                Product                @relation(fields: [productId], references: [id])
  quotationProductItem   QuotationProductItem[]
  DefaultUnitOfMeasure   DefaultUnitOfMeasure?  @relation(fields: [defaultUnitOfMeasureId], references: [id])
  defaultUnitOfMeasureId String?

  @@map("product_items")
}

/// Insumo do PRO (contrato, módulo 1, parte B). Dinheiro em centavos
/// inteiros (política das tabelas novas); medidas em milímetros.
model Material {
  id                 String               @id @default(uuid())
  companyId          String
  /// Sequencial por empresa: o código é MAT-nn
  number             Int
  code               String
  name               String
  /// Nome sem acento e sem caixa: busca e conciliação da importação
  searchName         String
  sectorId           String
  subcategory        String               @default("")
  unit               MaterialUnit
  directSale         Boolean              @default(false)
  productionMaterial Boolean              @default(true)
  priceRule          MaterialPriceRule    @default(FIXED)
  /// Nulos quando há variação: custo e preço vivem em cada marca × cor
  cost               Int?
  price              Int?
  /// Lucro informado no preço variável, em décimos de ponto (300 = 30,0 %)
  desiredMargin      Int?
  costUpdatedAt      DateTime?
  active             Boolean              @default(true)
  /// Configuração avançada: nula = sem configuração
  shape              MaterialShape?
  /// Perfil: lados e comprimento da barra, em mm
  profileX           Float?
  profileY           Float?
  barLength          Float?
  /// Chapa: largura e altura, em mm
  sheetWidth         Float?
  sheetHeight        Float?
  /// Chapa: cobrar a folha inteira ou só a fração aproveitada
  wholeSheets        Boolean              @default(true)
  /// Quilos por unidade de venda do material
  weight             Float?
  /// O papel (forma SHEET; Papéis no LITE, PO 13/10/2026): a gramatura em
  /// g/m² e o formato da folha (o padrão preenche sheetWidth × sheetHeight)
  grammage           Int?
  sheetFormat        SheetFormat?
  /// A área útil do papel, em mm, menor ou igual à folha: vazia = a folha
  /// inteira. A contagem de folhas do item lê esta área
  usableWidth        Float?
  usableHeight       Float?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  company            Company              @relation(fields: [companyId], references: [id])
  sector             CompanySector        @relation(fields: [sectorId], references: [id])
  variations         MaterialVariation[]
  importLinks        MaterialImportLink[]
  /// Dados fiscais da venda direta (NCM, CEST, CFOP, origem e CSTs), com o
  /// módulo Nota Fiscal: o que faltar sai do padrão do emissor (PO, 14/10)
  fiscal             Json?
  quotationItems     QuotationProduct[]
  /// O saldo no estoque e o de-para dos fornecedores (FULL)
  stockItems         StockItem[]
  supplierLinks      SupplierItemLink[]
  /// As variações de produto que saem neste papel (Papéis no LITE)
  paperVariations    ProductVariation[]

  @@unique([companyId, number])
  @@index([companyId, active])
  @@map("materials")
}

/// Marca × cor do material. Com variação, a venda e a composição apontam
/// para ela.
model MaterialVariation {
  id             String             @id @default(uuid())
  materialId     String
  brand          String
  color          String
  /// marca|cor sem acento e sem caixa: a combinação é única no material
  matchKey       String
  cost           Int?
  price          Int?
  desiredMargin  Int?
  costUpdatedAt  DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  material       Material           @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quotationItems QuotationProduct[]
  stockItems     StockItem[]

  @@unique([materialId, matchKey])
  @@map("material_variations")
}

/// De-para aprendido na importação: o nome como veio de fora → material
model MaterialImportLink {
  id           String   @id @default(uuid())
  companyId    String
  /// Normalizado: minúsculas, sem acento, espaços colapsados
  externalName String
  materialId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id])
  material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([companyId, externalName])
  @@map("material_import_links")
}

/// Variação simples do produto (PV-6, já no START): nome e preço por
/// unidade comercial. No PRO, a mesma variação ganha composição própria.
model ProductVariation {
  id             String             @id @default(uuid())
  productId      String
  name           String
  /// Centavos por unidade comercial; nulo vale o preço do produto
  unitPrice      Int?
  position       Int                @default(0)
  /// O papel da variação (Papéis no LITE, PO 13/10/2026): um material da
  /// empresa com a forma SHEET. A contagem de folhas do item lê a folha e a
  /// área útil dele
  paperId        String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  product        Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  paper          Material?          @relation(fields: [paperId], references: [id], onDelete: SetNull)
  priceTiers     ProductPriceTier[]
  assemblies     ProductAssembly[]
  quotationItems QuotationProduct[]

  @@index([productId])
  @@map("product_variations")
}

/// Preço por faixa de quantidade (FQ-1 a FQ-4): tabela de preço, não
/// desconto. Sem variação, é a tabela do produto.
model ProductPriceTier {
  id          String            @id @default(uuid())
  productId   String
  variationId String?
  /// A faixa vale a partir desta quantidade
  from        Int
  /// Centavos por unidade comercial, sem arredondar para reais
  unitPrice   Int
  createdAt   DateTime          @default(now())
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@index([productId, variationId])
  @@map("product_price_tiers")
}

/// Processo (MS-11): uma etapa reutilizável de um setor, guardada no
/// formato da etapa da composição. Nunca é excluído, só inativado (PAD-7).
model Process {
  id                 String              @id @default(uuid())
  companyId          String
  name               String
  sectorId           String
  afterBase          ProcessAfterBase    @default(INHERIT)
  setupMinutes       Int                 @default(0)
  taskType           String
  sellerInstructions String              @default("")
  /// Regras de venda (MS-3 a MS-6)
  rules              Json
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id])
  sector             CompanySector       @relation(fields: [sectorId], references: [id])
  lines              AssemblyLine[]
  fields             AssemblyField[]
  formulas           AssemblyFormula[]
  blocks             AssemblyBlock[]
  usualAfter         ProcessUsualNext[]  @relation("UsualFrom")
  usualBefore        ProcessUsualNext[]  @relation("UsualTo")
  quotationLines     QuotationItemLine[]

  @@index([companyId, isActive])
  @@map("processes")
}

/// "Costuma vir depois de" (FL-7): o par é guardado uma vez.
model ProcessUsualNext {
  id            String   @id @default(uuid())
  fromProcessId String
  toProcessId   String
  createdAt     DateTime @default(now())
  from          Process  @relation("UsualFrom", fields: [fromProcessId], references: [id], onDelete: Cascade)
  to            Process  @relation("UsualTo", fields: [toProcessId], references: [id], onDelete: Cascade)

  @@unique([fromProcessId, toProcessId])
  @@map("process_usual_next")
}

/// A composição do produto (CP-17), ou a própria de uma variação.
/// A composição de um produto (ou da variação) ou do rascunho de um item
/// montado no orçamento (ORC-11): um dos dois donos.
model ProductAssembly {
  id                String            @id @default(uuid())
  companyId         String
  productId         String?
  draftId           String?           @unique
  variationId       String?
  /// O id da variação, ou vazio na composição padrão: a chave única
  variationKey      String            @default("")
  status            AssemblyStatus    @default(DRAFT)
  dimension         AssemblyDimension @default(SALE)
  allowRenameStages Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  company           Company           @relation(fields: [companyId], references: [id])
  product           Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  draft             QuotationDraft?   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  variation         ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  blocks            AssemblyBlock[]
  fields            AssemblyField[]
  formulas          AssemblyFormula[]

  @@unique([productId, variationKey])
  @@index([companyId])
  @@map("product_assemblies")
}

/// O rascunho do item montado na hora (ORC-11, Fase 4.5): a composição
/// montada só para um item do orçamento, na medida dele. O que não virou
/// item é apagado depois de 30 dias (PO, 14/10/2026).
model QuotationDraft {
  id          String             @id @default(uuid())
  companyId   String
  quotationId String
  name        String             @default("Item composto")
  /// A medida em que o rascunho é montado: largura e altura em mm
  quantity    Int                @default(1)
  width       Float              @default(1000)
  height      Float              @default(1000)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  company     Company            @relation(fields: [companyId], references: [id])
  quotation   Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  assembly    ProductAssembly?
  items       QuotationProduct[]

  @@index([quotationId])
  @@index([companyId, createdAt])
  @@map("quotation_drafts")
}

/// A etapa do produto (IP-29): montada ali (OWN), preenchida por um
/// processo (PROCESS, vínculo CP-21) ou outro produto (PART, IP-9).
model AssemblyBlock {
  id                   String            @id @default(uuid())
  assemblyId           String
  type                 AssemblyBlockType
  processId            String?
  partProductId        String?
  /// Nome, setor, preparo, tipo de tarefa e regras da etapa própria
  name                 String            @default("")
  sectorId             String?
  setupMinutes         Int               @default(0)
  taskType             String            @default("")
  rules                Json?
  /// O fluxo (FL-1): ids das etapas de que esta depende, e a base (MS-5)
  dependsOn            String[]
  baseBlockId          String?
  /// Ajustes deste produto sobre o processo (IP-18, IP-23, IP-30)
  localName            String?
  localTaskType        String?
  localRules           Json?
  /// Linhas do processo tiradas só deste produto (CP-21)
  removedSourceLineIds String[]
  position             Int               @default(0)
  createdAt            DateTime          @default(now())
  assembly             ProductAssembly   @relation(fields: [assemblyId], references: [id], onDelete: Cascade)
  process              Process?          @relation(fields: [processId], references: [id])
  partProduct          Product?          @relation("AssemblyPart", fields: [partProductId], references: [id])
  sector               CompanySector?    @relation(fields: [sectorId], references: [id])
  lines                AssemblyLine[]

  @@index([assemblyId])
  @@index([processId])
  @@index([partProductId])
  @@map("assembly_blocks")
}

/// Uma linha: do processo (processId) ou da etapa do produto (blockId).
/// Na etapa de processo, a linha que acompanha o processo (overridden =
/// false) guarda só a ligação (sourceLineId) e a opção escolhida; o resto
/// é lido do processo (CP-21).
model AssemblyLine {
  id                String               @id @default(uuid())
  processId         String?
  blockId           String?
  sourceLineId      String?
  overridden        Boolean              @default(false)
  addedHere         Boolean              @default(false)
  name              String               @default("")
  kind              AssemblyLineKind     @default(MATERIAL)
  mode              AssemblyLineMode     @default(SINGLE)
  /// Uma das FormulaKey do motor
  formula           String               @default("FIXED")
  perUnit           Float                @default(1)
  lossPercent       Float                @default(0)
  minimum           Float?
  optional          Boolean              @default(false)
  optionalDefault   Boolean              @default(true)
  fieldName         String?
  formulaId         String?
  people            Int?
  /// Aproveitamento de folha, em mm (AP-3, AP-4)
  sheetMargin       Float?
  sheetGap          Float?
  chargeWholeSheets Boolean?
  /// Precisão do tempo na configuração da linha (20/11/2026): "h", "hm" ou
  /// "hms"; nulo é hh:mm:ss. Só a tela usa: o motor conta em minutos
  timePrecision     String?
  selectedOptionId  String?
  position          Int                  @default(0)
  createdAt         DateTime             @default(now())
  process           Process?             @relation(fields: [processId], references: [id], onDelete: Cascade)
  block             AssemblyBlock?       @relation(fields: [blockId], references: [id], onDelete: Cascade)
  options           AssemblyLineOption[]

  @@index([processId])
  @@index([blockId])
  @@index([sourceLineId])
  @@map("assembly_lines")
}

/// A opção guarda só a referência ao recurso (CP-21): custo e venda vêm
/// do cadastro dele. Consumo, perda e mínimo próprios são opcionais (IP-26).
model AssemblyLineOption {
  id          String       @id @default(uuid())
  lineId      String
  /// material:<id>[:<variação>], labor:<setor>, …
  resourceId  String
  configName  String?
  perUnit     Float?
  lossPercent Float?
  minimum     Float?
  position    Int          @default(0)
  line        AssemblyLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  @@index([lineId])
  @@index([resourceId])
  @@map("assembly_line_options")
}

/// Campo do orçamento (IP-4, IP-19), do processo ou do produto.
model AssemblyField {
  id             String           @id @default(uuid())
  processId      String?
  assemblyId     String?
  name           String
  defaultValue   Float            @default(0)
  allowsFraction Boolean          @default(false)
  createdAt      DateTime         @default(now())
  process        Process?         @relation(fields: [processId], references: [id], onDelete: Cascade)
  assembly       ProductAssembly? @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([assemblyId])
  @@map("assembly_fields")
}

/// Fórmula (IP-2), do processo ou do produto. A cópia que veio do processo
/// guarda a de origem e acompanha a dela (CP-21).
model AssemblyFormula {
  id              String           @id @default(uuid())
  processId       String?
  assemblyId      String?
  name            String
  expression      String
  sourceFormulaId String?
  sourceProcessId String?
  createdAt       DateTime         @default(now())
  process         Process?         @relation(fields: [processId], references: [id], onDelete: Cascade)
  assembly        ProductAssembly? @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  @@index([processId])
  @@index([assemblyId])
  @@map("assembly_formulas")
}

model DefaultUnitOfMeasure {
  id                   String                 @id @default(uuid())
  name                 String
  code                 String                 @unique
  description          String?
  isActive             Boolean                @default(true)
  kind                 UnitKind?
  productItems         ProductItem[]
  quotationProductItem QuotationProductItem[]

  @@map("default_unit_measures")
}

model Language {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true)
  companyId   String
  company     Company @relation(fields: [companyId], references: [id])

  @@map("languages")
}

model Reasons {
  id        String      @id @default(uuid())
  reason    String
  type      ReasonType
  companyId String
  order     Order[]
  quotation Quotation[]
  company   Company     @relation(fields: [companyId], references: [id])

  @@map("reasons")
}

model DeliverySchedule {
  id                 String                 @id @default(uuid())
  companyId          String?
  quotationId        String?                @unique
  deliveryInfoId     String?                @unique
  orderId            String?                @unique
  status             DeliveryScheduleStatus @default(IN_PRODUCTION)
  completed          Boolean                @default(false)
  notes              String?
  scheduledDate      DateTime
  addScheduleTime    Boolean                @default(false)
  pendingDescription String?
  isActive           Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime?              @updatedAt
  company            Company?               @relation(fields: [companyId], references: [id])
  deliveryInfo       DeliveryInfo?          @relation(fields: [deliveryInfoId], references: [id])
  order              Order?                 @relation(fields: [orderId], references: [id])
  quotation          Quotation?             @relation(fields: [quotationId], references: [id])
  productionStages   ProductionStage[]
  itemStages         ProductionItemStage[]

  @@map("delivery_schedules")
}

model ProductionStage {
  id         String                @id @default(uuid())
  stageId    String?
  status     ProductionStageStatus @default(NOT_STARTED)
  notes      String?
  order      Int?
  prevStatus String?
  scheduleId String
  createdAt  DateTime              @default(now())
  updatedAt  DateTime?             @updatedAt
  schedule   DeliverySchedule      @relation(fields: [scheduleId], references: [id])
  stage      CompanySector?        @relation(fields: [stageId], references: [id])

  @@map("production_stages")
}

/// A etapa de um item do pedido na Agenda de entrega (área 9 §4.7; Maicol,
/// 23/11/2026). Nasce na aprovação com os setores do fluxo do item, na ordem
/// dele. A etapa do pedido (ProductionStage) do mesmo setor passa a ser o
/// resumo das etapas dos itens. Os estados são os da GP-28.
model ProductionItemStage {
  id                 String                @id @default(uuid())
  scheduleId         String
  quotationProductId String
  stageId            String
  order              Int                   @default(0)
  status             ProductionStageStatus @default(NOT_STARTED)
  prevStatus         String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime?             @updatedAt
  schedule           DeliverySchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  quotationProduct   QuotationProduct      @relation(fields: [quotationProductId], references: [id], onDelete: Cascade)
  stage              CompanySector         @relation(fields: [stageId], references: [id])

  @@index([scheduleId])
  @@index([quotationProductId])
  @@map("production_item_stages")
}

model Nature {
  id               String             @id @default(uuid())
  description      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime?          @updatedAt
  isActive         Boolean            @default(true)
  code             String?
  level1           String?
  level2           String?
  companyId        String
  company          Company            @relation(fields: [companyId], references: [id])
  payable          Payable[]
  receivable       Receivable[]
  scheduledExpense ScheduledExpense[]
  subCategory      SubCategory[]

  @@map("natures")
}

model SubCategory {
  id               String             @id @default(uuid())
  description      String?
  natureId         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime?          @updatedAt
  isActive         Boolean            @default(true)
  code             String?
  companyId        String
  payable          Payable[]
  receivable       Receivable[]
  scheduledExpense ScheduledExpense[]
  company          Company            @relation(fields: [companyId], references: [id])
  nature           Nature             @relation(fields: [natureId], references: [id])
  assetCosts       AssetCost[]

  @@map("sub_categories")
}

model ClientPaymentCondition {
  id                 String           @id @default(uuid())
  createdAt          DateTime         @default(now())
  isActive           Boolean          @default(true)
  clientId           String
  paymentConditionId String
  client             Client           @relation(fields: [clientId], references: [id])
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])

  @@unique([clientId, paymentConditionId])
  @@map("client_payment_conditions")
}

model SupplierPaymentCondition {
  id                 String           @id @default(uuid())
  createdAt          DateTime         @default(now())
  isActive           Boolean          @default(true)
  supplierId         String
  paymentConditionId String
  paymentCondition   PaymentCondition @relation(fields: [paymentConditionId], references: [id])
  supplier           Supplier         @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, paymentConditionId])
  @@map("supplier_payment_conditions")
}

model Plan {
  id                  String         @id @default(uuid())
  description         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime?      @default(now()) @updatedAt
  companyId           String?
  name                String         @unique
  additionalUserPrice Float?         @default(0)
  basePrice           Float
  planType            PlanType       @default(START)
  order               Int            @default(1) // Display order: TRIAL=0, START=1, LITE=2, PRO=3, ELITE=4, FULL=5
  isActive            Boolean        @default(true)
  badge               Json? // {text: string, variant: string}
  concept             Json? // {description, objective, mainActions, expectedResults, footer?}
  features            Json? // [{title, items: string[], videoUrl}]
  videoUrl            String? // URL do vídeo principal do plano
  // Textos do card do plano na trilha de contratação ({ pitch, actions }),
  // editados pelo superadmin. Nulo = o texto padrão do código.
  presentation        Json?
  Company             Company?       @relation(fields: [companyId], references: [id])
  subscriptions       Subscription[]
  planFeatures        PlanFeature[]
  planLimits          PlanLimit[]

  @@map("plans")
}

model Feature {
  id                   String                @id @default(uuid())
  key                  String                @unique // e.g., 'crm', 'advanced_reports', 'production_manager'
  name                 String // e.g., 'CRM', 'Relatórios Avançados', 'Gerenciador de Produção'
  description          String?
  category             String? // e.g., 'management', 'reports', 'production'
  price                Float                 @default(0) // preço adicional para esta feature
  isActive             Boolean               @default(true)
  /// O espaço dos arquivos de produção que o complemento dá, em GB (a faixa
  /// de armazenamento). Nulo = não é faixa de espaço.
  storageGb            Int?
  /// Aparece no catálogo de complementos. Falso = vendido só quando a tela o
  /// oferece (ex.: a faixa de 1 TB para quem já está perto do fim dos 200 GB).
  listed               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime?             @updatedAt
  planFeatures         PlanFeature[]
  subscriptionFeatures SubscriptionFeature[]

  @@map("features")
}

model Limit {
  id          String      @id @default(uuid())
  key         String      @unique // e.g., 'max_users', 'max_quotations', 'max_products'
  name        String // e.g., 'Máximo de Usuários', 'Máximo de Orçamentos'
  description String?
  unit        String? // e.g., 'users', 'quotations', 'products'
  // price       Float?      @default(0) // preço adicional para este limite
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime?   @updatedAt
  planLimits  PlanLimit[]

  @@map("limits")
}

model PlanFeature {
  id        String   @id @default(uuid())
  planId    String
  featureId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("plan_features")
}

/// Trilha da configuração dos planos feita pelo superadmin: um registro por
/// par (plano, recurso ou limite) alterado. Sem FK de propósito, para o
/// histórico sobreviver à exclusão de um plano ou recurso.
model PlanConfigHistory {
  id            String   @id @default(uuid())
  entityType    String // PLAN_FEATURE | PLAN_LIMIT | PLAN
  planId        String?
  planType      String?
  featureKey    String?
  limitKey      String?
  action        String // ENABLED | DISABLED | VALUE_CHANGED | AVAILABILITY_CHANGED
  description   String
  changes       Json? // { before, after }
  metadata      Json? // { affectedSubscriptions, keepCurrentSubscriptions, cascade, source }
  createdBy     String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([planId])
  @@index([featureKey])
  @@index([createdAt])
  @@map("plan_config_history")
}

model PlanLimit {
  id        String   @id @default(uuid())
  planId    String
  limitId   String
  value     Int // valor do limite para este plano
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  limit     Limit    @relation(fields: [limitId], references: [id], onDelete: Cascade)

  @@unique([planId, limitId])
  @@map("plan_limits")
}

model WebhookEvent {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  asaasEventId String   @unique
  eventType    String
  payload      Json
  processed    Boolean  @default(false)
  // Diagnóstico e nova tentativa automática de eventos que falharam.
  attempts     Int      @default(0)
  lastError    String?
  resourceId   String? // id da cobrança ou assinatura a que o evento se refere

  @@map("webhook_events")
}

model Customer {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime?      @updatedAt
  name            String
  email           String
  document        String
  phone           String?
  asaasCustomerId String         @unique
  address         String?
  addressNumber   String?
  complement      String?
  province        String?
  postalCode      String?
  city            String?
  state           String?
  companyId       String?        @map("company_id")
  company         Company?       @relation(fields: [companyId], references: [id])
  subscriptions   Subscription[]
  user            User[]

  @@unique([document, companyId], name: "unique_document_per_company")
  @@unique([email, companyId], name: "unique_email_per_company")
  @@map("customers")
}

model SubscriptionHistory {
  id             String       @id @default(uuid())
  subscriptionId String
  action         String // CREATED, ACTIVATED, BLOCKED, PAYMENT_RECEIVED, PAYMENT_CONFIRMED, PAYMENT_OVERDUE, STATUS_CHANGED, etc
  description    String
  changes        Json? // { before: {...}, after: {...} }
  metadata       Json? // Dados adicionais do webhook Asaas, info de pagamento, etc
  createdBy      String? // Pode ser null para eventos automáticos (webhooks)
  createdByName  String? // Desnormalizado para performance
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([createdAt])
  @@index([action])
  @@map("subscription_history")
}

model Subscription {
  id                     String                @id @default(uuid())
  createdAt              DateTime              @default(now())
  updatedAt              DateTime?             @updatedAt
  companyId              String?
  additionalUsers        Int                   @default(0)
  asaasSubscriptionId    String                @unique
  customerId             String                @map("customer_id")
  nextDueDate            DateTime
  planId                 String                @map("plan_id")
  value                  Float
  status                 SubscriptionStatus    @default(ACTIVE)
  billingType            BillingType           @default(CREDIT_CARD)
  cycle                  Cycle                 @default(MONTHLY)
  couponId               String?
  couponCode             String? // Desnormalizado para display
  discountValue          Float? // Valor do desconto aplicado (centavos)
  discountType           DiscountType?
  // Contratação e preço. Opcionais porque as assinaturas antigas não têm
  // esses dados — e assinatura sem contractedAt não gera crédito de evolução.
  contractedAt           DateTime? // quando a contratação foi registrada
  recurringValueCents    Int? // valor da renovação: ciclo cheio, sem cupom e sem crédito
  evolutionCreditCents   Int? // crédito de evolução aplicado nesta contratação
  pricingSnapshot        Json? // o orçamento inteiro que gerou a cobrança, como prova
  previousSubscriptionId String? // de qual assinatura esta evoluiu
  endedReason            String? // EVOLVED | TRANSFERRED | CANCELED_BY_USER | ABANDONED
  // Como o Asaas cobra: ASAAS_SUBSCRIPTION (assinatura recorrente) ou
  // ASAAS_INSTALLMENT (anual em parcelas no cartão, renovado por nós). Nulo nas
  // antigas: vale o prefixo de asaasSubscriptionId.
  billingMode            String?
  installmentCount       Int? // em quantas vezes o anual é parcelado
  asaasInstallmentId     String? // o parcelamento do período em curso
  Company                Company?              @relation(fields: [companyId], references: [id])
  customer               Customer              @relation(fields: [customerId], references: [id])
  plan                   Plan                  @relation(fields: [planId], references: [id])
  coupon                 Coupon?               @relation(fields: [couponId], references: [id])
  subscriptionFeatures   SubscriptionFeature[]
  payments               Payment[]
  history                SubscriptionHistory[]

  @@map("subscriptions")
}

model Payment {
  id                 String             @id @default(uuid())
  createdAt          DateTime           @default(now())
  updatedAt          DateTime?          @updatedAt
  subscriptionId     String?
  subscription       Subscription?      @relation(fields: [subscriptionId], references: [id])
  asaasPaymentId     String             @unique
  asaasCustomerId    String
  value              Float
  dueDate            DateTime
  billingType        BillingType
  status             AsaasPaymentStatus @default(PENDING)
  description        String?
  externalReference  String? // TODO: Remover, este é o próprio id do payment
  invoiceUrl         String?
  bankSlipUrl        String?
  pixQrCode          String?
  pixCopyPaste       String?
  confirmedDate      DateTime?
  paymentDate        DateTime?
  // Período coberto e composição do valor: base do crédito proporcional.
  periodStart        DateTime?
  periodEnd          DateTime?
  grossValue         Float? // valor do ciclo após mês grátis e cupom, antes do crédito (reais)
  creditApplied      Float? // crédito de evolução abatido desta cobrança (reais)
  kind               String? // CONTRACT | EVOLUTION | RENEWAL (nulo: renovação gerada pelo Asaas)
  asaasInstallmentId String? // o parcelamento de que esta cobrança é parcela
  installmentNumber  Int? // 1..N dentro do parcelamento

  @@index([subscriptionId])
  @@index([asaasPaymentId])
  @@index([asaasInstallmentId])
  @@index([status])
  @@map("payments")
}

model SubscriptionFeature {
