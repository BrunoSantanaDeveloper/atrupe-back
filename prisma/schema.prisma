  taxInfoText              String? @db.Text
  isActive                 Boolean @default(true)

  // Numeração NF-e
  serieNfe         Int? @default(1)
  proximoNumeroNfe Int? @default(1)

  // Numeração NFC-e
  serieNfce         Int? @default(1)
  proximoNumeroNfce Int? @default(1)

  // Numeração NFS-e (RPS)
  // "1" e nao "A1": a NFS-e nacional monta o Id do DPS com a serie e valida
  // contra TSSerieDPS ([0-9]{1,4}|[0-8][0-9]{4}), que recusa alfanumerico.
  // Municipios em layout proprio ainda aceitam "A1", por isso o valor segue
  // livre — o que muda e o padrao de quem nasce agora.
  serieNfse      String? @default("1")
  proximoRpsNfse Int?    @default(1)

  // IBGE code (cached from CEP lookup to avoid external API calls on every emission)
  emitCmun String? // Código IBGE do município do emitente

  // NFC-e CSC (Código de Segurança do Contribuinte)
  cscId    String? // ID do CSC
  cscToken String? // Token CSC

  // NFC-e Contingência
  contingenciaNfceAtiva    Boolean   @default(false)
  contingenciaNfceMotivo   String?
  contingenciaNfceDataHora DateTime?

  // NFC-e prazo de cancelamento (configurável por estado)
  prazoCancelamentoNfce Int @default(30) // minutos

  // NF-e: teto para tentar o cancelamento por evento, em horas, contado da
  // autorização de uso. Nulo usa o teto nacional conhecido — quem valida o
  // prazo real é a SEFAZ da UF do emitente. Ver prazo-cancelamento.util.ts.
  prazoCancelamentoNfeHoras Int?

  // ── Reforma Tributária (IBS/CBS) ──
  // O grupo de VALORES do IBS/CBS é opcional no layout do provedor, e o retorno
  // dele não devolve esses valores. Fica desligado por padrão: liga-se por
  // emissor conforme cada prefeitura passar a exigir, sem afetar quem já emite.
  ibsCbsEnviarValores    Boolean @default(false)
  // Regime de apuração do IBS/CBS no Simples Nacional:
  // 1 = IBS e CBS pelo SN, 2 = CBS pelo SN e IBS regular, 3 = ambos regulares.
  regApIbsCbsSn          Int?
  // Alíquotas; nulo cai no padrão nacional da fase vigente. A municipal é
  // definida por cada município, por isso vive no emissor.
  aliquotaIbsUf          Float?
  aliquotaIbsMun         Float?
  aliquotaCbs            Float?
  // NF-e/NFC-e: o grupo IBS/CBS existe apenas no layout paralelo da Reforma no
  // provedor, ativado por ele empresa a empresa e modulo a modulo. Espelha o
  // campo AtivacaoReformaTributaria, devolvido na consulta de cadastro de
  // empresa. Desligado enquanto o provedor nao ativar: enviar antes disso e
  // campo ignorado em silencio.
  reformaTributariaAtiva Boolean @default(false)
  // cIndOp da NFS-e: obrigatorio (1-1) no layout da Reforma e estavel para a
  // maioria dos emissores, que prestam sempre o mesmo tipo de operacao. Fica
  // como padrao do emissor e continua sobrescrivel na emissao.
  indicadorOperacaoNfse  String?

  // Envio fiscal por e-mail
  sendDanfeXmlAutomatically Boolean @default(false)
  sendDanfeAutomatically    Boolean @default(true)
  sendXmlAutomatically      Boolean @default(true)
  sendFiscalEmailCopyTo     String?

  activeEnvironment     FiscalEnvironment?
  activeEnvironmentNfe  FiscalEnvironment?
  activeEnvironmentNfse FiscalEnvironment?
  activeEnvironmentNfce FiscalEnvironment?
  environmentConfigs    InvoicyEnvironmentConfig[]
  history               InvoicyConfigHistory[]
  activationAttempts    FiscalActivationAttempt[]
  nfces                 Nfce[]
  nfes                  Nfe[]
  nfses                 Nfse[]

  @@index([companyId])
  @@map("invoicy_configs")
}

// ==================== CFOP Config ====================

model CfopConfig {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  companyId String

  code        String // Código CFOP (ex: "5102")
  description String // Descrição (ex: "Venda de mercadoria adquirida")
  type        String // "ENTRADA" ou "SAIDA"
  nature      String? // Natureza da operação (ex: "Venda de mercadoria")
  info        String? // Informações de uso
  isActive    Boolean @default(true)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  naturesInternal OperationNature[] @relation("NatureInternal")
  naturesExternal OperationNature[] @relation("NatureExternal")

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cfop_configs")
}

// ==================== Operation Nature ====================

model OperationNature {
  id        String @id @default(uuid())
  companyId String

  description      String
  type             String // ENTRADA, SAIDA
  finality         String // 1=Normal, 2=Complementar, etc.
  consumerPresence String // 0=Não, 1=Presencial, etc.
  info             String?

  // Relations to CFOPs
  cfopInternalId String?
  cfopExternalId String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cfopInternal CfopConfig? @relation("NatureInternal", fields: [cfopInternalId], references: [id])
  cfopExternal CfopConfig? @relation("NatureExternal", fields: [cfopExternalId], references: [id])

  @@map("operation_natures")
}

enum NfeStatus {
  DRAFT
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
  CORRECTION_SENT
}

model Nfe {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  companyId             String
  orderId               String?
  quotationId           String?
  numero                Int
  serie                 Int
  chaveAcesso           String?   @unique
  protocolo             String?
  status                NfeStatus @default(PENDING)
  ambiente              Int // 1 = Produção, 2 = Homologação
  dataEmissao           DateTime?
  dataAutorizacao       DateTime?
  valorTotal            Float
  xmlEnvio              String?   @db.Text
  xmlRetorno            String?   @db.Text
  xmlAutorizado         String?   @db.Text
  danfeUrl              String?
  motivoRejeicao        String?
  motivoCancelamento    String?
  dataCancelamento      DateTime?
  protocoloCancelamento String?
  cartaCorrecao         String?   @db.Text
  dataCorrecao          DateTime?
  protocoloCorrecao     String?
  sequenciaCorrecao     Int?
  invoicyId             String? // ID retornado pelo Invoicy
  invoicyProtocol       String?
  emailSentAt           DateTime?
  emailSentTo           String?
  emailSendError        String?   @db.Text
  draftData             Json? // Dados do rascunho (destinatário, itens, etc.)

  // Rastreabilidade: qual emissor gerou o documento e com que payload.
  // Sem isso, devolução e CC-e re-derivam CFOP/natureza da config ATUAL, que
  // pode ter mudado desde a emissão. Espelha o que Nfce já fazia.
  invoicyConfigId     String?
  invoicyPayloadEnvio Json? // Snapshot do payload enviado ao Invoicy

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id])
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  invoicyConfig InvoicyConfig? @relation(fields: [invoicyConfigId], references: [id], onDelete: Restrict)
  orders        NfeOrder[]

  correctionEvents NfeCorrectionEvent[]
  danfeDocument    NfeDanfeDocument?

  @@index([companyId])
  @@index([orderId])
  @@index([status])
  @@index([numero, serie, companyId])
  @@index([invoicyConfigId])
  // A listagem unificada filtra por ambiente dentro da empresa.
  @@index([companyId, ambiente])
  @@map("nfes")
}

model NfeOrder {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  nfeId     String
  orderId   String
  nfe       Nfe      @relation(fields: [nfeId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([nfeId, orderId])
  @@index([orderId])
  @@map("nfe_orders")
}

enum NfeCorrectionStatus {
  PENDING // sequência reservada, evento ainda não confirmado pela SEFAZ
  REGISTERED // evento registrado (cStat 135 ou 136)
  REJECTED // rejeitado pelo provedor/SEFAZ ou falha na transmissão
}

model NfeCorrectionEvent {
  id              String              @id @default(uuid())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  nfeId           String
  sequenciaEvento Int
  correcao        String              @db.Text
  status          NfeCorrectionStatus @default(PENDING)
  protocolo       String?
  dataEvento      DateTime?
  xmlEvento       String?             @db.Text
  ambiente        Int? // 1 = Produção, 2 = Homologação (ambiente efetivamente usado no evento)
  sitCodigo       Int? // cStat devolvido pela SEFAZ (135 = vinculado, 136 = registrado sem vínculo)
  codigoRetorno   Int? // código de retorno do provedor (Invoicy)
  motivoRejeicao  String?             @db.Text
  createdBy       String? // userId de quem disparou o evento
  createdByName   String?
  nfe             Nfe                 @relation(fields: [nfeId], references: [id], onDelete: Cascade)

  document NfeCorrectionDocument?

  @@unique([nfeId, sequenciaEvento])
  @@index([nfeId])
  @@index([nfeId, status])
  @@map("nfe_correction_events")
}

/// DACCE (representação impressa da CC-e) em cache. Fica fora de
/// NfeCorrectionEvent porque a listagem de eventos é lida com frequência e não
/// deve carregar o binário junto.
model NfeCorrectionDocument {
  correctionEventId String             @id
  pdf               Bytes
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  correctionEvent   NfeCorrectionEvent @relation(fields: [correctionEventId], references: [id], onDelete: Cascade)

  @@map("nfe_correction_documents")
}

model NfeDanfeDocument {
  nfeId     String   @id
  pdf       Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nfe       Nfe      @relation(fields: [nfeId], references: [id], onDelete: Cascade)

  @@map("nfe_danfe_documents")
}

model ProductFiscalData {
  id               String  @id @default(uuid())
  productId        String  @unique
  ncm              String?
  cest             String?
  cean             String? // Código de barras
  productCode      String? // Código do produto específico para NF-e
  commercialUnit   String? // Unidade comercial (UN, KG, M, etc.)
  icmsOrigin       String? // Origem da mercadoria (0-8)
  icmsCst          String? // CST do ICMS
  icmsRate         Float? // Alíquota do ICMS
  icmsReducao      Float? // Redução da base de cálculo ICMS
  icmsCreditRate   Float? // Alíquota do crédito ICMS (Simples Nacional)
  icmsBaseModality String? // Modalidade da base de cálculo ICMS
  // Substituição tributária. A margem de valor agregado é definida por
  // protocolo entre estados, por NCM — não há tabela nacional a consultar,
  // por isso o valor é cadastrado por produto.
  icmsStMva        Float? // Margem de valor agregado da ST (%)
  icmsStReducao    Float? // Redução da base de cálculo da ST (%)
  icmsStRate       Float? // Alíquota interna do ICMS-ST na UF de destino (%)
  // Fundo de Combate à Pobreza: a alíquota é definida por lei estadual e varia
  // por produto, então também é cadastrada em vez de presumida.
  fcpRate          Float? // Alíquota do FCP (%)
  fcpStRate        Float? // Alíquota do FCP retido por ST (%)
  pisCst           String? // CST do PIS
  pisRate          Float? // Alíquota do PIS
  cofinsCst        String? // CST do COFINS
  cofinsRate       Float? // Alíquota do COFINS
  ipiCst           String? // CST do IPI
  ipiRate          Float? // Alíquota do IPI
  ipiFramework     String? // Enquadramento do IPI
  cfopInState      String? // CFOP para venda dentro do estado
  cfopOutState     String? // CFOP para venda fora do estado
  cfopExport       String? // CFOP para exportação
  // NFS-e fields
  codigoServico    String? // Código do serviço municipal (LC 116/03)
  aliquotaIss      Float? // Alíquota do ISS
  discriminacao    String? // Discriminação do serviço para NFS-e
  codTribMunicipio String? // Código tributação município (000/001/002/003)
  cnae             String? // CNAE vinculado ao serviço
  nbs              String? // Nomenclatura Brasileira de Serviços
  codTribNacional  String? // Código tributação nacional
  // CST e classificação do IBS/CBS andam sempre em par: o grupo IBSCBS da NFS-e
  // exige CSTIBSCBS, e enviar só a classificação produz grupo incompleto.
  // "000" = tributação integral, que corresponde à classificação "000001".
  cstIbsCbs        String? @default("000") // CST do IBS/CBS
  codClassificacao String? @default("000001") // Classificação IBS/CBS
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_fiscal_data")
}

/// Regra de substituição tributária por UF de destino.
///
/// A MVA e a alíquota interna variam por protocolo entre estados, então uma
/// única MVA no produto não cobre quem vende para todo o país. Quando não há
/// linha para a UF, o cálculo cai nos campos de ST do próprio ProductFiscalData,
/// que passam a valer como padrão.
model ProductStRule {
  id              String @id @default(uuid())
  productId       String
  ufDestino       String // Sigla da UF de destino (2 letras)
  mva             Float? // MVA-ST original do protocolo (%)
  aliquotaInterna Float? // ALQ intra: alíquota interna na UF de destino (%)
  reducaoBase     Float? // Redução da base de cálculo da ST (%)
  fcpStRate       Float? // FCP retido por ST na UF de destino (%)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, ufDestino])
  @@index([productId])
  @@map("product_st_rules")
}

// NFS-e Status
enum NfseStatus {
  DRAFT
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
}

// NFS-e Model - Nota Fiscal de Serviço Eletrônica
model Nfse {
  id                    String     @id @default(uuid())
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  companyId             String
  orderId               String?
  quotationId           String?
  numero                Int
  serie                 String // NFS-e usa série alfanumérica
  rpsNumero             Int // Número do RPS
  rpsSerie              String
  rpsTipo               Int        @default(1)
  codigoVerificacao     String?
  protocolo             String?
  protocoloCancelamento String?
  status                NfseStatus @default(PENDING)
  ambiente              Int // 1 = Produção, 2 = Homologação
  dataEmissao           DateTime?
  dataCompetencia       DateTime?
  valorServicos         Float
  valorDeducoes         Float?     @default(0)
  valorPis              Float?     @default(0)
  valorCofins           Float?     @default(0)
  valorInss             Float?     @default(0)
  valorIr               Float?     @default(0)
  valorCsll             Float?     @default(0)
  valorIss              Float?
  aliquotaIss           Float?
  baseCalculo           Float?
  issRetido             Boolean    @default(false)
  codigoServico         String? // Código do serviço municipal
  discriminacao         String?    @db.Text // Descrição do serviço
  codigoMunicipio       String? // Código IBGE do município
  xmlEnvio              String?    @db.Text
  xmlRetorno            String?    @db.Text
  pdfUrl                String?
  motivoRejeicao        String?
  motivoCancelamento    String?
  dataCancelamento      DateTime?
  invoicyId             String?
  invoicyProtocol       String?
  emailSentAt           DateTime?
  emailSentTo           String?
  draftData             Json? // Dados do rascunho (tomador, itens, etc.)

  // Rastreabilidade: ver comentário equivalente em Nfe.
  invoicyConfigId     String?
  invoicyPayloadEnvio Json? // Snapshot do payload enviado ao Invoicy
  // Envelope da resposta do provedor (Codigo/Descricao/Situacao), com blobs
  // elididos. Sem ele a rejeição guardava só SitDescricao e o motivo real
  // ficava indiagnosticável — mesmo buraco que travou o 606 da CC-e.
  invoicyRetornoBruto Json?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order         Order?         @relation(fields: [orderId], references: [id])
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  invoicyConfig InvoicyConfig? @relation(fields: [invoicyConfigId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([orderId])
  @@index([status])
  @@index([numero, serie, companyId])
  @@index([invoicyConfigId])
  // A listagem unificada filtra por ambiente dentro da empresa.
  @@index([companyId, ambiente])
  @@map("nfses")
}

// Lista de serviços da empresa para emissão de NFS-e.
//
// Espelha a "Lista de Serviços" do InvoiCy Web: a empresa cadastra várias
// combinações de código LC 116 + classificação fiscal e escolhe qual usar no
// ato da emissão. Independe de Product/ProductFiscalData porque a nota avulsa
// não tem produto, e uma mesma empresa presta serviços de códigos distintos.
model NfseServico {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  codigo           String // LC 116, ex "13.05"
  descricao        String
  aliquotaIss      Float?
  codTribMunicipio String?
  cnae             String?
  nbs              String?
  codTribNacional  String?
  codClassificacao String? // cClassTrib IBS/CBS
  // CSTIBSCBS: o provedor exige CST e cClassTrib juntos no grupo IBSCBS, e
  // sem coluna o formulario mandava o campo que o DTO recusava — o cadastro
  // inteiro voltava 400 e o servico ficava sem classificacao nenhuma.
  cstIbsCbs        String?
  isDefault        Boolean @default(false)

  @@index([companyId])
  @@map("nfse_servicos")
}

// NFC-e Status
enum NfceStatus {
  PENDING
  PROCESSING
  UNKNOWN // Emissão tentada, resultado desconhecido (timeout/rede)
  AUTHORIZED
  REJECTED
  CANCELLED
  CONTINGENCY // Contingência offline
}

// NFC-e Model - Nota Fiscal de Consumidor Eletrônica
model Nfce {
  id                        String         @id @default(uuid())
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  companyId                 String
  orderId                   String?
  quotationId               String?
  invoicyConfigId           String? // Emissor (InvoicyConfig) usado na tentativa
  numero                    Int
  serie                     Int
  chaveAcesso               String?        @unique
  protocolo                 String?
  status                    NfceStatus     @default(PENDING)
  ambiente                  Int // 1 = Produção, 2 = Homologação
  dataEmissao               DateTime?
  dataAutorizacao           DateTime?
  valorTotal                Float
  valorDesconto             Float?         @default(0)
  valorTroco                Float?         @default(0)
  cpfConsumidor             String?
  consumidorNome            String?
  informacoesComplementares String?        @db.Text
  itensSnapshot             Json?
  pagamentosSnapshot        Json?
  invoicyPayloadEnvio       Json? // Payload Invoicy exato usado/reusado no reprocessamento
  formaPagamento            String? // Código da forma de pagamento
  xmlEnvio                  String?        @db.Text
  xmlRetorno                String?        @db.Text
  xmlAutorizado             String?        @db.Text
  qrCodeUrl                 String? // URL do QR Code
  urlConsulta               String? // URL para consulta pública
  danfeUrl                  String?
  motivoRejeicao            String?
  motivoCancelamento        String?
  dataCancelamento          DateTime?
  protocoloCancelamento     String?
  contingencia              Boolean        @default(false)
  dataContingencia          DateTime?
  motivoContingencia        String?
  invoicyId                 String?
  invoicyProtocol           String?
  company                   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Restrict e nao SetNull: excluir um emissor nao pode apagar a atribuicao
  // de NFC-e ja autorizadas — isso destroi a trilha fiscal do documento.
  invoicyConfig             InvoicyConfig? @relation(fields: [invoicyConfigId], references: [id], onDelete: Restrict)
  order                     Order?         @relation(fields: [orderId], references: [id])
  quotation                 Quotation?     @relation(fields: [quotationId], references: [id])

  @@unique([companyId, numero, serie, ambiente], name: "nfce_unique_emission")
  @@index([companyId])
  @@index([invoicyConfigId])
  @@index([orderId])
  @@index([status])
  // A listagem unificada filtra por ambiente dentro da empresa. O unique acima
  // não serve: numero e serie vêm antes de ambiente na ordem das colunas.
  @@index([companyId, ambiente])
  @@map("nfces")
}

enum DigitalCertificateType {
