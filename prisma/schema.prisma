  createdAt      DateTime     @default(now())
  // Recurso concedido sem cobrança, fora do plano. Nulo = módulo contratado.
  // PLAN_RETAINED: mantido quando o superadmin retirou o recurso do plano sem
  // atingir as assinaturas atuais. COURTESY: cortesia dada a uma empresa.
  grantSource    String?
  grantedBy      String?
  grantedByName  String?
  grantReason    String?
  expiresAt      DateTime? // cortesia com validade; nulo = sem prazo
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
